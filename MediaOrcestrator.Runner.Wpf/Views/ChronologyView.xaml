<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.ChronologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChronologyViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="980">

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,16"
                       Text="Лента строится из того, что уже синхронизировано в БД, – несинхронизированные видео в неё не попадут." />

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="YouTube-источники"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding RefreshSourcesCommand}"
                                Padding="{DynamicResource Padding.Control}"
                                MinHeight="{DynamicResource Control.Height.Compact}"
                                AutomationProperties.Name="Обновить список источников">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Обновить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <keepshell:EmptyState Icon="Youtube"
                                          Heading="Нет YouTube-источников"
                                          Description="Добавьте каналы в разделе «Источники и связи», чтобы построить ленту.">
                        <keepshell:EmptyState.Style>
                            <Style TargetType="keepshell:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sources.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </keepshell:EmptyState.Style>
                    </keepshell:EmptyState>

                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChronologySourceItem}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding Title}"
                                          Margin="0,4,0,0"
                                          Style="{StaticResource CheckBox.Default}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding BuildCommand}"
                                Padding="16,7"
                                MinHeight="{DynamicResource Control.Height.Default}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ListOrdered" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Построить ленту" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding ExportM3uCommand}"
                                Margin="8,0,0,0"
                                Padding="12,7"
                                MinHeight="{DynamicResource Control.Height.Default}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Download" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Экспорт .m3u" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding CopyLinksCommand}"
                                Margin="8,0,0,0"
                                Padding="12,7"
                                MinHeight="{DynamicResource Control.Height.Default}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Copy" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Копировать ссылки" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource State.WarningSoft}"
                    BorderBrush="{DynamicResource State.Warning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasMissingDates, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconLucide Grid.Column="0"
                                                  Kind="TriangleAlert"
                                                  Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Foreground="{DynamicResource State.Warning}" />

                        <TextBlock Grid.Column="1"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <Run Text="У" />
                            <Run Text="{Binding MissingDateCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}" />
                            <Run Text="видео нет даты публикации – они в конце списка. Дополнить можно дозапросом к источнику (Explode → yt-dlp → API)." />
                        </TextBlock>
                    </Grid>

                    <Grid Margin="26,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Потоки дополнения:"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <Slider Grid.Column="1"
                                Minimum="1"
                                Maximum="8"
                                Value="{Binding BackfillThreads}"
                                Width="160"
                                VerticalAlignment="Center"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                AutomationProperties.Name="Число потоков дополнения дат" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding BackfillThreads}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   MinWidth="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}" />

                        <Button Grid.Column="4"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding BackfillDatesCommand}"
                                Padding="{DynamicResource Padding.Control}"
                                MinHeight="{DynamicResource Control.Height.Compact}"
                                Content="Дополнить даты" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <ToggleButton Style="{StaticResource ToggleButton.FiltersCollapse}"
                                  HorizontalAlignment="Left"
                                  IsChecked="{Binding IsPlaylistExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="Свернуть или развернуть настройки плейлиста"
                                  ToolTip="Настройки заливки плейлиста на YouTube">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Setter Property="Kind"
                                                Value="ChevronRight" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaylistExpanded}"
                                                         Value="True">
                                                <Setter Property="Kind"
                                                        Value="ChevronDown" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                            <TextBlock Text="Плейлист на YouTube"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsPlaylistExpanded, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Дозалить в существующий плейлист"
                                  IsChecked="{Binding AppendToExisting}"
                                  Style="{StaticResource CheckBox.Default}"
                                  Margin="0,0,0,10" />

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppendToExisting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Название" Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding PlaylistTitle, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="{DynamicResource Control.Height.Compact}"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" MinWidth="120">
                                <TextBlock Text="Видимость" Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding PrivacyOptions}"
                                          SelectedItem="{Binding SelectedPrivacy}"
                                          MinHeight="{DynamicResource Control.Height.Compact}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppendToExisting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Плейлист" Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding ExistingPlaylists}"
                                          SelectedItem="{Binding SelectedPlaylist}"
                                          MinHeight="{DynamicResource Control.Height.Compact}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title}" />
                                                <Run Text="·" Foreground="{DynamicResource Fg.Secondary}" />
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{DynamicResource Fg.Secondary}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding LoadPlaylistsCommand}"
                                    VerticalAlignment="Bottom"
                                    Padding="{DynamicResource Padding.Control}"
                                    MinHeight="{DynamicResource Control.Height.Compact}"
                                    AutomationProperties.Name="Обновить список плейлистов">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Обновить" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Аккаунт" Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding OwnerSource}"
                                          MinHeight="{DynamicResource Control.Height.Compact}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding CreatePlaylistCommand}"
                                    VerticalAlignment="Bottom"
                                    Padding="16,7"
                                    MinHeight="{DynamicResource Control.Height.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ListPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Нужен настроенный OAuth у выбранного аккаунта (client_id/client_secret). Дозалив в существующий пропускает уже добавленные видео – это и есть продолжение после исчерпания квоты." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card.Inset}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,8"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                        <Run Text="Для плейлиста выбрано:" Foreground="{DynamicResource Fg.Secondary}" />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}" />
                        <Run Text="из" Foreground="{DynamicResource Fg.Secondary}" />
                        <Run Text="{Binding Items.Count, Mode=OneWay}" Foreground="{DynamicResource Fg.Primary}" />
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Все"
                                Command="{Binding SelectAllCommand}"
                                Style="{StaticResource Button.Ghost}"
                                Padding="12,4"
                                MinHeight="{DynamicResource Control.Height.Compact}" />
                        <Button Content="Сброс"
                                Command="{Binding SelectNoneCommand}"
                                Style="{StaticResource Button.Ghost}"
                                Padding="12,4"
                                Margin="6,0,0,0"
                                MinHeight="{DynamicResource Control.Height.Compact}" />
                        <TextBlock Text="Первые"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,4,0" />
                        <TextBox Text="{Binding FirstNCount, UpdateSourceTrigger=PropertyChanged}"
                                 Width="56"
                                 VerticalContentAlignment="Center"
                                 MinHeight="{DynamicResource Control.Height.Compact}" />
                        <Button Content="Выбрать"
                                Command="{Binding SelectFirstNCommand}"
                                Style="{StaticResource Button.Ghost}"
                                Padding="12,4"
                                Margin="6,0,0,0"
                                MinHeight="{DynamicResource Control.Height.Compact}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <keepshell:EmptyState Icon="ListOrdered"
                                          VerticalAlignment="Center"
                                          Heading="Лента ещё не построена"
                                          Description="Отметьте источники и нажмите «Построить ленту».">
                        <keepshell:EmptyState.Style>
                            <Style TargetType="keepshell:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </keepshell:EmptyState.Style>
                    </keepshell:EmptyState>

                    <ListBox ItemsSource="{Binding Items}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseRightButtonDown="OnListRightButtonDown"
                             Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Выбрать только это"
                                          Command="{Binding PlacementTarget.DataContext.SelectOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Выбрать до этого включительно"
                                          Command="{Binding PlacementTarget.DataContext.SelectUpToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Выбрать с этого до конца"
                                          Command="{Binding PlacementTarget.DataContext.SelectFromHereCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Выбрать всё"
                                          Command="{Binding PlacementTarget.DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Снять выбор"
                                          Command="{Binding PlacementTarget.DataContext.SelectNoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChronologyRowViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Style="{StaticResource CheckBox.Default}"
                                              AutomationProperties.Name="Включить в плейлист" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Index}"
                                               MinWidth="34"
                                               TextAlignment="Right"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DateText}"
                                               MinWidth="96"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               Foreground="{DynamicResource Fg.Secondary}" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding SourceTitle}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource TextBlock.Subtle}"
                                               FontSize="{DynamicResource Font.Size.S}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
