<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PublishViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="1100"
             Loaded="OnLoaded">
    <UserControl.Resources>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Setter Property="Margin"
                    Value="0,0,0,4" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="OuterScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"
                                      MinWidth="0" />
                    <ColumnDefinition x:Name="PreviewColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="FormCard"
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource Card}">
                    <ScrollViewer x:Name="FormScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Источник"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditFields}"
                                  Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TitleFull}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Название"
                                       Style="{StaticResource FieldLabel}" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="0"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      IsTextSearchEnabled="True"
                                      Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding TitleSuggestions}"
                                      IsEnabled="{Binding CanEditFields}"
                                      ToolTip="Подсказки из истории публикаций для выбранного источника" />

                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource Button.Ghost}"
                                    Margin="6,0,0,0"
                                    Padding="10,4"
                                    Command="{Binding ApplyTitleSuggestionCommand}"
                                    CommandParameter="{Binding FirstTitleSuggestion}"
                                    ToolTip="Подставить последнее опубликованное название"
                                    AutomationProperties.Name="Подставить последнее опубликованное название"
                                    Visibility="{Binding HasTitleSuggestions, Converter={StaticResource BoolToVisibility}}">
                                <iconPacks:PackIconLucide Kind="RotateCcw"
                                                  Width="14"
                                                  Height="14" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Описание"
                                       Style="{StaticResource FieldLabel}" />

                            <Grid Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Visibility="{Binding HasDescriptionTemplates, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox x:Name="DescriptionTemplateComboBox"
                                          ItemsSource="{Binding DescriptionTemplates}"
                                          DisplayMemberPath="Preview"
                                          MinWidth="160"
                                          MaxWidth="320"
                                          IsEnabled="{Binding CanEditFields}"
                                          ToolTip="Шаблоны описания: сайдкар-файлы видео и история источника"
                                          AutomationProperties.Name="Шаблон описания"
                                          SelectionChanged="OnDescriptionTemplateChanged" />
                                <TextBlock Text="Вставить шаблон…"
                                           Foreground="{DynamicResource Fg.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,28,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=DescriptionTemplateComboBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditFields}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"
                                 MaxHeight="240" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,16">
                            <Run Text="Символов:" />
                            <Run Text="{Binding DescriptionLength, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="Видеофайл"
                                   Style="{StaticResource FieldLabel}" />
                        <controls:FilePickerField Path="{Binding VideoPath, Mode=TwoWay}"
                                                  DisplayLabel="{Binding VideoLabel}"
                                                  Placeholder="Нажмите или перетащите файл видео"
                                                  Icon="Film"
                                                  AllowedExtensions=".mp4;.mkv;.webm;.mov;.avi;.m4v;.wmv;.flv;.ts"
                                                  BrowseCommand="{Binding BrowseVideoCommand}"
                                                  ClearCommand="{Binding ClearVideoCommand}"
                                                  IsEnabled="{Binding CanEditFields}"
                                                  BrowseToolTip="Выбрать другой файл"
                                                  BrowseAutomationName="Выбрать другой файл видео"
                                                  ClearAutomationName="Очистить видео"
                                                  Margin="0,0,0,16" />

                        <TextBlock Text="Обложка"
                                   Style="{StaticResource FieldLabel}" />
                        <controls:FilePickerField Path="{Binding CoverPath, Mode=TwoWay}"
                                                  DisplayLabel="{Binding CoverLabel}"
                                                  Placeholder="Опционально – нажмите или перетащите обложку"
                                                  Icon="Image"
                                                  AllowedExtensions=".jpg;.jpeg;.png;.webp;.bmp;.gif"
                                                  BrowseCommand="{Binding BrowseCoverCommand}"
                                                  ClearCommand="{Binding ClearCoverCommand}"
                                                  IsEnabled="{Binding CanEditFields}"
                                                  BrowseToolTip="Выбрать другой файл"
                                                  BrowseAutomationName="Выбрать другой файл обложки"
                                                  ClearAutomationName="Очистить обложку" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

                <Border x:Name="PreviewCard"
                        Grid.Column="1"
                        Grid.Row="0"
                        Width="340"
                        Margin="16,0,0,0"
                        Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Превью обложки"
                               Style="{StaticResource FieldLabel}" />

                    <Border Grid.Row="1"
                            Style="{StaticResource Card.Inset}"
                            Padding="0"
                            MinHeight="200">
                        <Grid>
                            <Image x:Name="CoverPreviewImage"
                                   Source="{Binding CoverPath, Converter={StaticResource StringToImageSource}}"
                                   Stretch="Uniform"
                                   Margin="6"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}">
                                <iconPacks:PackIconLucide Kind="Image"
                                                  Width="36"
                                                  Height="36"
                                                  HorizontalAlignment="Center"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                                <TextBlock Text="Обложка не выбрана"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0">
                        <TextBlock Text="По шаблону"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding TemplatePicker.Profiles}"
                                  SelectedItem="{Binding TemplatePicker.SelectedProfileName, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditFields}"
                                  Margin="0,0,0,8"
                                  ToolTip="Профиль шаблона обложки"
                                  AutomationProperties.Name="Профиль шаблона обложки" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Command="{Binding GenerateCoverFromTemplateCommand}"
                                    Padding="{DynamicResource Padding.Control.Compact}"
                                    Margin="0,0,6,6"
                                    ToolTip="Сгенерировать обложку из выбранного шаблона"
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Сгенерировать обложку по шаблону">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Sparkles"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0" />
                                    <TextBlock Text="По шаблону"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding TemplatePicker.OpenEditorCommand}"
                                    IsEnabled="{Binding CanEditFields}"
                                    Padding="{DynamicResource Padding.Control.Compact}"
                                    Margin="0,0,0,6"
                                    Content="Редактор шаблонов…"
                                    ToolTip="Открыть редактор шаблонов обложек в отдельном окне"
                                    AutomationProperties.Name="Открыть редактор шаблонов обложек" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0">
                            <Run Text="Сохранится в источнике как превью." />
                        </TextBlock>
                    </StackPanel>
                </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Style="{StaticResource Card.Inset}"
                Margin="0,16,0,0"
                Padding="16,12"
                CornerRadius="{DynamicResource Radius.L}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Fg.Secondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource State.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding AuthenticationRecovery.Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                        Content="{Binding SourceTitle}"
                                        ContentStringFormat="Открыть авторизацию · {0}"
                                        Command="{Binding DataContext.AuthenticationRecovery.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              Margin="16,0,0,0"
                              IsChecked="{Binding RunChainAfterPublish}"
                              IsEnabled="{Binding CanEditFields}"
                              ToolTip="После успешной публикации прогнать запланированные передачи по связям источника"
                              AutomationProperties.Name="Запустить цепочку после публикации">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Link"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Цепочка"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Button Grid.Column="2"
                        MinWidth="160"
                        Margin="8,0,0,0"
                        Command="{Binding PublishCommand}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource Button.Primary}">
                            <Setter Property="Content"
                                    Value="Опубликовать" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPublishing}"
                                             Value="True">
                                    <Setter Property="Content"
                                            Value="Отменить" />
                                    <Setter Property="Background"
                                            Value="{DynamicResource State.Error}" />
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource State.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
