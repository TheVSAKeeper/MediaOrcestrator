<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PublishViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="1100"
             Loaded="OnLoaded">
    <UserControl.Resources>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Setter Property="Margin"
                    Value="0,0,0,4" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style x:Key="DropTarget"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Bg.SurfaceAlt}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="{DynamicResource Radius.M}" />
            <Setter Property="Padding"
                    Value="12,10" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource Accent.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Источник"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditFields}"
                                  Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TitleFull}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Название"
                                       Style="{StaticResource FieldLabel}" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="0"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      IsTextSearchEnabled="True"
                                      Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding TitleSuggestions}"
                                      IsEnabled="{Binding CanEditFields}"
                                      ToolTip="Подсказки из истории публикаций для выбранного источника" />

                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource Button.Ghost}"
                                    Margin="6,0,0,0"
                                    Padding="10,4"
                                    Command="{Binding ApplyTitleSuggestionCommand}"
                                    CommandParameter="{Binding FirstTitleSuggestion}"
                                    ToolTip="Подставить последнее опубликованное название"
                                    AutomationProperties.Name="Подставить последнее опубликованное название"
                                    Visibility="{Binding HasTitleSuggestions, Converter={StaticResource BoolToVisibility}}">
                                <iconPacks:PackIconLucide Kind="RotateCcw"
                                                  Width="14"
                                                  Height="14" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Описание"
                                       Style="{StaticResource FieldLabel}" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DescriptionTemplates}"
                                      DisplayMemberPath="Preview"
                                      MinWidth="240"
                                      MaxWidth="320"
                                      Margin="8,0,0,0"
                                      IsEnabled="{Binding CanEditFields}"
                                      ToolTip="Шаблоны описания: сайдкар-файлы видео и история источника"
                                      Visibility="{Binding HasDescriptionTemplates, Converter={StaticResource BoolToVisibility}}"
                                      SelectionChanged="OnDescriptionTemplateChanged" />
                        </Grid>

                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditFields}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"
                                 MaxHeight="240" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,16">
                            <Run Text="Символов:" />
                            <Run Text="{Binding DescriptionLength, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="Видеофайл"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource DropTarget}"
                                Margin="0,0,0,16">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding BrowseVideoCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconLucide Grid.Column="0"
                                                  Kind="Film"
                                                  Width="18"
                                                  Height="18"
                                                  Foreground="{DynamicResource Fg.Secondary}"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding VideoLabel}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding VideoPath}"
                                           Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Grid.Column="1"
                                           Text="Нажмите, чтобы выбрать файл видео"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasVideo, Converter={StaticResource InverseBoolToVisibility}}" />

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Padding="10,4"
                                            Command="{Binding BrowseVideoCommand}"
                                            IsEnabled="{Binding CanEditFields}"
                                            ToolTip="Выбрать другой файл"
                                            AutomationProperties.Name="Выбрать другой файл видео">
                                        <iconPacks:PackIconLucide Kind="Folder"
                                                          Width="16"
                                                          Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Padding="10,4"
                                            Margin="4,0,0,0"
                                            Command="{Binding ClearVideoCommand}"
                                            IsEnabled="{Binding CanEditFields}"
                                            ToolTip="Очистить"
                                            AutomationProperties.Name="Очистить видео"
                                            Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="X"
                                                          Width="16"
                                                          Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Обложка"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource DropTarget}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding BrowseCoverCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconLucide Grid.Column="0"
                                                  Kind="Image"
                                                  Width="18"
                                                  Height="18"
                                                  Foreground="{DynamicResource Fg.Secondary}"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding CoverLabel}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CoverPath}"
                                           Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Grid.Column="1"
                                           Text="Опционально – нажмите, чтобы выбрать обложку"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}" />

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Padding="10,4"
                                            Command="{Binding BrowseCoverCommand}"
                                            IsEnabled="{Binding CanEditFields}"
                                            ToolTip="Выбрать другой файл"
                                            AutomationProperties.Name="Выбрать другой файл обложки">
                                        <iconPacks:PackIconLucide Kind="Folder"
                                                          Width="16"
                                                          Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Padding="10,4"
                                            Margin="4,0,0,0"
                                            Command="{Binding ClearCoverCommand}"
                                            IsEnabled="{Binding CanEditFields}"
                                            ToolTip="Очистить"
                                            AutomationProperties.Name="Очистить обложку"
                                            Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="X"
                                                          Width="16"
                                                          Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Width="340"
                    Margin="16,0,0,0"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Превью обложки"
                               Style="{StaticResource FieldLabel}" />

                    <Border Grid.Row="1"
                            Style="{StaticResource Card.Inset}"
                            Padding="0"
                            MinHeight="200">
                        <Grid>
                            <Image x:Name="CoverPreviewImage"
                                   Source="{Binding CoverPath, Converter={StaticResource StringToImageSource}}"
                                   Stretch="Uniform"
                                   Margin="6"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}">
                                <iconPacks:PackIconLucide Kind="Image"
                                                  Width="36"
                                                  Height="36"
                                                  HorizontalAlignment="Center"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                                <TextBlock Text="Обложка не выбрана"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap">
                            <Run Text="Сохранится в источнике как превью." />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource Card.Inset}"
                Margin="0,16,0,0"
                Padding="16,12"
                CornerRadius="{DynamicResource Radius.L}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Fg.Secondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource State.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              Margin="16,0,0,0"
                              IsChecked="{Binding RunChainAfterPublish}"
                              IsEnabled="{Binding CanEditFields}"
                              ToolTip="После успешной публикации прогнать запланированные передачи по связям источника"
                              AutomationProperties.Name="Запустить цепочку после публикации">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Link"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Цепочка"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Button Grid.Column="2"
                        MinWidth="160"
                        Margin="8,0,0,0"
                        Command="{Binding PublishCommand}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource Button.Primary}">
                            <Setter Property="Content"
                                    Value="Опубликовать" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPublishing}"
                                             Value="True">
                                    <Setter Property="Content"
                                            Value="Отменить" />
                                    <Setter Property="Background"
                                            Value="{DynamicResource State.Error}" />
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource State.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
