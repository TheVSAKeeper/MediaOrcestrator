<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.SourceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourceSettingsViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="540">

    <UserControl.Resources>

        <DataTemplate x:Key="FieldText"
                      DataType="{x:Type vm:SettingFieldViewModel}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource Font.Mono}"
                     FontSize="{DynamicResource Font.Size.S}" />
        </DataTemplate>

        <DataTemplate x:Key="FieldSecret"
                      DataType="{x:Type vm:SettingFieldViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <PasswordBox x:Name="SecretBox"
                                 Visibility="{Binding IsSecretVisible, ConverterParameter=Inverse, Converter={StaticResource BoolToVisibility}}"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 FontSize="{DynamicResource Font.Size.S}" />
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsSecretVisible, Converter={StaticResource BoolToVisibility}}"
                             FontFamily="{DynamicResource Font.Mono}"
                             FontSize="{DynamicResource Font.Size.S}" />
                </Grid>
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding ToggleSecretCommand}"
                        Margin="6,0,0,0"
                        Padding="10,4"
                        MinWidth="40"
                        ToolTip="Показать/скрыть"
                        AutomationProperties.Name="Показать или скрыть секрет">
                    <iconPacks:PackIconLucide Kind="Eye"
                                              Width="16"
                                              Height="16" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FieldPath"
                      DataType="{x:Type vm:SettingFieldViewModel}">
            <keepshell:PathSettingField Path="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        BrowseCommand="{Binding BrowsePathCommand}" />
        </DataTemplate>

        <DataTemplate x:Key="FieldDropdown"
                      DataType="{x:Type vm:SettingFieldViewModel}">
            <StackPanel>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          MinHeight="30" />
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding DataContext.LoadOptionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Margin="0,6,0,0"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Visibility="{Binding CanLoadOptions, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Загрузить" />
                        <TextBlock Text=" …"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   Visibility="{Binding IsLoadingOptions, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <vm:SettingFieldTemplateSelector x:Key="FieldSelector"
                                         TextTemplate="{StaticResource FieldText}"
                                         SecretTemplate="{StaticResource FieldSecret}"
                                         PathTemplate="{StaticResource FieldPath}"
                                         DropdownTemplate="{StaticResource FieldDropdown}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card.Inset}"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Имя источника *"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0" />
                <TextBlock Text="Отображается в списке и в матрице медиа."
                           Style="{StaticResource TextBlock.Subtle}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsCopySupported, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Скопировать из другого источника"
                                           FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                           Margin="0,2,0,0">
                                    <Run Text="Доступно источников этого же типа:" />
                                    <Run Text="{Binding CopyableSources.Count, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenCopyPickerCommand}"
                                    Padding="12,4"
                                    MinHeight="32"
                                    VerticalAlignment="Center"
                                    Content="Выбрать…" />
                        </Grid>

                        <Border BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="{DynamicResource Padding.Panel.Dense}"
                                Margin="0,10,0,0"
                                Background="{DynamicResource Bg.SurfaceAlt}"
                                Visibility="{Binding IsCopyPickerOpen, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ListBox ItemsSource="{Binding CopyableSources}"
                                         SelectedItem="{Binding CopyPickerSelected, Mode=TwoWay}"
                                         DisplayMemberPath="Title"
                                         MaxHeight="160" />
                                <CheckBox Content="Копировать данные авторизации"
                                          IsChecked="{Binding CopyIncludesAuth, Mode=TwoWay}"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding IsAuthSupported, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Command="{Binding CancelCopyCommand}"
                                            Content="Отмена"
                                            Margin="0,0,8,0"
                                            Padding="12,4" />
                                    <Button Style="{StaticResource Button.Primary}"
                                            Command="{Binding ApplyCopyCommand}"
                                            Content="Применить"
                                            Padding="12,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsAuthSupported, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Авторизация"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <Ellipse Width="9"
                                         Height="9"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource State.Error}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticated}"
                                                             Value="True">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource State.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding AuthStatusText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1"
                              VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding AuthenticateCommand}"
                                    Padding="12,4"
                                    MinHeight="32"
                                    Visibility="{Binding IsAuthenticating, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="LogIn"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,6,0" />
                                    <TextBlock Text="Авторизовать…"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="⟳ Открывается браузер…"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsAuthenticating, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsQuotaSupported, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Gauge"
                                                  Width="16"
                                                  Height="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Квота YouTube API (оценка)"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QuotaStatusText}"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Fg.Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuotaExhausted}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource State.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingFieldViewModel}">
                            <Border Style="{StaticResource Card.Inset}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding LabelWithRequired}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource TextBlock.Subtle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplateSelector="{StaticResource FieldSelector}"
                                                    Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
