<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:transfers="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Transfers"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TransfersViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MediaOrcestrator.Runner.Wpf;component/Views/Transfers/TransfersResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <transfers:TransfersToolbarPanel x:Name="ToolbarPanel"
                                         Grid.Row="0" />

        <Border Grid.Row="1"
                Background="{DynamicResource State.WarningSoft}"
                BorderBrush="{DynamicResource State.Warning}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Padding="12,8"
                Margin="{DynamicResource Margin.StackItem}"
                Visibility="{Binding DanglingRelationsWarning, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="TriangleAlert"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource State.Warning}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          AutomationProperties.Name="Внимание" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DanglingRelationsWarning}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource State.ErrorSoft}"
                            BorderBrush="{DynamicResource State.Error}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPlan}"
                                                       Value="True" />
                                            <Condition Binding="{Binding HasRunErrors}"
                                                       Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="TriangleAlert"
                                                      Width="14"
                                                      Height="14"
                                                      Foreground="{DynamicResource State.Error}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      AutomationProperties.Name="Ошибка" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="В последнем прогоне были ошибки – проверьте строки дерева или журнал прогона."
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding AuthenticationRecovery.Failures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding SourceTitle}"
                                                    ContentStringFormat="Открыть авторизацию · {0}"
                                                    Command="{Binding DataContext.AuthenticationRecovery.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <TreeView x:Name="TransfersTreeView"
                              ItemsSource="{Binding Groups}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="8"
                              ItemContainerStyle="{StaticResource TreeItemContainer}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnTreePreviewMouseMove"
                              DragOver="OnTreeDragOver"
                              Drop="OnTreeDrop"
                              Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                        <TreeView.Resources>

                            <HierarchicalDataTemplate DataType="{x:Type vm:TransferMediaGroupViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,3">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Выбрать всё в группе"
                                                      Command="{Binding SelectAllInGroupCommand}" />
                                            <MenuItem Header="Снять всё в группе"
                                                      Command="{Binding DeselectAllInGroupCommand}" />
                                            <Separator />
                                            <MenuItem Header="Открыть в Медиа"
                                                      Command="{Binding OpenInMediaCommand}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <CheckBox Style="{StaticResource GroupCheckBox}"
                                              IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="Выбрать/снять все шаги этой группы" />
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource Font.Size.L}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="640" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:TransferIntentNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Выполнить только этот шаг"
                                                      Command="{Binding PlacementTarget.Tag.RunSingleStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Открыть медиа в разделе «Медиа»"
                                                      Command="{Binding OpenInMediaCommand}" />
                                            <MenuItem Header="Показать связь в графе"
                                                      Command="{Binding ShowInGraphCommand}" />
                                            <Separator />
                                            <MenuItem Header="Выделить вместе с цепочкой"
                                                      Command="{Binding SelectChainCommand}" />
                                            <MenuItem Header="Снять выделение"
                                                      Command="{Binding DeselectChainCommand}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <controls:StatusIndicator Status="{Binding StatusKind}"
                                                              Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Route}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="520" />
                                    <TextBlock Text="{Binding StatusTail}"
                                               Style="{StaticResource StatusTail}"
                                               ToolTip="{Binding ErrorTooltip}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <keepshell:EmptyState VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          DescriptionMaxWidth="420">
                        <keepshell:EmptyState.Style>
                            <Style TargetType="keepshell:EmptyState">
                                <Setter Property="Icon"
                                        Value="{Binding EmptyIcon}" />
                                <Setter Property="Heading"
                                        Value="{Binding EmptyHeading}" />
                                <Setter Property="Description"
                                        Value="{Binding EmptyHint}" />
                                <Setter Property="Visibility"
                                        Value="{Binding EmptyHint, Converter={StaticResource NullToVisibility}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlanError}"
                                                 Value="True">
                                        <Setter Property="ActionText"
                                                Value="Повторить" />
                                        <Setter Property="ActionCommand"
                                                Value="{Binding RebuildPlanCommand}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPlanError}"
                                                       Value="False" />
                                            <Condition Binding="{Binding HasPlan}"
                                                       Value="False" />
                                            <Condition Binding="{Binding HasRunErrors}"
                                                       Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                        <Setter Property="Icon"
                                                Value="TriangleAlert" />
                                        <Setter Property="Heading"
                                                Value="В последнем прогоне были ошибки" />
                                        <Setter Property="Description"
                                                Value="Подробности смотрите в журнале прогона." />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </keepshell:EmptyState.Style>
                    </keepshell:EmptyState>

                    <Grid Visibility="{Binding IsRebuilding, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Fill="{DynamicResource Bg.Surface}"
                                   Opacity="0.7" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid Width="22"
                                  Height="22"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource Border.Subtle}"
                                         StrokeThickness="2.5"
                                         Fill="Transparent" />
                                <Path StrokeThickness="2.5"
                                      Stroke="{DynamicResource Accent.Primary}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="M 11 1 A 10 10 0 0 1 20.5 8.5"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}"
                                                                   Value="True" />
                                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PlanSpinnerRotateStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0"
                                                                                 To="360"
                                                                                 Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="PlanSpinnerRotateStoryboard" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <TextBlock Text="Построение плана…"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextBlock.Subtle}" />
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="JournalBorder"
                    Grid.Column="1"
                    Width="340"
                    Margin="10,0,0,0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Visibility="{Binding IsJournalOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Журнал прогона"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding Journal.Count, Mode=OneWay}" />
                            <Run Text="событий" />
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Journal}"
                                              Padding="12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,2">
                                                <TextBlock Text="{Binding TimeText}"
                                                           Style="{StaticResource TextBlock.Mono}"
                                                           Foreground="{DynamicResource Fg.Muted}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,8,0" />
                                                <TextBlock Text="{Binding Text}"
                                                           Style="{StaticResource JournalEntryText}"
                                                           MaxWidth="240" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <keepshell:EmptyState VerticalAlignment="Center"
                                                  Icon="ScrollText"
                                                  Heading="Журнал пока пуст"
                                                  Description="Здесь появятся события текущего прогона."
                                                  DescriptionMaxWidth="260"
                                                  Margin="12">
                                <keepshell:EmptyState.Style>
                                    <Style TargetType="keepshell:EmptyState">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Journal.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </keepshell:EmptyState.Style>
                            </keepshell:EmptyState>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <ContentControl Grid.Row="3"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource TransferActions}" />
    </Grid>
</UserControl>
