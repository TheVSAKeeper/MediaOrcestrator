<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TransfersViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>

        <Style x:Key="HeaderButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Base}">
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Padding"
                    Value="12,4" />
            <Setter Property="Margin"
                    Value="0,0,6,0" />
        </Style>

        <Style x:Key="ActionBar.Primary"
               TargetType="Button"
               BasedOn="{StaticResource Button.Base}">
            <Setter Property="MinHeight"
                    Value="44" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.M}" />
            <Setter Property="Background"
                    Value="{DynamicResource Accent.Soft}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Accent.Primary}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Accent.Primary}" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style x:Key="ActionBar.Danger"
               TargetType="Button"
               BasedOn="{StaticResource Button.Base}">
            <Setter Property="MinHeight"
                    Value="44" />
            <Setter Property="Background"
                    Value="{DynamicResource State.ErrorSoft}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource State.Error}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource State.Error}" />
        </Style>

        <Style x:Key="MenuItemButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Padding"
                    Value="12,6" />
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>

        <Style x:Key="GroupCheckBox"
               TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="IsThreeState"
                    Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator>
                            <BulletDecorator.Bullet>
                                <Border x:Name="Box"
                                        Width="18"
                                        Height="18"
                                        Background="{DynamicResource Bg.Surface}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.S}">
                                    <Grid>
                                        <Path x:Name="CheckMark"
                                              Data="M 4 9 L 7 12 L 14 5"
                                              Stroke="{DynamicResource Fg.OnAccent}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <Rectangle x:Name="IndeterminateMark"
                                                   Width="10"
                                                   Height="2"
                                                   Fill="{DynamicResource Fg.OnAccent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="{x:Null}">
                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="IndeterminateMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTail"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="8,0,0,0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Working">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Waiting">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Ok">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}"
                             Value="NonRetriable">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JournalEntryText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}"
                             Value="Success">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}"
                             Value="Warning">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeItemContainer"
               TargetType="TreeViewItem">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding"
                    Value="2" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VirtualizingPanel.IsVirtualizing"
                    Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode"
                    Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Column="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Glyph"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                                  Fill="{DynamicResource Fg.Muted}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="Glyph"
                                                        Property="Data"
                                                        Value="M 0 0 L 8 0 L 4 4 Z" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Glyph"
                                                        Property="Fill"
                                                        Value="{DynamicResource Accent.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border Grid.Column="1"
                                    x:Name="HeaderBorder"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource Radius.S}"
                                    Padding="4,2">
                                <ContentPresenter ContentSource="Header" />
                            </Border>

                            <ItemsPresenter Grid.Row="1"
                                            Grid.Column="1"
                                            x:Name="ItemsHost"
                                            Margin="14,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded"
                                     Value="False">
                                <Setter TargetName="ItemsHost"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems"
                                     Value="False">
                                <Setter TargetName="Expander"
                                        Property="Visibility"
                                        Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     SourceName="HeaderBorder"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card.Inset}"
                Margin="{DynamicResource Margin.StackItem}"
                ToolTip="Дерево цепочек: медиа → шаги передачи через активные связи. План строится по новым медиа в исходных источниках; пересборка ручная.">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TextBox.Toolbar}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 keepshell:PlaceholderBehavior.Placeholder="Название медиа"
                                 AutomationProperties.Name="Поиск по плану передач"
                                 MinWidth="220"
                                 Padding="32,0,32,0" />
                        <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="Search"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource Fg.Muted}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False" />
                        <Button Grid.Column="0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ClearSearchCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Padding="6,2"
                                ToolTip="Очистить поиск"
                                AutomationProperties.Name="Очистить поиск"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="X"
                                              Width="12"
                                              Height="12" />
                        </Button>
                    </Grid>

                    <ToggleButton x:Name="SourcesFilterToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleButton.Filter}"
                                  Margin="6,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Источники"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Kind="ChevronDown"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource Fg.Muted}"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=SourcesFilterToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=SourcesFilterToggle, Mode=TwoWay}">
                        <controls:FilterChecklist ItemsSource="{Binding SourceFilters}"
                                                  MinWidth="240"
                                                  Margin="0,4,0,0" />
                    </Popup>

                    <ToggleButton x:Name="RelationsFilterToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource ToggleButton.Filter}"
                                  Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Связи"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Kind="ChevronDown"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource Fg.Muted}"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=RelationsFilterToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=RelationsFilterToggle, Mode=TwoWay}">
                        <controls:FilterChecklist ItemsSource="{Binding RelationFilters}"
                                                  MinWidth="280"
                                                  Margin="0,4,0,0" />
                    </Popup>

                    <ToggleButton x:Name="MoreMenuToggle"
                                  Grid.Column="3"
                                  Style="{StaticResource ToggleButton.Filter}"
                                  Margin="0,0,4,0"
                                  IsChecked="{Binding IsMoreMenuOpen, Mode=TwoWay}"
                                  ToolTip="Дополнительные действия"
                                  AutomationProperties.Name="Дополнительные действия"
                                  Padding="14,4">
                        <iconPacks:PackIconLucide Kind="Ellipsis"
                                          Width="18"
                                          Height="18" />
                    </ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=MoreMenuToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           IsOpen="{Binding IsMoreMenuOpen, Mode=TwoWay}">
                        <Border Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="4"
                                MinWidth="220"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding SelectAllCommand}">
                                    <TextBlock Text="Выбрать всё" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding DeselectAllCommand}">
                                    <TextBlock Text="Снять всё" />
                                </Button>
                                <Border Height="1"
                                        Background="{DynamicResource Border.Subtle}"
                                        Margin="6,4" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding ExpandAllCommand}">
                                    <TextBlock Text="Развернуть всё" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding CollapseAllCommand}">
                                    <TextBlock Text="Свернуть всё" />
                                </Button>
                                <Border Height="1"
                                        Background="{DynamicResource Border.Subtle}"
                                        Margin="6,4" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding ResetFiltersCommand}">
                                    <TextBlock Text="Сбросить фильтры" />
                                </Button>
                                <Border Height="1"
                                        Background="{DynamicResource Border.Subtle}"
                                        Margin="6,4" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding ClearJournalCommand}">
                                    <TextBlock Text="Очистить журнал" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Grid.Column="4"
                            Style="{StaticResource HeaderButton}"
                            Command="{Binding RebuildPlanCommand}"
                            Margin="6,0,0,0"
                            ToolTip="Перестроить план по текущим медиа и связям">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12"
                                  Height="12"
                                  Stretch="None"
                                  Stroke="{DynamicResource Fg.Primary}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Data="M 11 6 A 5 5 0 1 1 1 6 L 3 4 L 5 6 L 1 6" />
                            <TextBlock Text="Пересобрать" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"
                                          MinWidth="0" />
                        <ColumnDefinition Width="*"
                                          MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"
                                              MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="PlanSummary" />
                                                <Binding Path="SelectionSummary" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                            <Run Text="{Binding PlanSummary, Mode=OneWay}"
                                 FontWeight="SemiBold" />
                            <Run Text="·"
                                 Foreground="{DynamicResource Fg.Muted}" />
                            <Run Text="{Binding SelectionSummary, Mode=OneWay}"
                                 Foreground="{DynamicResource Fg.Muted}" />
                        </TextBlock>

                        <Border x:Name="PlanStaleBadge"
                                Grid.Column="1"
                                Background="{DynamicResource State.WarningSoft}"
                                BorderBrush="{DynamicResource State.Warning}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                ToolTip="Данные могли измениться после построения плана. Пересоберите план, чтобы увидеть актуальные передачи."
                                Visibility="{Binding IsPlanStale, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border"
                                       BasedOn="{StaticResource Badge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlanStale}"
                                                     Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PlanStaleBadgePulse">
                                                    <Storyboard RepeatBehavior="Forever"
                                                                AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1.0"
                                                                         To="1.06"
                                                                         Duration="0:0:1.1" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1.0"
                                                                         To="1.06"
                                                                         Duration="0:0:1.1" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0"
                                                                         To="0.65"
                                                                         Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PlanStaleBadgePulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PlanStaleBadgeScale"
                                                ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="TriangleAlert"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource State.Warning}"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center" />
                                <TextBlock Text="план устарел"
                                           Foreground="{DynamicResource State.Warning}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Style="{StaticResource TextBlock.Subtle}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding StatusText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="16,0,16,0" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="RunOptionsToggle"
                                      Style="{StaticResource ToggleButton.Filter}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Padding="8,4"
                                      AutomationProperties.Name="Параметры прогона"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{Binding UploadIntervalHint}">
                            <Grid>
                                <iconPacks:PackIconLucide Kind="SlidersHorizontal"
                                                  Width="16"
                                                  Height="16" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource Accent.Primary}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-2,-4,0"
                                         Visibility="{Binding UploadIntervalEnabled, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=RunOptionsToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=RunOptionsToggle, Mode=TwoWay}">
                            <Border Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="12"
                                    MinWidth="260"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Параметры прогона"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <ToggleButton Content="Пауза между загрузками"
                                                  Style="{StaticResource ToggleButton.Filter}"
                                                  IsChecked="{Binding UploadIntervalEnabled}"
                                                  IsEnabled="{Binding CanEditUploadInterval}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="Пауза после каждой успешной загрузки – ВК хуже показывает видео, залитые пачкой." />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0">
                                        <TextBox Width="52"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,4,0"
                                                 IsEnabled="{Binding CanEditUploadIntervalMinutes}"
                                                 MaxLength="4"
                                                 Text="{Binding UploadIntervalMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Пауза между загрузками, минут"
                                                 ToolTipService.ShowOnDisabled="True"
                                                 ToolTip="{Binding UploadIntervalHint}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox"
                                                       BasedOn="{StaticResource TextBox.Form}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUploadIntervalValid}"
                                                                     Value="False">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource State.Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Text="мин"
                                                   Style="{StaticResource TextBlock.Subtle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <ToggleButton Content="Стоп при ошибке"
                                      Style="{StaticResource ToggleButton.Filter}"
                                      IsChecked="{Binding StopOnError}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      ToolTip="Если включено – первая ошибка останавливает прогон." />
                        <ToggleButton Style="{StaticResource ToggleButton.Filter}"
                                      IsChecked="{Binding IsJournalOpen}"
                                      VerticalAlignment="Center"
                                      Margin="0"
                                      Padding="8,4"
                                      AutomationProperties.Name="Журнал прогона"
                                      ToolTip="Показать/скрыть боковую панель с журналом прогона.">
                            <iconPacks:PackIconLucide Kind="PanelRight"
                                              Width="16"
                                              Height="16" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0">
                <Grid>
                    <TreeView x:Name="TransfersTreeView"
                              ItemsSource="{Binding Groups}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="8"
                              ItemContainerStyle="{StaticResource TreeItemContainer}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnTreePreviewMouseMove"
                              DragOver="OnTreeDragOver"
                              Drop="OnTreeDrop"
                              Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                        <TreeView.Resources>

                            <HierarchicalDataTemplate DataType="{x:Type vm:TransferMediaGroupViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,3">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Выбрать всё в группе"
                                                      Command="{Binding SelectAllInGroupCommand}" />
                                            <MenuItem Header="Снять всё в группе"
                                                      Command="{Binding DeselectAllInGroupCommand}" />
                                            <Separator />
                                            <MenuItem Header="Открыть в Медиа"
                                                      Command="{Binding OpenInMediaCommand}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <CheckBox Style="{StaticResource GroupCheckBox}"
                                              IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="Выбрать/снять все шаги этой группы" />
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource Font.Size.L}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="640" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:TransferIntentNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Выполнить только этот шаг"
                                                      Command="{Binding RunSingleStepCommand}" />
                                            <Separator />
                                            <MenuItem Header="Открыть медиа в разделе «Медиа»"
                                                      Command="{Binding OpenInMediaCommand}" />
                                            <MenuItem Header="Показать связь в графе"
                                                      Command="{Binding ShowInGraphCommand}" />
                                            <Separator />
                                            <MenuItem Header="Выделить вместе с цепочкой"
                                                      Command="{Binding SelectChainCommand}" />
                                            <MenuItem Header="Снять выделение"
                                                      Command="{Binding DeselectChainCommand}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <controls:StatusIndicator Status="{Binding StatusKind}"
                                                              Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Route}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="520" />
                                    <TextBlock Text="{Binding StatusTail}"
                                               Style="{StaticResource StatusTail}"
                                               ToolTip="{Binding ErrorTooltip}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <keepshell:EmptyState VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Icon="{Binding EmptyIcon}"
                                          Heading="{Binding EmptyHeading}"
                                          Description="{Binding EmptyHint}"
                                          DescriptionMaxWidth="420"
                                          Visibility="{Binding EmptyHint, Converter={StaticResource NullToVisibility}}" />

                    <Grid Visibility="{Binding IsRebuilding, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Fill="{DynamicResource Bg.Surface}"
                                   Opacity="0.7" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid Width="22"
                                  Height="22"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource Border.Subtle}"
                                         StrokeThickness="2.5"
                                         Fill="Transparent" />
                                <Path StrokeThickness="2.5"
                                      Stroke="{DynamicResource Accent.Primary}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="M 11 1 A 10 10 0 0 1 20.5 8.5"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="PlanSpinnerRotate" Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Path.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    
                                                    <DoubleAnimation Storyboard.TargetName="PlanSpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0"
                                                                     To="360"
                                                                     Duration="0:0:1"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                            <TextBlock Text="Построение плана…"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextBlock.Subtle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Width="340"
                    Margin="10,0,0,0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Visibility="{Binding IsJournalOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Журнал прогона"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding Journal.Count, Mode=OneWay}" />
                            <Run Text="событий" />
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Journal}"
                                              Padding="12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,2">
                                                <TextBlock Text="{Binding TimeText}"
                                                           Style="{StaticResource TextBlock.Mono}"
                                                           Foreground="{DynamicResource Fg.Muted}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,8,0" />
                                                <TextBlock Text="{Binding Text}"
                                                           Style="{StaticResource JournalEntryText}"
                                                           MaxWidth="240" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <keepshell:EmptyState VerticalAlignment="Center"
                                                  Icon="ScrollText"
                                                  Heading="Журнал пока пуст"
                                                  Description="Здесь появятся события текущего прогона."
                                                  DescriptionMaxWidth="260"
                                                  Margin="12">
                                <keepshell:EmptyState.Style>
                                    <Style TargetType="keepshell:EmptyState">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Journal.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </keepshell:EmptyState.Style>
                            </keepshell:EmptyState>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,8,0,0">

            <Grid Margin="{DynamicResource Margin.StackItem}"
                  Visibility="{Binding HasRunProgress, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding RunProgressPercent, Mode=OneWay}"
                             Background="{DynamicResource Bg.SurfaceAlt}"
                             BorderBrush="{DynamicResource Border.Subtle}"
                             Foreground="{DynamicResource Accent.Primary}"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RunProgressText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ActionBar.Primary}"
                        Command="{Binding ExecuteSelectedCommand}"
                        Content="{Binding ExecuteButtonText}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,8,0" />

                <Button Grid.Column="1"
                        Style="{StaticResource ActionBar.Danger}"
                        Command="{Binding StopCommand}"
                        MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource State.Error}"
                              StrokeThickness="1.6"
                              Fill="{DynamicResource State.ErrorSoft}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              Data="M 2 2 L 10 2 L 10 10 L 2 10 Z" />
                        <TextBlock Text="Остановить" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
