<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.CleanupAndBackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanupAndBackupsViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
        <StackPanel>
            <views:MaintenanceView DataContext="{Binding Files}"
                                   Margin="0,0,0,4" />
            <views:DatabaseCleanupView DataContext="{Binding Database}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
