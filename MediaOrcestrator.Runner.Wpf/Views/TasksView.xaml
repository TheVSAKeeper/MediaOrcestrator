<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TasksViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="Tasks.CompletedToggle"
               TargetType="ToggleButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="10,4" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Compact}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tasks.ChevronButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="AutomationProperties.Name"
                    Value="Свернуть/развернуть подзадачи" />
            <Setter Property="Padding"
                    Value="4,0" />
            <Setter Property="MinWidth"
                    Value="20" />
            <Setter Property="MinHeight"
                    Value="20" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
        </Style>

        <DataTemplate DataType="{x:Type vm:ActionRowViewModel}">
            <Border Style="{StaticResource Card.Inset}"
                    Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}"
                    Padding="0"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"
                                          SharedSizeGroup="TasksActions" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0"
                               Style="{StaticResource Rect.ActionAccent}"
                               RadiusX="2"
                               RadiusY="2" />

                    <Grid Grid.Column="1"
                          Margin="12,10,12,10"
                          Visibility="{Binding FullVisibility, RelativeSource={RelativeSource AncestorType=views:TasksView}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"
                                           MinHeight="16" />
                            <RowDefinition Height="Auto"
                                           MinHeight="16" />
                            <RowDefinition Height="Auto"
                                           MinHeight="14" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource Tasks.ChevronButton}"
                                    Command="{Binding ToggleExpandCommand}"
                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityHidden}}"
                                    ToolTip="Свернуть/развернуть подзадачи"
                                    Margin="0,0,6,0">
                                <iconPacks:PackIconLucide Kind="{Binding ChevronIcon}"
                                                          Width="12"
                                                          Height="12" />
                            </Button>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding TimeBadge}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       FontFamily="Consolas"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding StateText}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Status}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding Subtitle}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibilityHidden}}" />

                        <Grid Grid.Row="3"
                              Margin="0,8,0,0"
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityHidden}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Maximum="{Binding ProgressMax}"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         Height="6"
                                         VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressLabel}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding HasProgressLabel, Converter={StaticResource BoolToVisibility}}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1"
                          Margin="12,6,12,6"
                          Visibility="{Binding CompactVisibility, RelativeSource={RelativeSource AncestorType=views:TasksView}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource Tasks.ChevronButton}"
                                Command="{Binding ToggleExpandCommand}"
                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityHidden}}"
                                ToolTip="Свернуть/развернуть подзадачи"
                                Margin="0,0,6,0">
                            <iconPacks:PackIconLucide Kind="{Binding ChevronIcon}"
                                                      Width="12"
                                                      Height="12" />
                        </Button>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   MaxWidth="260" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding CompactSubline}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding TimeBadge}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   FontFamily="Consolas"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="0,10,12,10"
                                VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.Ghost}"
                                Content="Подробнее"
                                Padding="10,4"
                                MinHeight="{DynamicResource Control.Height.Compact}"
                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                Content="Отменить"
                                Padding="10,4"
                                MinHeight="{DynamicResource Control.Height.Compact}"
                                Margin="6,0,0,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="{DynamicResource Margin.StackItem}"
              Visibility="{Binding HasAnyTasks, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton Grid.Column="0"
                          Style="{StaticResource Tasks.CompletedToggle}"
                          IsChecked="{Binding IsCompletedExpanded, Mode=TwoWay}"
                          Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CompletedHeader}"
                               VerticalAlignment="Center" />
                    <iconPacks:PackIconLucide Kind="{Binding CompletedChevron}"
                                              Width="14"
                                              Height="14"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <Button Grid.Column="2"
                    Style="{StaticResource Button.Ghost}"
                    Content="Очистить завершённые"
                    Command="{Binding ClearCompletedCommand}"
                    Padding="10,4"
                    MinHeight="{DynamicResource Control.Height.Compact}"
                    Margin="6,0,0,0"
                    Visibility="{Binding CompletedExpandedVisibility}" />

            <Button Grid.Column="3"
                    Content="Отменить все активные"
                    Command="{Binding CancelAllCommand}"
                    Padding="10,4"
                    MinHeight="{DynamicResource Control.Height.Compact}"
                    Margin="6,0,0,0">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource Button.Ghost}">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasActive}"
                                               Value="True" />
                                    <Condition Binding="{Binding FullVisibility, RelativeSource={RelativeSource AncestorType=views:TasksView}}"
                                               Value="Visible" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <keepshell:EmptyState Grid.Row="1"
                              VerticalAlignment="Center"
                              Icon="ListChecks"
                              Heading="Задач нет"
                              Description="Синк, передачи и пакетные операции появятся здесь, пока идут, и осядут в завершённых."
                              Visibility="{Binding HasNoVisibleItems, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="1"
                      Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Active}" />

                <Border BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Margin="0,8,0,0"
                        Padding="0,8,0,0"
                        Visibility="{Binding CompletedExpandedVisibility}">
                    <ItemsControl ItemsSource="{Binding Completed}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
