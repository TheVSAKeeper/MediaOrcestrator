<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:m="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Media"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MediaViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <DataTemplate x:Key="ActionMenuItemTemplate">
            <Grid>
                <Border Height="1"
                        Margin="4,5"
                        Background="{DynamicResource Border.Subtle}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}}" />

                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}"
                        ToolTip="{Binding Tooltip}"
                        Click="OnActionMenuItemClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,1"
                        Padding="8,5"
                        AutomationProperties.Name="{Binding Text}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{Binding IconOrDefault}"
                                                  Foreground="{Binding GlyphBrush}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <m:MediaSearchBar x:Name="SearchBar"
                          Grid.Row="0"
                          DataContext="{Binding Filter}" />

        <m:MediaFilterBar Grid.Row="1" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="260" />
                <ColumnDefinition x:Name="SplitterColumn"
                                  Width="6" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="480"
                                  MinWidth="260" />
            </Grid.ColumnDefinitions>

            <m:MediaGridView Grid.Column="0"
                             DataContext="{Binding Grid}" />

            <GridSplitter Grid.Column="1"
                          x:Name="InspectorSplitter"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource Border.Subtle}"
                          ShowsPreview="False"
                          DragCompleted="OnInspectorSplitterDragCompleted"
                          ToolTip="Перетащите, чтобы изменить ширину панели"
                          Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />

            <m:MediaInspectorPanel Grid.Column="2" />
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Grid Margin="0,0,4,0">
                        <ToggleButton x:Name="TransferButton"
                                      Style="{StaticResource ToggleButton.Toolbar}"
                                      Height="Auto"
                                      MinHeight="{DynamicResource Control.Height.Compact}"
                                      Padding="8,2"
                                      ToolTip="Передать через связь источников"
                                      AutomationProperties.Name="Передать через связь источников">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ArrowLeftRight"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Передать"
                                           VerticalAlignment="Center" />
                                <iconPacks:PackIconLucide Kind="ChevronDown"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="{DynamicResource Fg.Muted}"
                                                          VerticalAlignment="Center"
                                                          Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding ElementName=TransferButton, Path=IsChecked}"
                               PlacementTarget="{Binding ElementName=TransferButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="6"
                                    MinWidth="280"
                                    MaxWidth="420">
                                <StackPanel>
                                    <TextBlock Text="Передать через связь"
                                               Style="{StaticResource TextBlock.Subtle}"
                                               Margin="6,2,6,6" />
                                    <ItemsControl ItemsSource="{Binding Grid.TransferMenuItems}"
                                                  ItemTemplate="{StaticResource ActionMenuItemTemplate}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding Grid.OpenRenameOperationCommand}"
                            IsEnabled="{Binding Grid.HasSelection}"
                            MinHeight="{DynamicResource Control.Height.Compact}"
                            Padding="{DynamicResource Padding.Control.Compact}"
                            Margin="0,0,4,0"
                            ToolTip="Открыть пакетное переименование для выделенного"
                            AutomationProperties.Name="Переименовать выделенное">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Pencil"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Переименовать"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding Grid.OpenPreviewOperationCommand}"
                            IsEnabled="{Binding Grid.HasSelection}"
                            MinHeight="{DynamicResource Control.Height.Compact}"
                            Padding="{DynamicResource Padding.Control.Compact}"
                            Margin="0,0,4,0"
                            ToolTip="Открыть обновление обложек для выделенного"
                            AutomationProperties.Name="Обложки выделенного">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Image"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Обложки"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding Grid.OpenMergeOperationCommand}"
                            IsEnabled="{Binding Grid.HasSelection}"
                            MinHeight="{DynamicResource Control.Height.Compact}"
                            Padding="{DynamicResource Padding.Control.Compact}"
                            Margin="0"
                            ToolTip="Открыть слияние дублей для выделенного"
                            AutomationProperties.Name="Слить дубли выделенного">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Merge"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Слить дубли"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Grid.Column="1"
                      Margin="6,0,0,0">
                    <ToggleButton x:Name="MoreActionsButton"
                                  Style="{StaticResource ToggleButton.Toolbar}"
                                      Height="Auto"
                                      MinHeight="{DynamicResource Control.Height.Compact}"
                                      Padding="8,2"
                                  ToolTip="Все действия над выделением"
                                  AutomationProperties.Name="Все действия над выделением">
                        <iconPacks:PackIconLucide Kind="Ellipsis"
                                                  Width="16"
                                                  Height="16"
                                                  VerticalAlignment="Center" />
                    </ToggleButton>
                    <Popup IsOpen="{Binding ElementName=MoreActionsButton, Path=IsChecked}"
                           PlacementTarget="{Binding ElementName=MoreActionsButton}"
                           Placement="Top"
                           HorizontalOffset="-244"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="6"
                                MinWidth="280"
                                MaxWidth="420">
                            <StackPanel>
                                <TextBlock Text="Выделение ничего не предлагает – отметьте медиа в таблице"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           TextWrapping="Wrap"
                                           Margin="6,4"
                                           Visibility="{Binding Grid.HasPanelActions, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ScrollViewer MaxHeight="420"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Grid.PanelActionItems}"
                                                  ItemTemplate="{StaticResource ActionMenuItemTemplate}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
