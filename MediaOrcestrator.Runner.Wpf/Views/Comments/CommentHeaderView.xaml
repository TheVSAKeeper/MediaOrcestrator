<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Comments.CommentHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Comments"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CommentItemViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:Avatar Size="28"
                         Initial="{Binding AuthorInitial}"
                         ImageSource="{Binding AuthorAvatarSource}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AuthorName}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource Comments.AuthorFontSize}" />
                <Border Style="{StaticResource Badge}"
                        Background="{DynamicResource State.SuccessSoft}"
                        Margin="6,0,0,0"
                        Visibility="{Binding IsAuthor, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="автор"
                               FontSize="{DynamicResource Comments.BadgeFontSize}"
                               Foreground="{DynamicResource State.Success}" />
                </Border>
                <Border Style="{StaticResource Badge}"
                        Background="{DynamicResource State.ErrorSoft}"
                        Margin="6,0,0,0"
                        Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="удалён"
                               FontSize="{DynamicResource Comments.BadgeFontSize}"
                               Foreground="{DynamicResource State.Error}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,2,0,0">
                <TextBlock Text="{Binding DateText}"
                           FontSize="{DynamicResource Comments.MetaFontSize}"
                           Foreground="{DynamicResource Fg.Muted}"
                           ToolTip="{Binding AbsoluteDateText}" />
                <TextBlock Text=" · "
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Comments.MetaFontSize}" />
                <TextBlock Text="{Binding SourceTitle}"
                           FontSize="{DynamicResource Comments.MetaFontSize}"
                           Foreground="{DynamicResource Fg.Muted}" />
                <TextBlock Text=" · "
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Comments.MetaFontSize}" />
                <TextBlock Text="{Binding MediaTitle}"
                           FontSize="{DynamicResource Comments.MetaFontSize}"
                           Foreground="{DynamicResource Fg.Muted}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="320" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Ghost}"
                    Padding="6,2"
                    MinHeight="24"
                    Command="{Binding OpenMediaInSourceCommand}"
                    Visibility="{Binding HasMediaExternalLink, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Открыть медиа в источнике"
                    AutomationProperties.Name="Открыть медиа в источнике">
                <iconPacks:PackIconLucide Kind="ExternalLink"
                                  Width="14"
                                  Height="14" />
            </Button>
            <Button Style="{StaticResource Button.Ghost}"
                    Padding="6,2"
                    Margin="4,0,0,0"
                    MinHeight="24"
                    Command="{Binding OpenInSourceCommand}"
                    Visibility="{Binding HasCommentPermalink, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Открыть комментарий в источнике"
                    AutomationProperties.Name="Открыть комментарий в источнике">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="MessageCircle"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,2,0" />
                    <iconPacks:PackIconLucide Kind="ExternalLink"
                                      Width="10"
                                      Height="10"
                                      VerticalAlignment="Top" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
