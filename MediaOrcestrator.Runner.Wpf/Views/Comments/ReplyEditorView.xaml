<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Comments.ReplyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Comments"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ReplyEditorViewModel}">

    <Border Margin="{Binding IndentMargin}"
            Background="{DynamicResource Bg.SurfaceAlt}"
            BorderBrush="{DynamicResource Accent.Soft}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.M}"
            Padding="12,10">
        <StackPanel>
            <Grid Margin="{DynamicResource Margin.StackItem}"
                  Visibility="{Binding HasAuthors, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="От имени:"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlock.Subtle}"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Authors}"
                          SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}"
                          MinHeight="{DynamicResource Control.Height.Compact}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CommentAuthorOptionViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Avatar Size="22"
                                                 InitialFontSize="11"
                                                 Initial="{Binding Initial}"
                                                 ImageSource="{Binding AvatarSource}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2"
                           Text="загрузка…"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="{Binding IsAuthorsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="72"
                     MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource State.Error}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        Padding="12,4"
                        MinHeight="{DynamicResource Control.Height.Compact}"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding SubmitCommand}"
                        Padding="12,4"
                        MinHeight="{DynamicResource Control.Height.Compact}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="Отправить" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSubmitting}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Отправка…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
