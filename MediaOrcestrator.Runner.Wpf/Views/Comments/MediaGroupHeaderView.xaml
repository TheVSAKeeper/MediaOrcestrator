<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Comments.MediaGroupHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Comments"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MediaGroupHeaderViewModel}">

    <Border Background="{DynamicResource Bg.SurfaceAlt}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="12,8"
            Margin="0,8,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="96"
                    Height="54"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Bg.SurfaceMute}"
                    CornerRadius="{DynamicResource Radius.S}"
                    ClipToBounds="True"
                    Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                <Image Source="{Binding ThumbnailSource}"
                       Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding MediaTitle}"
                           FontSize="{DynamicResource Comments.MediaTitleFontSize}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CommentsCountText}"
                           Style="{StaticResource TextBlock.Subtle}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding RefreshCommand}"
                    Padding="10,4"
                    MinHeight="{DynamicResource Control.Height.Compact}"
                    VerticalAlignment="Center"
                    ToolTip="Обновить комментарии этого медиа"
                    Visibility="{Binding HasSingleSource, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="RotateCw"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,4,0" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="Обновить" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Загрузка…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>

            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding SourceActions}"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasMultipleSources, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MediaGroupSourceActionViewModel}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,1">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenCommand}"
                                    Padding="8,3"
                                    MinHeight="24"
                                    Margin="0,0,4,0"
                                    Visibility="{Binding HasMediaExternalLink, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{Binding OpenLabel}"
                                    AutomationProperties.Name="{Binding OpenLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ExternalLink"
                                                      Width="12"
                                                      Height="12"
                                                      Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding SourceTitle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding RefreshCommand}"
                                    Padding="8,3"
                                    MinHeight="24"
                                    Visibility="{Binding CanFetch, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{Binding RefreshLabel}"
                                    AutomationProperties.Name="{Binding RefreshLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCw"
                                                      Width="12"
                                                      Height="12"
                                                      Margin="0,0,4,0">
                                        <iconPacks:PackIconLucide.Style>
                                            <Style TargetType="iconPacks:PackIconLucide">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRefreshing}"
                                                                 Value="True">
                                                        <Setter Property="Opacity"
                                                                Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconLucide.Style>
                                    </iconPacks:PackIconLucide>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="{Binding SourceTitle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRefreshing}"
                                                                 Value="True">
                                                        <Setter Property="Text"
                                                                Value="Загрузка…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
