<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Comments.BranchToggleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Comments"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BranchToggleViewModel}">

    <Border Margin="{Binding IndentMargin}"
            Padding="4,4">
        <Button Style="{StaticResource Button.Ghost}"
                Command="{Binding ToggleCommand}"
                Padding="10,4"
                MinHeight="26"
                HorizontalAlignment="Left"
                AutomationProperties.Name="{Binding Label}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Width="14"
                                  Height="14"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource Accent.Primary}">
                    <iconPacks:PackIconLucide.Style>
                        <Style TargetType="iconPacks:PackIconLucide">
                            <Setter Property="Kind"
                                    Value="ChevronDown" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}"
                                             Value="True">
                                    <Setter Property="Kind"
                                            Value="ChevronUp" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconLucide.Style>
                </iconPacks:PackIconLucide>
                <TextBlock Text="{Binding Label}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent.Primary}" />
            </StackPanel>
        </Button>
    </Border>
</UserControl>
