<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Comments.CommentActionsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Comments"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CommentItemViewModel}">

    <UserControl.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding"
                    Value="8,3" />
            <Setter Property="MinHeight"
                    Value="26" />
            <Setter Property="Margin"
                    Value="6,0,0,0" />
        </Style>

        <Style x:Key="ConditionalAction.Edit"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanEdit}"
                                   Value="True" />
                        <Condition Binding="{Binding HasMutations}"
                                   Value="True" />
                        <Condition Binding="{Binding IsDeleted}"
                                   Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility"
                            Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConditionalAction.Delete"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanDelete}"
                                   Value="True" />
                        <Condition Binding="{Binding HasMutations}"
                                   Value="True" />
                        <Condition Binding="{Binding IsDeleted}"
                                   Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility"
                            Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConditionalAction.Restore"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDeleted}"
                                   Value="True" />
                        <Condition Binding="{Binding HasMutations}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility"
                            Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource ActionButton}"
                Margin="0"
                Command="{Binding ToggleLikeCommand}"
                Visibility="{Binding HasLikes, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Поставить или снять лайк">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="Heart"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Center">
                    <iconPacks:PackIconLucide.Style>
                        <Style TargetType="iconPacks:PackIconLucide">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Fg.Secondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LikedByMe}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Accent.Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconLucide.Style>
                </iconPacks:PackIconLucide>
                <TextBlock Text="{Binding LikeCount}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Style="{StaticResource ActionButton}"
                Command="{Binding StartReplyCommand}"
                Visibility="{Binding HasMutations, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Ответить">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="Reply"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,6,0" />
                <TextBlock Text="Ответить"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Style="{StaticResource ConditionalAction.Edit}"
                Command="{Binding StartEditCommand}"
                ToolTip="Изменить">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="Pencil"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,6,0" />
                <TextBlock Text="Изменить"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Style="{StaticResource ConditionalAction.Delete}"
                Command="{Binding RequestDeleteCommand}"
                ToolTip="Удалить">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="X"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,6,0" />
                <TextBlock Text="Удалить"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Style="{StaticResource ConditionalAction.Restore}"
                Command="{Binding RestoreCommand}"
                ToolTip="Восстановить">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="Undo2"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,6,0" />
                <TextBlock Text="Восстановить"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
