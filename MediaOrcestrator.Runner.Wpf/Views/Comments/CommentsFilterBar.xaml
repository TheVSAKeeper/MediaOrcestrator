<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Comments.CommentsFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Comments"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CommentsViewModel}">

    <Border Style="{StaticResource Card.Inset}">
        <StackPanel>
            
            <Grid Margin="{DynamicResource Margin.StackItem.Dense}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              Style="{StaticResource ToggleButton.FiltersCollapse}"
                              IsChecked="{Binding IsFiltersExpanded, Mode=TwoWay}"
                              AutomationProperties.Name="Свернуть/развернуть фильтры комментариев"
                              ToolTip="Свернуть или развернуть панель фильтров">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Kind"
                                            Value="ChevronRight" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltersExpanded}"
                                                     Value="True">
                                            <Setter Property="Kind"
                                                    Value="ChevronDown" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                        <TextBlock Text="Фильтры"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="12,0,12,0">
                    <TextBlock Text="{Binding TotalCountText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource TextBlock.Subtle}" />
                    <TextBlock Text="{Binding TruncatedHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource State.Warning}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding TruncatedHint, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding OpenAppearanceCommand}"
                            Padding="10,4"
                            Height="{DynamicResource Control.Height.Default}"
                            ToolTip="Внешний вид: размеры шрифтов и префикс ответа">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Settings"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Внешний вид"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding FetchSelectedCommand}"
                            Margin="8,0,0,0"
                            Padding="14,4"
                            Height="{DynamicResource Control.Height.Default}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="RotateCw"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Загрузить"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BoolToVisibility}}">
                
                <Grid Margin="{DynamicResource Margin.StackItem}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource TextBox.Toolbar}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             keepshell:PlaceholderBehavior.Placeholder="Текст комментария или название медиа"
                             AutomationProperties.Name="Поиск по комментариям"
                             ToolTip="Поиск в тексте и заголовках медиа" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ResetFiltersCommand}"
                            Padding="10,4"
                            Height="{DynamicResource Control.Height.Default}"
                            Margin="8,0,0,0"
                            Content="Сбросить"
                            ToolTip="Сбросить фильтры" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="SourcesPopupButton"
                                  Grid.Column="0"
                                  Height="{DynamicResource Control.Height.Default}"
                                  HorizontalContentAlignment="Left"
                                  Padding="10,4">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource Bg.Surface}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.M}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter VerticalAlignment="Center" />
                                        <iconPacks:PackIconLucide Grid.Column="1"
                                                          Kind="ChevronDown"
                                                          Width="14"
                                                          Height="14"
                                                          Foreground="{DynamicResource Fg.Muted}"
                                                          VerticalAlignment="Center"
                                                          Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="BorderBrush"
                                                Value="{DynamicResource Border.Strong}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock Text="{Binding SelectedSourcesText}"
                                   TextTrimming="CharacterEllipsis" />
                    </ToggleButton>

                    <Popup PlacementTarget="{Binding ElementName=SourcesPopupButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=SourcesPopupButton, Mode=TwoWay}">
                        <Border Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="6"
                                MinWidth="240"
                                MaxHeight="320">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Sources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Title}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Padding="6,2"
                                                      Margin="2"
                                                      MinHeight="26" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ComboBox.Toolbar}"
                              Margin="8,0,0,0"
                              MinWidth="180"
                              ItemsSource="{Binding ReplyStatusOptions}"
                              SelectedItem="{Binding SelectedReplyStatus, Mode=TwoWay}"
                              ToolTip="Фильтр по статусу ответа автора" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="8,0,0,0">
                        <TextBlock Text="Лимит:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,0,6,0" />
                        <TextBox Style="{StaticResource TextBox.Toolbar}"
                                 Width="80"
                                 Text="{Binding Limit, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="От 100 до 10000" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
