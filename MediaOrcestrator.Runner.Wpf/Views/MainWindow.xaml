<Window x:Class="MediaOrcestrator.Runner.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
        xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views"
        xmlns:keepshell="https://schemas.keepshell.dev/wpf"
        xmlns:tarkov="https://schemas.keepshell.dev/wpf/tarkov"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="MediaOrcestrator"
        Icon="pack://application:,,,/icon.ico"
        Height="720"
        Width="1200"
        MinHeight="540"
        MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{DynamicResource Font.Sans}"
        FontSize="{DynamicResource Font.Size.M}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Tasks.TaskbarState}"
                         ProgressValue="{Binding Tasks.TaskbarValue}"
                         Description="MediaOrcestrator.Runner.Wpf" />
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding CloseTasksDrawerCommand}" />
        <KeyBinding Key="F5"
                    Command="{Binding CurrentPageRefresh.RefreshCommand}" />
    </Window.InputBindings>

    <keepshell:ShellLayout>
        <keepshell:ShellLayout.TitleBar>
            <views:TitleBarView />
        </keepshell:ShellLayout.TitleBar>
        <keepshell:ShellLayout.StatusBar>
            <views:StatusBarView />
        </keepshell:ShellLayout.StatusBar>
        <keepshell:ShellLayout.ContentOverlay>
            
            <Border VerticalAlignment="Bottom"
                    Height="420"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Effect="{DynamicResource Card.Shadow}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Visibility="{Binding IsTasksDrawerOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Лента задач"
                                           Style="{StaticResource TextBlock.Heading}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Tasks.Header}"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding Tasks.ShowDebugDumpCommand}"
                                    Padding="10,4"
                                    Margin="0,0,8,0"
                                    ToolTip="Показать все задачи текстом (отладка)"
                                    AutomationProperties.Name="Отладочный дамп задач">
                                <iconPacks:PackIconLucide Kind="Bug"
                                                  Width="16"
                                                  Height="16" />
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource Button.Ghost}"
                                    Content="Отменить все"
                                    Command="{Binding Tasks.CancelAllCommand}"
                                    Padding="10,4"
                                    Margin="0,0,8,0"
                                    ToolTip="Отменить все активные задачи"
                                    Visibility="{Binding Tasks.HasActive, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding CloseTasksDrawerCommand}"
                                    Padding="10,4"
                                    ToolTip="Закрыть (Esc)"
                                    AutomationProperties.Name="Закрыть ленту задач">
                                <iconPacks:PackIconLucide Kind="X"
                                                  Width="16"
                                                  Height="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <views:TasksView Grid.Row="1"
                                     DataContext="{Binding Tasks}"
                                     Compact="True"
                                     Focusable="False"
                                     Margin="20,16,20,16" />
                </Grid>
            </Border>
        </keepshell:ShellLayout.ContentOverlay>
        <keepshell:ShellLayout.WindowOverlay>
            
            <tarkov:TarkovBootOverlay IsActive="{Binding IsTarkovBootPlaying, Mode=TwoWay}" />
        </keepshell:ShellLayout.WindowOverlay>
    </keepshell:ShellLayout>
</Window>
