<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.DatabaseCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DatabaseCleanupViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="900">

    <StackPanel>
        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                   TextWrapping="Wrap"
                   MaxWidth="780"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12"
                   Text="Управление файлами бэкапов и удаление данных из LiteDB. Все действия ниже необратимы или восстанавливаются только из бэкапа." />

        <Border Style="{StaticResource Card.Inset}"
                Margin="0,0,0,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <keepshell:ProgressStatusBlock StatusText="{Binding StatusText}"
                                          CancelCommand="{Binding CancelCommand}"
                                          Maximum="{Binding ProgressMax}"
                                          Value="{Binding ProgressValue, Mode=OneWay}" />
        </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="База данных"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DatabasePath}"
                                       Style="{StaticResource TextBlock.Mono}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,4" />
                            <TextBlock Style="{StaticResource TextBlock.Subtle}">
                                <Run Text="Размер файла:" />
                                <Run Text="{Binding DatabaseSizeText, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Fg.Primary}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenWinFormsImportCommand}"
                                    Padding="{DynamicResource Padding.Control}"
                                    MinHeight="{DynamicResource Control.Height.Compact}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="FolderInput" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Импорт из WinForms…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding RefreshCommand}"
                                    Padding="{DynamicResource Padding.Control}"
                                    MinHeight="{DynamicResource Control.Height.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Обновить" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:DatabaseBackupsCard />

                <Border Background="{DynamicResource State.ErrorSoft}"
                        BorderBrush="{DynamicResource State.Error}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.L}"
                        Padding="20"
                        Margin="0,0,0,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="TriangleAlert"
                                                      Width="20"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Foreground="{DynamicResource State.Error}" />

                            <TextBlock Grid.Column="1"
                                       Text="Удаление записей из БД"
                                       FontFamily="{DynamicResource Font.Sans}"
                                       FontSize="{DynamicResource Font.Size.L}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource State.Error}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       VerticalAlignment="Center">
                                <Run Text="Выбрано:" />
                                <Run Text="{Binding DangerSelectedCount, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Fg.Primary}" />
                            </TextBlock>
                        </Grid>

                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource Fg.Primary}">
                            <Run Text="Операции в этом блоке необратимы." FontWeight="SemiBold" />
                            <Run Text=" Восстановить данные можно будет только из бэкапа БД. Перед удалением будет создан ручной бэкап, но настройки источников и кэш комментариев придётся собирать заново." />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding SelectAllDangerCommand}"
                                    Content="Выбрать всё"
                                    Padding="12,4"
                                    MinHeight="{DynamicResource Control.Height.Compact}" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding SelectNoneDangerCommand}"
                                    Content="Снять выбор"
                                    Padding="12,4"
                                    MinHeight="{DynamicResource Control.Height.Compact}"
                                    Margin="8,0,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DangerItems}"
                                      Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MaintenanceItemViewModel}">
                                    <Border Background="{DynamicResource Bg.Surface}"
                                            BorderBrush="{DynamicResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.M}"
                                            Padding="14,12"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DangerCheck" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DangerSize" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Default}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource TextBlock.Subtle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SizeText, FallbackValue='…', TargetNullValue='…'}"
                                                           VerticalAlignment="Center"
                                                           Margin="14,0,0,0"
                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="{DynamicResource Font.Size.S}" />
                                            </Grid>

                                            <Grid Margin="32,6,0,0"
                                                  MinHeight="18">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                                    <controls:SpinningLoader Width="14"
                                                                             Height="14"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,6,0" />
                                                    <TextBlock Text="Удаление…"
                                                               Style="{StaticResource TextBlock.Subtle}"
                                                               FontStyle="Italic"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ResultText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Subtle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:MaintenanceItemState.Success}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:MaintenanceItemState.Error}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Error}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="Двойное подтверждение в диалоге. Операция необратима." />

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Destructive}"
                                    Command="{Binding RunDangerCommand}"
                                    Padding="18,8"
                                    MinHeight="{DynamicResource Control.Height.Default}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Trash2"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Удалить из БД" />
                                        <Run Text="(" /><Run Text="{Binding DangerSelectedCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
</UserControl>
