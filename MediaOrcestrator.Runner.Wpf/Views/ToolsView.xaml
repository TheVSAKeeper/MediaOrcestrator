<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ToolsViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="900"
             Loaded="OnLoaded">
    <UserControl.Resources>

        <Style x:Key="ToolStatePill"
               TargetType="Border">
            <Setter Property="CornerRadius"
                    Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding"
                    Value="8,2" />
            <Setter Property="Background"
                    Value="{DynamicResource Bg.SurfaceMute}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="UpToDate">
                    <Setter Property="Background"
                            Value="{DynamicResource State.SuccessSoft}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="UpdateAvailable">
                    <Setter Property="Background"
                            Value="{DynamicResource State.WarningSoft}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="NotInstalled">
                    <Setter Property="Background"
                            Value="{DynamicResource State.ErrorSoft}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Внешние инструменты"
                           FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Text="ffmpeg, yt-dlp, deno – версии и обновления подтягиваются из релизов на GitHub." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CheckUpdatesCommand}"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="RotateCcw"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                        <TextBlock Text="Проверить обновления"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Primary}"
                        Margin="8,0,0,0"
                        Content="Обновить всё"
                        Command="{Binding UpdateAllCommand}"
                        IsEnabled="{Binding CanUpdateAll}" />
            </StackPanel>
        </Grid>

        <keepshell:EmptyState Grid.Row="1"
                              Icon="Wrench"
                              Heading="Инструменты не заявлены"
                              Description="Ни один плагин не запросил ffmpeg, yt-dlp или deno. Если это неожиданно – плагины могли не загрузиться, смотрите «Диагностику».">
            <keepshell:EmptyState.Style>
                <Style TargetType="keepshell:EmptyState">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count}"
                                     Value="0">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </keepshell:EmptyState.Style>
        </keepshell:EmptyState>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}"
                          Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolItemViewModel}">
                        <Border Style="{StaticResource Card.Inset}"
                                Padding="{DynamicResource Padding.Control.Large}"
                                Margin="{DynamicResource Margin.StackItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"
                                                          SharedSizeGroup="ToolName" />
                                        <ColumnDefinition Width="Auto"
                                                          SharedSizeGroup="ToolPill" />
                                        <ColumnDefinition Width="Auto"
                                                          SharedSizeGroup="ToolVersion" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"
                                                          SharedSizeGroup="ToolAction" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="1"
                                            Style="{StaticResource ToolStatePill}"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="{DynamicResource Font.Size.S}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding VersionSummary}"
                                               Style="{StaticResource TextBlock.Mono}"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />

                                    <Button Grid.Column="4"
                                            Content="{Binding ActionText}"
                                            Padding="12,4"
                                            MinHeight="30"
                                            MinWidth="120"
                                            Margin="14,0,0,0"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Command="{Binding DataContext.UpdateToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource Button.Primary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,6,0,0"
                                      MinHeight="24">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ResolvedPath, FallbackValue='Файл не найден', TargetNullValue='Файл не найден'}"
                                                   Style="{StaticResource TextBlock.Mono}"
                                                   Foreground="{DynamicResource Fg.Muted}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ResolvedPath}" />

                                        <Button Grid.Column="1"
                                                Style="{StaticResource Button.Ghost}"
                                                Padding="6,2"
                                                MinHeight="24"
                                                Margin="8,0,0,0"
                                                ToolTip="Скопировать путь"
                                                AutomationProperties.Name="Скопировать путь"
                                                Command="{Binding CopyPathCommand}">
                                            <iconPacks:PackIconLucide Kind="Clipboard"
                                                              Width="14"
                                                              Height="14" />
                                        </Button>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource Button.Ghost}"
                                                Padding="6,2"
                                                MinHeight="24"
                                                Margin="4,0,0,0"
                                                ToolTip="Открыть в проводнике"
                                                AutomationProperties.Name="Открыть в проводнике"
                                                Command="{Binding OpenFolderCommand}">
                                            <iconPacks:PackIconLucide Kind="FolderOpen"
                                                              Width="14"
                                                              Height="14" />
                                        </Button>
                                    </Grid>

                                    <ProgressBar Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Height="6"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="RotateCw"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="{DynamicResource Fg.Muted}"
                                                          Margin="0,0,6,0" />
                                        <TextBlock Text="Проверка…"
                                                   Style="{StaticResource TextBlock.Subtle}"
                                                   FontStyle="Italic"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Padding="{DynamicResource Padding.Control}"
                Background="{DynamicResource Bg.SurfaceAlt}"
                CornerRadius="{DynamicResource Radius.M}">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource TextBlock.Subtle}" />
        </Border>
    </Grid>
</UserControl>
