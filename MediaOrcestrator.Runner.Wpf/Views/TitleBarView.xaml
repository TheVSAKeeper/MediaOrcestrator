<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:bs="clr-namespace:MediaOrcestrator.Runner.Wpf.Bootstrap"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="36"
             d:DesignWidth="1200">
    
    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            keepshell:TitleBarBehavior.IsWindowChrome="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="14,0">
                <Image Source="pack://application:,,,/icon.ico"
                       Width="18"
                       Height="18"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="MediaOrcestrator"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Style="{StaticResource TextBlock.Subtle}">
                    <Run Text="Runner.Wpf · v" /><Run Text="{Binding AppVersion, Mode=OneTime}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <Border Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent.Primary}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        Padding="2,2,2,2"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Visibility="{Binding AppUpdate.HasPendingUpdate, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Theme.SegmentButton}"
                                Command="{Binding AppUpdate.ShowDetailsCommand}"
                                Padding="10,2"
                                MinHeight="22"
                                ToolTip="Открыть окно установки обновления"
                                AutomationProperties.Name="Доступно обновление приложения">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Sparkles"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource Accent.Primary}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                                <TextBlock Text="{Binding AppUpdate.VersionLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg.Primary}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Theme.SegmentButton}"
                                Command="{Binding AppUpdate.DismissCommand}"
                                Width="22"
                                MinHeight="22"
                                Padding="0"
                                ToolTip="Скрыть для этой версии"
                                AutomationProperties.Name="Скрыть уведомление об обновлении">
                            <iconPacks:PackIconLucide Kind="X"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource Fg.Secondary}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource Theme.SegmentButton}"
                        Command="{Binding CurrentPageRefresh.RefreshCommand}"
                        Width="36"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="{Binding CurrentPageRefresh.RefreshTooltip, FallbackValue=Перезагрузить страницу, TargetNullValue=Перезагрузить страницу}"
                        AutomationProperties.Name="Перезагрузить страницу"
                        Visibility="{Binding CurrentPageRefresh, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <iconPacks:PackIconLucide Kind="RotateCcw"
                                      Width="16"
                                      Height="16" />
                </Button>
                <Border Width="1"
                        Background="{DynamicResource Border.Subtle}"
                        Margin="0,8,8,8"
                        Visibility="{Binding CurrentPageRefresh, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource Theme.SegmentButton}"
                            Command="{Binding Theme.ApplyCommand}"
                            CommandParameter="{x:Static bs:AppTheme.System}"
                            Tag="{Binding Theme.IsSystem}"
                            Width="36"
                            ToolTip="Системная тема (как в Windows)"
                            AutomationProperties.Name="Системная тема">
                        <iconPacks:PackIconLucide Kind="Monitor"
                                          Width="16"
                                          Height="16" />
                    </Button>
                    <Button Style="{StaticResource Theme.SegmentButton}"
                            Command="{Binding Theme.ApplyCommand}"
                            CommandParameter="{x:Static bs:AppTheme.Light}"
                            Tag="{Binding Theme.IsLight}"
                            Width="36"
                            Margin="2,0,0,0"
                            ToolTip="Светлая тема"
                            AutomationProperties.Name="Светлая тема">
                        <iconPacks:PackIconLucide Kind="Sun"
                                          Width="16"
                                          Height="16" />
                    </Button>
                    <Button Style="{StaticResource Theme.SegmentButton}"
                            Command="{Binding Theme.ApplyCommand}"
                            CommandParameter="{x:Static bs:AppTheme.Dark}"
                            Tag="{Binding Theme.IsDark}"
                            Width="36"
                            Margin="2,0,0,0"
                            ToolTip="Тёмная тема"
                            AutomationProperties.Name="Тёмная тема">
                        <iconPacks:PackIconLucide Kind="Moon"
                                          Width="16"
                                          Height="16" />
                    </Button>
                    <Button Style="{StaticResource Theme.SegmentButton}"
                            Command="{Binding Theme.ApplyCommand}"
                            CommandParameter="{x:Static bs:AppTheme.Tarkov}"
                            Tag="{Binding Theme.IsTarkov}"
                            Width="36"
                            Margin="2,0,0,0"
                            ToolTip="Tarkov-тема"
                            AutomationProperties.Name="Tarkov-тема">
                        <iconPacks:PackIconLucide Kind="Target"
                                          Width="16"
                                          Height="16" />
                    </Button>
                </StackPanel>
                <Border Width="1"
                        Background="{DynamicResource Border.Subtle}"
                        Margin="0,8" />
                <Button Style="{StaticResource Chrome.Button}"
                        keepshell:ChromeAction.Action="Minimize"
                        ToolTip="Свернуть"
                        AutomationProperties.Name="Свернуть окно">
                    <Path Data="M 0,5 L 10,5"
                          Style="{StaticResource Chrome.Glyph}" />
                </Button>
                <Button Style="{StaticResource Chrome.Button}"
                        keepshell:ChromeAction.Action="MaxRestore"
                        ToolTip="Развернуть"
                        AutomationProperties.Name="Развернуть или восстановить окно">
                    <Path Style="{StaticResource Chrome.Glyph.MaxRestore}" />
                </Button>
                <Button Style="{StaticResource Chrome.Button.Close}"
                        keepshell:ChromeAction.Action="Close"
                        ToolTip="Закрыть"
                        AutomationProperties.Name="Закрыть окно">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Style="{StaticResource Chrome.Glyph}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
