<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.AddSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AddSourceViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Width="{DynamicResource Dialog.Width.Large}"
             MinHeight="520"
             KeyboardNavigation.TabNavigation="Cycle"
             FocusManager.FocusedElement="{Binding ElementName=FilterBox}">

    <UserControl.Resources>
        <DataTemplate x:Key="PluginIcon.YouTube">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24"
                        Height="24">
                    <Path Fill="#FF0000"
                          Data="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z" />
                    <Path Fill="#FFFFFF"
                          Data="M9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="PluginIcon.Rutube">
            <Viewbox Stretch="Uniform">
                <Grid Width="48"
                      Height="48">
                    <Border CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#1C2C5A"
                                              Offset="0" />
                                <GradientStop Color="#0E1838"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="R"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-1,0,0" />
                    <Ellipse Fill="#FF2A4D"
                             Width="9"
                             Height="9"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,8,8,0" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="PluginIcon.VkVideo">
            <Viewbox Stretch="Uniform">
                <Canvas Width="48"
                        Height="48">
                    <Rectangle Canvas.Left="5"
                               Canvas.Top="6"
                               Width="29"
                               Height="29"
                               RadiusX="8"
                               RadiusY="8"
                               Fill="#0077FF" />
                    <Rectangle Canvas.Left="14"
                               Canvas.Top="13"
                               Width="29"
                               Height="29"
                               RadiusX="8"
                               RadiusY="8"
                               Fill="#FF3347" />
                    <Path Fill="White"
                          Data="M25,22 L25,34 L36.5,28 Z" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="PluginIcon.Telegram">
            <Viewbox Stretch="Uniform">
                <Grid Width="48"
                      Height="48">
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0.5,0"
                                                 EndPoint="0.5,1">
                                <GradientStop Color="#2AABEE"
                                              Offset="0" />
                                <GradientStop Color="#229ED9"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="11,12,11,12"
                             Stretch="Uniform">
                        <Path Fill="White"
                              Data="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.27 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z" />
                    </Viewbox>
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="PluginIcon.HardDiskDrive">
            <Viewbox Stretch="Uniform">
                <Canvas Width="48"
                        Height="48">
                    <Rectangle Canvas.Left="6"
                               Canvas.Top="6"
                               Width="36"
                               Height="36"
                               RadiusX="6"
                               RadiusY="6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#7C8AA0"
                                              Offset="0" />
                                <GradientStop Color="#46566C"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse Canvas.Left="9"
                             Canvas.Top="12"
                             Width="26"
                             Height="26"
                             Fill="#E6ECF3" />
                    <Ellipse Canvas.Left="14"
                             Canvas.Top="17"
                             Width="16"
                             Height="16"
                             Stroke="#C6D0DC"
                             StrokeThickness="1.2" />
                    <Ellipse Canvas.Left="19"
                             Canvas.Top="22"
                             Width="6"
                             Height="6"
                             Fill="#52627A" />
                    <Path Fill="#2E3A4C"
                          Data="M37.22,9.22 L38.78,10.78 L24.78,24.78 L23.22,23.22 Z" />
                    <Ellipse Canvas.Left="35"
                             Canvas.Top="7"
                             Width="6"
                             Height="6"
                             Fill="#2E3A4C" />
                    <Ellipse Canvas.Left="21.5"
                             Canvas.Top="21.5"
                             Width="5"
                             Height="5"
                             Fill="#3A475C" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="PluginIcon.Plugin">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24"
                        Height="24">
                    <Path
                        Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#6366F1"
                                              Offset="0" />
                                <GradientStop Color="#8B5CF6"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="PluginIconPresenter"
               TargetType="ContentControl">
            <Setter Property="Width"
                    Value="30" />
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="ContentTemplate"
                    Value="{StaticResource PluginIcon.Plugin}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourcePluginIconKind.YouTube}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource PluginIcon.YouTube}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourcePluginIconKind.Rutube}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource PluginIcon.Rutube}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourcePluginIconKind.VkVideo}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource PluginIcon.VkVideo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourcePluginIconKind.Telegram}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource PluginIcon.Telegram}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourcePluginIconKind.HardDiskDrive}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource PluginIcon.HardDiskDrive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DirectionIcon.Download">
            <Path Width="14"
                  Height="14"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Fg.Secondary}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Data="M8,2 L8,12 M4,8 L8,12 L12,8 M3,14 L13,14" />
        </DataTemplate>

        <DataTemplate x:Key="DirectionIcon.Upload">
            <Path Width="14"
                  Height="14"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Fg.Secondary}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Data="M8,14 L8,4 M4,8 L8,4 L12,8 M3,14 L13,14" />
        </DataTemplate>

        <DataTemplate x:Key="DirectionIcon.Bidirectional">
            <Path Width="14"
                  Height="14"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Fg.Secondary}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Data="M5,2 L2,5 L5,8 M2,5 L14,5 M11,8 L14,11 L11,14 M2,11 L14,11" />
        </DataTemplate>

        <DataTemplate x:Key="DirectionIcon.Unknown">
            <Ellipse Width="6"
                     Height="6"
                     Fill="{DynamicResource Fg.Secondary}" />
        </DataTemplate>

        <Style x:Key="DirectionIconPresenter"
               TargetType="ContentControl">
            <Setter Property="Width"
                    Value="18" />
            <Setter Property="Height"
                    Value="18" />
            <Setter Property="ContentTemplate"
                    Value="{StaticResource DirectionIcon.Unknown}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourceDirectionIconKind.Download}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource DirectionIcon.Download}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourceDirectionIconKind.Upload}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource DirectionIcon.Upload}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static vm:SourceDirectionIconKind.Bidirectional}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource DirectionIcon.Bidirectional}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PluginCardItem"
               TargetType="ListBoxItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="{DynamicResource Margin.StackItem}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.L}"
                                Padding="14,12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Border.Strong}" />
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Bd"
                                        Property="Padding"
                                        Value="13,11" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Bg.SurfaceMute}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding"
                    Value="8,2" />
            <Setter Property="Margin"
                    Value="0,0,6,0" />
        </Style>

        <DataTemplate DataType="{x:Type vm:PluginPickViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent.Primary}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <ContentControl Content="{Binding IconKind}"
                                    Style="{StaticResource PluginIconPresenter}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                </Border>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource Font.Size.L}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TypeId}"
                                   Style="{StaticResource TextBlock.Mono}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding CategoryLabel}"
                               Style="{StaticResource TextBlock.Subtle}"
                               Margin="0,2,0,0" />

                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource TextBlock.Subtle}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{Binding DirectionIconKind}"
                                                Style="{StaticResource DirectionIconPresenter}"
                                                Margin="0,0,4,0"
                                                IsHitTestVisible="False" />
                                <TextBlock Text="{Binding DirectionLabel}"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}"
                                Visibility="{Binding RequiresAuth, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Key"
                                                          Width="14"
                                                          Height="14"
                                                          Foreground="{DynamicResource Fg.Secondary}"
                                                          Margin="0,0,4,0" />
                                <TextBlock Text="Авторизация"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">
            <Border Background="{DynamicResource Accent.Soft}"
                    BorderBrush="{DynamicResource Accent.Primary}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1"
                               Foreground="{DynamicResource Accent.Primary}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Тип источника"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <iconPacks:PackIconLucide Kind="ChevronRight"
                                      Width="16"
                                      Height="16"
                                      Foreground="{DynamicResource Fg.Muted}"
                                      VerticalAlignment="Center"
                                      Margin="8,0" />
            <Border Background="{DynamicResource Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="2"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Настройки"
                               Foreground="{DynamicResource Fg.Muted}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource TextBlock.Subtle}"
                   TextWrapping="Wrap"
                   MaxWidth="720"
                   HorizontalAlignment="Left"
                   Text="Источник – это аккаунт на площадке или папка на диске, откуда медиа едут в матрицу и куда могут публиковаться. Выберите тип источника, на следующем шаге настроите параметры." />

        <Grid Grid.Row="2"
              Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="FilterBox"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="34,8,32,8"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Поиск по типам источников" />
                <iconPacks:PackIconLucide Kind="Search"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource Fg.Muted}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="12,0,0,0"
                                          IsHitTestVisible="False" />
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding ClearFilterCommand}"
                        Padding="4"
                        MinHeight="0"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="Очистить поиск"
                        AutomationProperties.Name="Очистить поиск">
                    <iconPacks:PackIconLucide Kind="X"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource Fg.Muted}" />
                    <Button.Visibility>
                        <Binding Path="Filter"
                                 Converter="{StaticResource NullToVisibility}" />
                    </Button.Visibility>
                </Button>
            </Grid>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0">
                <Run Text="{Binding VisibleCount, Mode=OneWay}" />
                <Run Text="из" />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.L}"
                    Margin="0,0,8,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <ListBox ItemsSource="{Binding PluginsView}"
                                 SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PluginCardItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                 Visibility="{Binding HasPlugins, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="320"
                                Visibility="{Binding ShowEmptyFilterState, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="Search"
                                                  Width="42"
                                                  Height="42"
                                                  Foreground="{DynamicResource Fg.Muted}"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,8"
                                   Text="Нет источников, подходящих под поиск. Попробуйте другой запрос или очистите поле." />
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding ClearFilterCommand}"
                                Content="Очистить поиск"
                                Padding="12,4"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360"
                                Visibility="{Binding HasPlugins, Converter={StaticResource InverseBoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="Unplug"
                                                  Width="48"
                                                  Height="48"
                                                  Foreground="{DynamicResource Fg.Muted}"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBlock.Heading}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"
                                   Text="Плагины не загружены" />
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Положите DLL плагина в папку плагинов и перезапустите приложение. Без плагинов нельзя добавить ни одного источника." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.L}"
                    Margin="8,0,0,0"
                    Padding="18">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding DetailsCard, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding DetailsCard}">
                            <Border Width="72"
                                    Height="72"
                                    Background="{DynamicResource Accent.Soft}"
                                    BorderBrush="{DynamicResource Accent.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.L}"
                                    HorizontalAlignment="Left">
                                <ContentControl Content="{Binding IconKind}"
                                                Style="{StaticResource PluginIconPresenter}"
                                                Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False" />
                            </Border>

                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding CategoryLabel, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding TypeId, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />

                            <Border Style="{StaticResource Card.Inset}"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <ContentControl Content="{Binding DirectionIconKind}"
                                                        Style="{StaticResource DirectionIconPresenter}"
                                                        Width="22"
                                                        Margin="0,0,4,0"
                                                        IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding DirectionLabel}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <iconPacks:PackIconLucide Kind="Key"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding AuthLabel}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Settings"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding FieldsSummary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,14,0,0"
                                       TextWrapping="Wrap"
                                       Text="После «Далее» откроется окно настроек: имя источника и параметры площадки. Имя можно изменить в любой момент." />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="260"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="Diamond"
                                                  Width="42"
                                                  Height="42"
                                                  Foreground="{DynamicResource Fg.Muted}"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Выберите площадку слева, чтобы увидеть детали: направление передачи, требуется ли вход и количество настроек." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Run Text="Выбрано:" />
                <Run Text="{Binding SelectedPlugin.DisplayName, Mode=OneWay}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Fg.Primary}" />
            </TextBlock>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding ContinueCommand}"
                        Padding="18,6"
                        MinHeight="34"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Далее"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <iconPacks:PackIconLucide Kind="ArrowRight"
                                                  Width="14"
                                                  Height="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
