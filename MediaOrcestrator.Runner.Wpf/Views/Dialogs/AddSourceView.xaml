<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.AddSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AddSourceViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="840"
             Width="840"
             MaxWidth="{DynamicResource Dialog.Width.Large}"
             MinHeight="500"
             KeyboardNavigation.TabNavigation="Cycle"
             FocusManager.FocusedElement="{Binding ElementName=FilterBox}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MediaOrcestrator.Runner.Wpf;component/Views/Dialogs/AddSourceResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">
            <Border Background="{DynamicResource Accent.Soft}"
                    BorderBrush="{DynamicResource Accent.Primary}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1"
                               Foreground="{DynamicResource Accent.Primary}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Тип источника"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <iconPacks:PackIconLucide Kind="ChevronRight"
                                      Width="16"
                                      Height="16"
                                      Foreground="{DynamicResource Fg.Muted}"
                                      VerticalAlignment="Center"
                                      Margin="8,0" />
            <Border Background="{DynamicResource Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="2"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Настройки"
                               Foreground="{DynamicResource Fg.Muted}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource TextBlock.Subtle}"
                   TextWrapping="Wrap"
                   MaxWidth="720"
                   HorizontalAlignment="Left"
                   Text="Источник – это аккаунт на площадке или папка на диске, откуда медиа едут в матрицу и куда могут публиковаться. Выберите тип источника, на следующем шаге настроите параметры." />

        <Grid Grid.Row="2"
              Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="FilterBox"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="34,8,32,8"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Поиск по типам источников" />
                <iconPacks:PackIconLucide Kind="Search"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource Fg.Muted}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="12,0,0,0"
                                          IsHitTestVisible="False" />
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding ClearFilterCommand}"
                        Padding="4"
                        MinHeight="0"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="Очистить поиск"
                        AutomationProperties.Name="Очистить поиск">
                    <iconPacks:PackIconLucide Kind="X"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource Fg.Muted}" />
                    <Button.Visibility>
                        <Binding Path="Filter"
                                 Converter="{StaticResource NullToVisibility}" />
                    </Button.Visibility>
                </Button>
            </Grid>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0">
                <Run Text="{Binding VisibleCount, Mode=OneWay}" />
                <Run Text="из" />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.L}"
                    Margin="0,0,8,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <ListBox ItemsSource="{Binding PluginsView}"
                                 SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PluginCardItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                 Visibility="{Binding HasPlugins, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="320"
                                Visibility="{Binding ShowEmptyFilterState, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="Search"
                                                  Width="42"
                                                  Height="42"
                                                  Foreground="{DynamicResource Fg.Muted}"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,8"
                                   Text="Нет источников, подходящих под поиск. Попробуйте другой запрос или очистите поле." />
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding ClearFilterCommand}"
                                Content="Очистить поиск"
                                Padding="12,4"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360"
                                Visibility="{Binding HasPlugins, Converter={StaticResource InverseBoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="Unplug"
                                                  Width="48"
                                                  Height="48"
                                                  Foreground="{DynamicResource Fg.Muted}"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBlock.Heading}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"
                                   Text="Плагины не загружены" />
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Положите DLL плагина в папку плагинов и перезапустите приложение. Без плагинов нельзя добавить ни одного источника." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.L}"
                    Margin="8,0,0,0"
                    Padding="18">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding DetailsCard, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding DetailsCard}">
                            <Border Width="72"
                                    Height="72"
                                    Background="{DynamicResource Accent.Soft}"
                                    BorderBrush="{DynamicResource Accent.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.L}"
                                    HorizontalAlignment="Left">
                                <ContentControl Content="{Binding IconKind}"
                                                Style="{StaticResource PluginIconPresenter}"
                                                Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False" />
                            </Border>

                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding CategoryLabel, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding TypeId, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />

                            <Border Style="{StaticResource Card.Inset}"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <ContentControl Content="{Binding DirectionIconKind}"
                                                        Style="{StaticResource DirectionIconPresenter}"
                                                        Width="22"
                                                        Margin="0,0,4,0"
                                                        IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding DirectionLabel}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <iconPacks:PackIconLucide Kind="Key"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding AuthLabel}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Settings"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding FieldsSummary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,14,0,0"
                                       TextWrapping="Wrap"
                                       Text="После «Далее» откроется окно настроек: имя источника и параметры площадки. Имя можно изменить в любой момент." />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="260"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="Diamond"
                                                  Width="42"
                                                  Height="42"
                                                  Foreground="{DynamicResource Fg.Muted}"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Выберите площадку слева, чтобы увидеть детали: направление передачи, требуется ли вход и количество настроек." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Run Text="Выбрано:" />
                <Run Text="{Binding SelectedPlugin.DisplayName, Mode=OneWay}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Fg.Primary}" />
            </TextBlock>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding ContinueCommand}"
                        Padding="18,6"
                        MinHeight="34"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Далее"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <iconPacks:PackIconLucide Kind="ArrowRight"
                                                  Width="14"
                                                  Height="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
