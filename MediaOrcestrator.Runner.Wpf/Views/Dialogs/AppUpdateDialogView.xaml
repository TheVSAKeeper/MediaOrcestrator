<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.AppUpdateDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AppUpdateDialogViewModel}"
             d:DesignHeight="560"
             d:DesignWidth="640"
             Width="{DynamicResource Dialog.Width.Medium}"
             MinHeight="420">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="Sparkles"
                              Width="22"
                              Height="22"
                              Foreground="{DynamicResource Accent.Primary}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />
            <TextBlock Text="Доступно обновление приложения"
                       Style="{StaticResource TextBlock.Heading}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Текущая версия"
                           Style="{StaticResource TextBlock.Subtle}" />
                <TextBlock Text="{Binding CurrentVersion, Mode=OneTime}"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0" />
            </StackPanel>

            <iconPacks:PackIconLucide Grid.Column="1"
                              Kind="ArrowRight"
                              Width="18"
                              Height="18"
                              Foreground="{DynamicResource Fg.Muted}"
                              VerticalAlignment="Center"
                              Margin="14,12,14,0" />

            <StackPanel Grid.Column="2">
                <TextBlock Text="Новая версия"
                           Style="{StaticResource TextBlock.Subtle}" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,2,0,0">
                    <TextBlock Text="{Binding NewVersion, Mode=OneTime}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SizeText, Mode=OneTime, StringFormat=' · {0}'}"
                               Style="{StaticResource TextBlock.Subtle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Что нового"
                   Style="{StaticResource TextBlock.Subtle}"
                   Margin="0,18,0,6"
                   Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="3"
                Style="{StaticResource Card.Inset}"
                Padding="14"
                MinHeight="140"
                Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding ReleaseNotes, Mode=OneTime}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource TextBlock.Subtle}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Text="Описание изменений не пришло из релиза. Откройте страницу релиза, чтобы посмотреть подробности."
                   Visibility="{Binding HasReleaseNotes, Converter={StaticResource InverseBoolToVisibility}}" />

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,0,0,6" />
            <ProgressBar Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}" />
        </StackPanel>

        <Border Grid.Row="5"
                Style="{StaticResource Card.Inset}"
                Padding="12,8"
                Margin="0,12,0,0"
                Background="{DynamicResource State.ErrorSoft}"
                BorderBrush="{DynamicResource State.Error}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="TriangleAlert"
                                  Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource State.Error}"
                                  VerticalAlignment="Top"
                                  Margin="0,2,8,0" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource State.Error}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <keepshell:StretchWrapPanel Grid.Row="6"
                                    Margin="0,18,0,0">
            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding OpenReleasePageCommand}"
                    Padding="{DynamicResource Padding.Control}"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    Margin="0,2,8,2"
                    HorizontalAlignment="Left"
                    ToolTip="Открыть страницу релиза на GitHub"
                    Visibility="{Binding ReleasePageUrl, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="ExternalLink"
                                              Width="14"
                                              Height="14"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Страница релиза"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <WrapPanel keepshell:StretchWrapPanel.Stretch="True"
                       keepshell:StretchWrapPanel.StretchWidth="220"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding SkipCommand}"
                        Content="Пропустить эту версию"
                        Padding="{DynamicResource Padding.Control}"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,2,8,2"
                        ToolTip="Не показывать баннер для этой версии"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding LaterCommand}"
                        Content="Позже"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,2,8,2"
                        IsCancel="True"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding InstallCommand}"
                        Padding="16,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,2,0,2"
                        IsDefault="True"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Download"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Установить"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Content="Отменить скачивание"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,2,0,2"
                        IsCancel="True"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </keepshell:StretchWrapPanel>
    </Grid>
</UserControl>
