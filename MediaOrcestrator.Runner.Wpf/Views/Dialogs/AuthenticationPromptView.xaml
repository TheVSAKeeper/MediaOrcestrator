<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.AuthenticationPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:KeepShell.Views.Behaviors;assembly=KeepShell"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             KeyboardNavigation.TabNavigation="Cycle">
    <StackPanel Width="{DynamicResource Dialog.Width.Small}" Margin="{DynamicResource Padding.Panel}">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=CancelButton}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowTextInput}" Value="True">
                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=CodeInput}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowPasswordInput}" Value="True">
                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=PasswordInput}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Style="{StaticResource TextBlock.Heading}" Text="{Binding Heading}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding AccountHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding AccountHint, Converter={StaticResource NullToVisibility}}" />
        <DockPanel Margin="0,8,0,8">
            <controls:SpinningLoader Width="14" Height="14" Margin="0,0,8,0"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PromptText}" TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource State.ErrorText}"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}" />
        <TextBox x:Name="CodeInput" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Prompt}"
                 Visibility="{Binding ShowTextInput, Converter={StaticResource BoolToVisibility}}" />
        <PasswordBox x:Name="PasswordInput" behaviors:PasswordBoxBindingBehavior.BoundPassword="{Binding Value, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding Prompt}"
                     Visibility="{Binding ShowPasswordInput, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Button.Ghost}"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}"
                    Content="{Binding ConfirmText}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="{Binding ConfirmOnEnter}"
                    Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
