<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.DocumentationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DocumentationDialogViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="780"
             Width="{DynamicResource Dialog.Width.Large}"
             MinHeight="520">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,4">
            <iconPacks:PackIconLucide Kind="BookOpen"
                              Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Foreground="{DynamicResource Accent.Primary}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TextBlock.Heading}" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,8,0,12"
              Visibility="{Binding HasMultipleDocs, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Раздел:"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Docs}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      MinHeight="32" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Background="{DynamicResource Bg.Surface}">
            <FlowDocumentScrollViewer x:Name="DocViewer"
                                      Padding="14,10,14,10"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" />
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding OpenError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource State.ErrorText}" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding OpenError, Converter={StaticResource NullToVisibility}}" />

        <Grid Grid.Row="4"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding OpenInDefaultAppCommand}"
                    Padding="{DynamicResource Padding.Control}"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    ToolTip="Открыть в стороннем редакторе markdown">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="ExternalLink"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0" />
                    <TextBlock Text="Открыть во внешнем редакторе"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding CloseCommand}"
                    Content="Закрыть"
                    Padding="18,6"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    IsCancel="True"
                    IsDefault="True" />
        </Grid>
    </Grid>
</UserControl>
