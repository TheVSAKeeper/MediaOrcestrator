<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.TasksDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TasksDebugViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="880"
             Width="{DynamicResource Dialog.Width.Large}"
             MinHeight="520"
             Loaded="OnLoaded"
             KeyboardNavigation.TabNavigation="Cycle">
    
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="Bug"
                              Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Foreground="{DynamicResource Accent.Primary}" />
            <TextBlock Text="Отладка: все задачи"
                       Style="{StaticResource TextBlock.Heading}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding Summary}"
                   Style="{StaticResource TextBlock.Subtle}"
                   Margin="0,6,0,12" />

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Background="{DynamicResource Bg.Surface}">
            <TextBox x:Name="DumpBox"
                     Text="{Binding Dump, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Background="Transparent"
                     Foreground="{DynamicResource Fg.Primary}"
                     CaretBrush="{DynamicResource Accent.Primary}"
                     SelectionBrush="{DynamicResource Accent.Soft}"
                     BorderThickness="0"
                     Padding="12,10"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource Font.Size.S}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Текстовый дамп задач" />
        </Border>

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding RefreshCommand}"
                    Padding="{DynamicResource Padding.Control}"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    ToolTip="Пересобрать снимок задач">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="RotateCw"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                    <TextBlock Text="Обновить"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Ghost}"
                    Click="OnCopyClick"
                    Padding="{DynamicResource Padding.Control}"
                    Margin="8,0,0,0"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    ToolTip="Скопировать дамп в буфер обмена">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Clipboard"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                    <TextBlock Text="Копировать"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding CloseCommand}"
                    Content="Закрыть"
                    Padding="18,6"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    IsCancel="True"
                    IsDefault="True" />
        </Grid>
    </Grid>
</UserControl>
