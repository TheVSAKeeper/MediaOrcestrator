<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.SourceSettingsHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourceSettingsViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="640"
             Width="{DynamicResource Dialog.Width.Medium}"
             MinHeight="500">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,14"
                    Visibility="{Binding AllowBack, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Тип источника"
                               Foreground="{DynamicResource Fg.Muted}" />
                </StackPanel>
            </Border>
            <iconPacks:PackIconLucide Kind="ChevronRight"
                              Width="16"
                              Height="16"
                              Foreground="{DynamicResource Fg.Muted}"
                              VerticalAlignment="Center"
                              Margin="8,0" />
            <Border Background="{DynamicResource Accent.Soft}"
                    BorderBrush="{DynamicResource Accent.Primary}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="2"
                               Foreground="{DynamicResource Accent.Primary}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Настройки"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TextBlock.Heading}" />
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource TextBlock.Subtle}">
                <Run Text="Тип источника:" />
                <Run Text="{Binding PluginDisplayName, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <views:SourceSettingsView Grid.Row="2" />

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding OpenDocsCommand}"
                    Visibility="{Binding HasDocs, Converter={StaticResource BoolToVisibility}}"
                    Padding="{DynamicResource Padding.Control}"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    ToolTip="Открыть руководство по плагину">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="BookOpen"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0" />
                    <TextBlock Text="Руководство"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding BackCommand}"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        ToolTip="Вернуться к выбору типа источника"
                        Visibility="{Binding AllowBack, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ArrowLeft"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                        <TextBlock Text="Назад"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        Content="{Binding SaveButtonText}"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
