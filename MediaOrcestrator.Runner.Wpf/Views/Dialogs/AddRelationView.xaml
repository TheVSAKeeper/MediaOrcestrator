<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.AddRelationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AddRelationViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="460"
             Width="{DynamicResource Dialog.Width.Small}"
             MinHeight="280">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Новая связь"
                   Style="{StaticResource TextBlock.Heading}" />

        <TextBlock Grid.Row="1"
                   Style="{StaticResource TextBlock.Subtle}"
                   Margin="0,4,0,16"
                   TextWrapping="Wrap"
                   Text="Связь задаёт направление, по которому медиа могут переноситься между источниками. Создать связь источника с самим собой нельзя." />

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,12">
            <TextBlock Text="Откуда"
                       FontWeight="SemiBold"
                       Margin="{DynamicResource Margin.StackItem.Dense}" />
            <ComboBox ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding From, Mode=TwoWay}"
                      DisplayMemberPath="TitleFull"
                      MinHeight="32" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Куда"
                       FontWeight="SemiBold"
                       Margin="{DynamicResource Margin.StackItem.Dense}" />
            <ComboBox ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding To, Mode=TwoWay}"
                      DisplayMemberPath="TitleFull"
                      MinHeight="32" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Foreground="{DynamicResource State.Error}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="Источники для «Откуда» и «Куда» должны различаться."
                   Visibility="{Binding IsSameSource, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"
                    Content="Отмена"
                    Margin="0,0,8,0"
                    Padding="14,6"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    IsCancel="True" />
            <Button Style="{StaticResource Button.Primary}"
                    Command="{Binding SaveCommand}"
                    Content="Создать связь"
                    Padding="14,6"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>
