<Window x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.CoverTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Dialogs"
        xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:CoverTemplateEditorViewModel}"
        Title="Редактор шаблона обложки"
        Icon="pack://application:,,,/MediaOrcestrator.Runner.Wpf;component/icon.ico"
        Width="980"
        Height="700"
        MinWidth="720"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{DynamicResource Font.Sans}"
        FontSize="{DynamicResource Font.Size.M}">
    <dialogs:CoverTemplateEditorView />
</Window>
