<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.WinFormsImportDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WinFormsImportDialogViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="760"
             Width="{DynamicResource Dialog.Width.Large}"
             MinHeight="460"
             MaxHeight="680"
             KeyboardNavigation.TabNavigation="Cycle">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="FolderInput"
                                      Width="22"
                                      Height="22"
                                      Foreground="{DynamicResource Accent.Primary}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
            <TextBlock Text="Перенос данных из WinForms"
                       Style="{StaticResource TextBlock.Heading}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,6,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Subtle}">
                    <Setter Property="Text" Value="Переносит базу, источники, сессии и шаблоны обложек из классического WinForms 0.0.5.9. Исходная папка остаётся нетронутой." />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFirstRunPrompt}" Value="True">
                            <Setter Property="Text" Value="База пока пуста – если раньше вы пользовались классическим WinForms (0.0.5.9), можно сразу забрать каналы, сессии и обложки." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <controls:WinFormsInspectionCard />

                <Border Style="{StaticResource Card.Inset}"
                        Padding="14"
                        Margin="0,12,0,0"
                        Visibility="{Binding ShowDestinationOptions, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel IsEnabled="{Binding CanEditInputs}">
                        <TextBlock Text="Куда перенести"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <RadioButton GroupName="WinFormsImportDestination"
                                     IsChecked="{Binding IsSeparateInstanceMode, Mode=TwoWay}"
                                     Content="Отдельный экземпляр WPF (в новую пустую папку)"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,6" />

                        <StackPanel Margin="22,0,0,10"
                                    Visibility="{Binding IsSeparateInstanceMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Папка нового экземпляра"
                                       Style="{StaticResource Form.Hint}"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding TargetFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Font.Size.S}"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Папка нового экземпляра WPF" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Base}"
                                        Command="{Binding BrowseTargetFolderCommand}"
                                        Margin="8,0,0,0"
                                        Padding="{DynamicResource Padding.Control}"
                                        MinHeight="{DynamicResource Control.Height.Default}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Folder"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,6,0"
                                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="Обзор…"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <CheckBox IsChecked="{Binding CreateShortcut, Mode=TwoWay}"
                                      Content="Создать ярлык на рабочем столе"
                                      Margin="0,8,0,4" />

                            <StackPanel Margin="22,0,0,6"
                                        IsEnabled="{Binding CreateShortcut}">
                                <TextBlock Text="Имя ярлыка"
                                           Style="{StaticResource Form.Hint}"
                                           Margin="0,0,0,2" />
                                <TextBox Text="{Binding ShortcutName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Имя ярлыка" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding LaunchAfterCreate, Mode=TwoWay}"
                                      Content="Запустить новый экземпляр сразу после создания"
                                      Margin="0,4,0,4" />
                        </StackPanel>

                        <RadioButton GroupName="WinFormsImportDestination"
                                     IsChecked="{Binding IsReplaceCurrentMode, Mode=TwoWay}"
                                     Content="Заменить данные текущего WPF"
                                     FontWeight="SemiBold"
                                     Margin="0,2,0,6" />

                        <Border Background="{DynamicResource State.WarningSoft}"
                                BorderBrush="{DynamicResource State.Warning}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="10,8"
                                Margin="22,0,0,8"
                                Visibility="{Binding IsReplaceCurrentMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="TriangleAlert"
                                                          Width="16"
                                                          Height="16"
                                                          Foreground="{DynamicResource State.Warning}"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,8,0" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="Текущая база, настройки, state/ и обложки сначала сохранятся в backups/pre-import_&lt;дата&gt;/, затем приложение перезапустится и применит снимок." />
                            </StackPanel>
                        </Border>

                        <CheckBox IsChecked="{Binding EnableAutoSync, Mode=TwoWay}"
                                  Content="Включить автосинхронизацию при старте"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource State.SuccessSoft}"
                        BorderBrush="{DynamicResource State.Success}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Padding="14"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,6">
                            <iconPacks:PackIconLucide Kind="CircleCheck"
                                                      Width="18"
                                                      Height="18"
                                                      Foreground="{DynamicResource State.Success}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                            <TextBlock Text="Отдельный экземпляр WPF готов"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CreatedTargetFolder}"
                                   Style="{StaticResource TextBlock.Mono}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasCreatedShortcut, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Ярлык:" />
                            <Run Text="{Binding CreatedShortcutPath, Mode=OneWay}"
                                 FontFamily="{DynamicResource Font.Mono}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Style="{StaticResource Card.Inset}"
                Margin="0,12,0,0"
                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
            <keepshell:ProgressStatusBlock StatusText="{Binding ProgressStatusText}"
                                          CancelCommand="{Binding CancelImportCommand}"
                                          Maximum="100"
                                          Value="{Binding ProgressPercent, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource Card.Inset}"
                Padding="12,8"
                Margin="0,12,0,0"
                Background="{DynamicResource State.ErrorSoft}"
                BorderBrush="{DynamicResource State.Error}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="TriangleAlert"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource State.Error}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,8,0" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource State.Error}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding DismissFirstRunCommand}"
                    Content="Настроить с нуля"
                    Padding="{DynamicResource Padding.Control}"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    Margin="0,0,12,0"
                    Visibility="{Binding IsFirstRunPrompt, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowDestinationOptions, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding StartImportCommand}"
                        Content="{Binding StartButtonText}"
                        Padding="16,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        IsDefault="True" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding OpenTargetFolderCommand}"
                        Padding="12,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="FolderOpen"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Открыть папку"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding LaunchCreatedInstanceCommand}"
                        Padding="12,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Play"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Запустить экземпляр"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding FinishCommand}"
                        Content="Готово"
                        Padding="18,6"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        IsDefault="True"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
