<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Dialogs.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ColorPickerViewModel}"
             d:DesignWidth="300"
             Loaded="OnLoaded"
             FocusManager.IsFocusScope="True">
    
    <UserControl.Resources>
        <Style x:Key="PickerChannelLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="MinWidth"
                    Value="20" />
        </Style>

        <Style x:Key="PickerChannelValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="MinWidth"
                    Value="28" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="Margin"
                    Value="6,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Width="300"
            Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.M}"
            Padding="{DynamicResource Padding.Panel}"
            Effect="{DynamicResource Card.Shadow}">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <Border Height="28"
                    CornerRadius="{DynamicResource Radius.S}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Background="{Binding PreviewBrush}"
                    Margin="0,0,0,6" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX"
                           Style="{StaticResource PickerChannelLabel}"
                           Margin="0,0,8,0" />
                <TextBox x:Name="HexBox"
                         Grid.Column="1"
                         Style="{StaticResource TextBox.Form}"
                         Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="ARGB hex, например FFFFFFFF (непрозрачный белый)."
                         AutomationProperties.Name="Цвет, ARGB hex" />
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="A"
                           Style="{StaticResource PickerChannelLabel}" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Alpha, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Прозрачность (альфа)" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource PickerChannelValue}"
                           Text="{Binding Alpha, StringFormat={}{0:0}}" />
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="R"
                           Style="{StaticResource PickerChannelLabel}" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Red, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Красный" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource PickerChannelValue}"
                           Text="{Binding Red, StringFormat={}{0:0}}" />
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="G"
                           Style="{StaticResource PickerChannelLabel}" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Green, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Зелёный" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource PickerChannelValue}"
                           Text="{Binding Green, StringFormat={}{0:0}}" />
            </Grid>

            <Grid Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="B"
                           Style="{StaticResource PickerChannelLabel}" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Blue, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Синий" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource PickerChannelValue}"
                           Text="{Binding Blue, StringFormat={}{0:0}}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Presets}"
                          Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Hex}"
                                Padding="2"
                                Margin="0,0,4,4"
                                ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}">
                            <Border Width="22"
                                    Height="22"
                                    CornerRadius="{DynamicResource Radius.S}"
                                    Background="{Binding Brush}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource Button.Secondary}"
                    Content="Готово"
                    Command="{Binding DoneCommand}"
                    HorizontalAlignment="Right"
                    Padding="14,6"
                    IsDefault="True" />
        </StackPanel>
    </Border>
</UserControl>
