<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.FilterChecklist"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="240">
    
    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.M}"
            Padding="6">
        <Grid>
            <ScrollViewer MaxHeight="{Binding MaxListHeight, ElementName=Root}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Title}"
                                      Margin="6,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding EmptyHint, ElementName=Root}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Margin="6"
                       MaxWidth="240"
                       Visibility="{Binding EmptyHintVisibility, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
