<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.DatabaseBackupsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DatabaseCleanupViewModel}">

    <UserControl.Resources>
        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.L}" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style x:Key="TriggerBadge"
               TargetType="Border"
               BasedOn="{StaticResource Badge}">
            <Setter Property="Padding"
                    Value="8,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />
            <Setter Property="Margin"
                    Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,12">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource SectionTitle}"
                           Text="Бэкапы БД" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding BackupsCount, Mode=OneWay}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Fg.Primary}" />
                    <Run Text="шт., общий объём" />
                    <Run Text="{Binding BackupsTotalSizeText, Mode=OneWay}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Fg.Primary}" />
                </TextBlock>
            </Grid>

            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Text="Автоматический бэкап создаётся при старте и далее каждые 6 часов. Перед удалением данных из БД делается дополнительный ручной бэкап." />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12">
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding CreateBackupNowCommand}"
                        Padding="14,6"
                        MinHeight="{DynamicResource Control.Height.Compact}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Save" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Создать бэкап сейчас" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding OpenBackupsFolderCommand}"
                        Padding="{DynamicResource Padding.Control}"
                        Margin="8,0,0,0"
                        MinHeight="{DynamicResource Control.Height.Compact}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Открыть папку backups/" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Background="{DynamicResource State.WarningSoft}"
                    BorderBrush="{DynamicResource State.Warning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="12,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding PendingRestoreFileName, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="TriangleAlert"
                                              Width="16"
                                              Height="16"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource State.Warning}" />

                    <TextBlock Grid.Column="1"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                        <Run Text="При следующем старте БД будет восстановлена из" />
                        <Run Text="{Binding PendingRestoreFileName, Mode=OneWay}"
                             FontWeight="SemiBold"
                             FontFamily="{DynamicResource Font.Mono}" />
                    </TextBlock>

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ClearPendingRestoreCommand}"
                            Padding="12,4"
                            MinHeight="{DynamicResource Control.Height.Compact}"
                            Margin="10,0,0,0"
                            Content="Отменить" />
                </Grid>
            </Border>

            <keepshell:EmptyState Icon="HardDriveDownload"
                                  Heading="Бэкапов пока нет"
                                  Description="Нажмите «Создать бэкап сейчас», чтобы записать первый.">
                <keepshell:EmptyState.Style>
                    <Style TargetType="keepshell:EmptyState">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackupsCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </keepshell:EmptyState.Style>
            </keepshell:EmptyState>

            <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BackupItemViewModel}">
                        <Border Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="14,10"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                                   Text="{Binding CreatedAtText}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding TriggerText}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       Foreground="{DynamicResource Fg.Secondary}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SizeText}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"
                                           MinWidth="80"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.S}" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource Button.Icon}"
                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="Восстановить из этого бэкапа"
                                        ToolTip="Подготовить восстановление БД из этого бэкапа">
                                    <iconPacks:PackIconLucide Kind="Undo2" Width="14" Height="14"
                                                              Foreground="{DynamicResource Accent.Primary}" />
                                </Button>

                                <Button Grid.Column="3"
                                        Style="{StaticResource Button.Icon}"
                                        Command="{Binding DataContext.ShowBackupInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Показать в проводнике"
                                        ToolTip="Показать файл в проводнике">
                                    <iconPacks:PackIconLucide Kind="ExternalLink" Width="14" Height="14" />
                                </Button>

                                <Button Grid.Column="4"
                                        Style="{StaticResource Button.Icon}"
                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Удалить бэкап"
                                        ToolTip="Удалить файл бэкапа">
                                    <iconPacks:PackIconLucide Kind="Trash2" Width="14" Height="14"
                                                              Foreground="{DynamicResource State.Error}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Style="{StaticResource Button.Link}"
                    Command="{Binding ToggleBackupsExpandedCommand}"
                    Content="{Binding ToggleExpandLabel}"
                    Visibility="{Binding ShowToggleExpand, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
