<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.SourcesListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourcesRelationsViewModel}"
             d:DesignHeight="520"
             d:DesignWidth="1100">
    
    <UserControl.Resources>

        <DataTemplate x:Key="StatBadgeTemplate"
                      DataType="{x:Type vm:StatBadge}">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,0">
                <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                          Width="12"
                                          Height="12"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Foreground="{Binding Foreground, ElementName=StatBadgeText}" />
                <TextBlock x:Name="StatBadgeText"
                           Text="{Binding Text}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlock.Subtle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}"
                                             Value="Neutral">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Fg.Secondary}" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}"
                                             Value="Ok">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource State.Success}" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}"
                                             Value="Warning">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource State.Warning}" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}"
                                             Value="Error">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource State.Error}" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}"
                                             Value="Muted">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Fg.Muted}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="StatBadgesPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="CardButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding"
                    Value="8,4" />
            <Setter Property="Margin"
                    Value="0,0,4,0" />
            <Setter Property="MinHeight"
                    Value="28" />
        </Style>

        <DataTemplate DataType="{x:Type vm:SourceCardViewModel}">
            <Border Style="{StaticResource Card.ListItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,8,2"
                                   ToolTip="{Binding Title, Mode=OneWay}" />
                        <Border Style="{StaticResource Badge}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,2">
                            <TextBlock Text="{Binding TypeId, Mode=OneWay}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       TextWrapping="NoWrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Stats.Badges}"
                                      ItemTemplate="{StaticResource StatBadgeTemplate}"
                                      ItemsPanel="{StaticResource StatBadgesPanel}"
                                      Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="Pause"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource State.Warning}"
                                              Margin="0,0,6,0" />
                            <TextBlock Text="выключен"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Foreground="{DynamicResource State.Warning}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource InverseBoolToVisibility}}">
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding EditCommand}"
                                    ToolTip="Редактировать"
                                    AutomationProperties.Name="Редактировать">
                                <iconPacks:PackIconLucide Kind="Pencil"
                                                  Width="16"
                                                  Height="16" />
                            </Button>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding DuplicateCommand}"
                                    ToolTip="Дублировать"
                                    AutomationProperties.Name="Дублировать">
                                <iconPacks:PackIconLucide Kind="Clipboard"
                                                  Width="16"
                                                  Height="16" />
                            </Button>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding ToggleDisableCommand}"
                                    ToolTip="{Binding DisableTooltip}"
                                    AutomationProperties.Name="{Binding DisableTooltip}">
                                <iconPacks:PackIconLucide Kind="{Binding DisableIcon}"
                                                  Width="16"
                                                  Height="16" />
                            </Button>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding RequestDeleteCommand}"
                                    ToolTip="Удалить"
                                    AutomationProperties.Name="Удалить источник">
                                <iconPacks:PackIconLucide Kind="X"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Error}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    ToolTip="Подтвердить удаление (связи будут разорваны)">
                                <TextBlock Text="Удалить"
                                           Foreground="{DynamicResource State.Error}" />
                            </Button>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding CancelDeleteCommand}"
                                    ToolTip="Отмена">
                                <TextBlock Text="Отмена" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RelationCardViewModel}">
            <Border Style="{StaticResource Card.ListItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding FromTitle, Mode=OneWay}" />
                            <InlineUIContainer BaselineAlignment="Center">
                                <iconPacks:PackIconLucide Kind="ArrowRight"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                            </InlineUIContainer>
                            <Run Text="{Binding ToTitle, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding FromTypeId, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding ToTypeId, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Stats.Badges}"
                                      ItemTemplate="{StaticResource StatBadgeTemplate}"
                                      ItemsPanel="{StaticResource StatBadgesPanel}"
                                      Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DisabledHint}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Foreground="{DynamicResource State.Warning}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource InverseBoolToVisibility}}">
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding InvertCommand}"
                                    ToolTip="Инвертировать направление"
                                    AutomationProperties.Name="Инвертировать направление">
                                <iconPacks:PackIconLucide Kind="ArrowLeftRight"
                                                  Width="16"
                                                  Height="16" />
                            </Button>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding RequestDeleteCommand}"
                                    ToolTip="Удалить"
                                    AutomationProperties.Name="Удалить связь">
                                <iconPacks:PackIconLucide Kind="X"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Error}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    ToolTip="Подтвердить">
                                <TextBlock Text="Удалить"
                                           Foreground="{DynamicResource State.Error}" />
                            </Button>
                            <Button Style="{StaticResource CardButton}"
                                    Command="{Binding CancelDeleteCommand}"
                                    ToolTip="Отмена">
                                <TextBlock Text="Отмена" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Visibility="{Binding ShowEmptySourcesState, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="ИСТОЧНИКИ"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontWeight="SemiBold"
                               Margin="14,12,14,6" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14,0,14,14">
                        <ItemsControl ItemsSource="{Binding Sources}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="СВЯЗИ"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontWeight="SemiBold"
                               Margin="14,12,14,6" />
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="14,0,14,14"
                                      Visibility="{Binding ShowEmptyRelationsState, Converter={StaticResource InverseBoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Relations}" />
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="20"
                                    Visibility="{Binding ShowEmptyRelationsState, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="Link"
                                              Width="48"
                                              Height="48"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource Fg.Muted}" />
                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,12"
                                       MaxWidth="320"
                                       Text="Связи определяют, по какому маршруту медиа едут между источниками. Добавьте первую связь, чтобы настроить передачи." />
                            <Button Style="{StaticResource Button.Primary}"
                                    Command="{Binding AddRelationCommand}"
                                    IsEnabled="{Binding HasAtLeastTwoSources}"
                                    Padding="14,6"
                                    Height="{DynamicResource Control.Height.Default}"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Добавить связь">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Plus"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0" />
                                    <TextBlock Text="Связь"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Нужно минимум два источника."
                                       Style="{StaticResource TextBlock.Subtle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasAtLeastTwoSources, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Visibility="{Binding ShowEmptySourcesState, Converter={StaticResource BoolToVisibility}}">
            <iconPacks:PackIconLucide Kind="Database"
                              Width="56"
                              Height="56"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource Fg.Muted}" />
            <TextBlock Style="{StaticResource TextBlock.Heading}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,4"
                       Text="Нет источников" />
            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,16"
                       Text="Добавьте первый источник, чтобы начать собирать медиа. Источник – это аккаунт площадки (YouTube, RuTube, VK) или локальная папка." />
            <Button Style="{StaticResource Button.Primary}"
                    Command="{Binding AddSourceCommand}"
                    IsEnabled="{Binding HasPluginTypes}"
                    Padding="18,8"
                    MinHeight="38"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Добавить источник">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Plus"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0" />
                    <TextBlock Text="Добавить источник"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Text="Плагины не загружены. Положите DLL в папку плагинов и перезапустите."
                       Visibility="{Binding HasPluginTypes, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
