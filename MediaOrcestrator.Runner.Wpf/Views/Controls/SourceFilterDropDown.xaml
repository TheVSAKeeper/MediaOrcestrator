<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.SourceFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <Style x:Key="DropToggle"
               TargetType="ToggleButton">
            <Setter Property="Background"
                    Value="{DynamicResource Bg.Surface}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="{DynamicResource Padding.Control.Compact}" />
            <Setter Property="Height"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.S}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceMute}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="{DynamicResource Opacity.Disabled}" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="Toggle"
                      Style="{StaticResource DropToggle}"
                      IsEnabled="{Binding CanEdit, ElementName=Root}"
                      AutomationProperties.Name="{Binding Label, ElementName=Root}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label, ElementName=Root}"
                           VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge.Count}"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary, ElementName=Root}" />
                </Border>
                <iconPacks:PackIconLucide Kind="ChevronDown"
                                          Width="12"
                                          Height="12"
                                          Foreground="{DynamicResource Fg.Muted}"
                                          VerticalAlignment="Center"
                                          Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup IsOpen="{Binding IsChecked, ElementName=Toggle}"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="6"
                    MinWidth="{Binding PopupMinWidth, ElementName=Root}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="2,2,2,4">
                        <Button Style="{StaticResource Button.Ghost}"
                                Content="Все"
                                Command="{Binding SelectAllCommand, ElementName=Root}"
                                Padding="{DynamicResource Padding.Control.Compact}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource Button.Ghost}"
                                Content="Никто"
                                Command="{Binding SelectNoneCommand, ElementName=Root}"
                                Padding="{DynamicResource Padding.Control.Compact}" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="{Binding Title}"
                                              Margin="6,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
