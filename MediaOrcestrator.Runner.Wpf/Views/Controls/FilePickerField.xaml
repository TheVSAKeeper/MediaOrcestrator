<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.FilePickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             AllowDrop="{Binding IsEnabled, ElementName=Root}"
             PreviewDragEnter="OnPreviewDragEnter"
             PreviewDragOver="OnPreviewDragOver"
             PreviewDragLeave="OnPreviewDragLeave"
             PreviewDrop="OnPreviewDrop"
             d:DesignWidth="480">
    <UserControl.Resources>
        <Style x:Key="DropBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Bg.SurfaceAlt}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="{DynamicResource Radius.M}" />
            <Setter Property="Padding"
                    Value="12,10" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource Accent.Primary}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDragOverValid, ElementName=Root}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="Background"
                            Value="{DynamicResource Accent.Soft}" />
                </DataTrigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="{DynamicResource Opacity.Disabled}" />
                    <Setter Property="Cursor"
                            Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource DropBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Background="Transparent"
                      MouseLeftButtonUp="OnBodyMouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="{Binding Icon, ElementName=Root}"
                                              Width="18"
                                              Height="18"
                                              Foreground="{DynamicResource Fg.Secondary}"
                                              VerticalAlignment="Center"
                                              Margin="2,0,10,0" />

                    <Grid Grid.Column="1"
                          Visibility="{Binding IsPathEditable, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding ResolvedLabel, ElementName=Root}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Path, ElementName=Root}"
                                   Visibility="{Binding HasFile, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasFile, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource TextBox.Toolbar}"
                             Text="{Binding Path, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             keepshell:PlaceholderBehavior.Placeholder="{Binding Placeholder, ElementName=Root}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             Visibility="{Binding IsPathEditable, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}"
                            Padding="10,4"
                            Command="{Binding BrowseCommand, ElementName=Root}"
                            ToolTip="{Binding BrowseToolTip, ElementName=Root}"
                            AutomationProperties.Name="{Binding BrowseAutomationName, ElementName=Root}">
                        <iconPacks:PackIconLucide Kind="Folder"
                                                  Width="16"
                                                  Height="16" />
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}"
                            Padding="10,4"
                            Margin="4,0,0,0"
                            Command="{Binding ClearCommand, ElementName=Root}"
                            ToolTip="{Binding ClearToolTip, ElementName=Root}"
                            AutomationProperties.Name="{Binding ClearAutomationName, ElementName=Root}"
                            Visibility="{Binding HasFile, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="X"
                                                  Width="16"
                                                  Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding DropErrorText, ElementName=Root}"
                   Foreground="{DynamicResource State.ErrorText}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Margin="2,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding DropErrorText, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
