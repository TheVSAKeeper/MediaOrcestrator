<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.WinFormsInspectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:migration="clr-namespace:MediaOrcestrator.Domain.Migration;assembly=MediaOrcestrator.Domain"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WinFormsImportDialogViewModel}">

    <Border Style="{StaticResource Card.Inset}"
            Padding="14">
        <StackPanel>
            <TextBlock Text="Папка установленного WinForms"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SourceFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditInputs}"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Папка WinForms" />

                <Button Grid.Column="1"
                        Style="{StaticResource Button.Base}"
                        Command="{Binding BrowseSourceFolderCommand}"
                        Margin="8,0,0,0"
                        Padding="{DynamicResource Padding.Control}"
                        MinHeight="{DynamicResource Control.Height.Default}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Folder"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Обзор…"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding RefreshInspectionCommand}"
                        Margin="6,0,0,0"
                        ToolTip="Проверить папку повторно"
                        AutomationProperties.Name="Проверить папку повторно">
                    <iconPacks:PackIconLucide Kind="RotateCw"
                                              Width="15"
                                              Height="15" />
                </Button>
            </Grid>

            <Border Background="{DynamicResource State.ErrorSoft}"
                    BorderBrush="{DynamicResource State.Error}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="10,8"
                    Margin="0,10,0,0"
                    Visibility="{Binding InspectionErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="TriangleAlert"
                                              Width="16"
                                              Height="16"
                                              Foreground="{DynamicResource State.Error}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,8,0" />
                    <TextBlock Text="{Binding InspectionErrorMessage}"
                               Foreground="{DynamicResource State.Error}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource State.WarningSoft}"
                    BorderBrush="{DynamicResource State.Warning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="12,10"
                    Margin="0,10,0,0"
                    Visibility="{Binding IsWaitingForExit, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SpinningLoader Grid.Column="0"
                                             Width="16"
                                             Height="16"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                        <Run Text="Экземпляр WinForms сейчас запущен (" /><Run Text="{Binding RunningPidsText, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" /><Run Text="). Закройте его вручную – перенос продолжится сразу после освобождения базы." />
                    </TextBlock>

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CancelWaitingCommand}"
                            Content="Отменить ожидание"
                            Margin="10,0,0,0"
                            Padding="10,4"
                            MinHeight="{DynamicResource Control.Height.Compact}" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource State.WarningSoft}"
                    BorderBrush="{DynamicResource State.Warning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="12,10"
                    Margin="0,10,0,0"
                    Visibility="{Binding ShowPausedRunningNotice, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="TriangleAlert"
                                              Width="16"
                                              Height="16"
                                              Foreground="{DynamicResource State.Warning}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="База WinForms всё ещё занята. Закройте программу и нажмите «Ждать закрытия» или перепроверьте папку." />

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding StartWaitingForExitCommand}"
                            Content="Ждать закрытия"
                            Margin="10,0,0,0"
                            Padding="10,4"
                            MinHeight="{DynamicResource Control.Height.Compact}" />
                </Grid>
            </Border>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                        <TextBlock>
                            <Run Text="Версия:" Foreground="{DynamicResource Fg.Secondary}" />
                            <Run Text="{Binding DetectedVersionText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                        <TextBlock>
                            <Run Text="Источников:" Foreground="{DynamicResource Fg.Secondary}" />
                            <Run Text="{Binding SourcesCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                        <TextBlock>
                            <Run Text="Медиа:" Foreground="{DynamicResource Fg.Secondary}" />
                            <Run Text="{Binding MediasCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                        <TextBlock>
                            <Run Text="Связей:" Foreground="{DynamicResource Fg.Secondary}" />
                            <Run Text="{Binding RelationsCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,0,6">
                        <TextBlock>
                            <Run Text="Шаблонов обложек:" Foreground="{DynamicResource Fg.Secondary}" />
                            <Run Text="{Binding CoverTemplatesCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <Border Background="{DynamicResource State.InfoSoft}"
                        BorderBrush="{DynamicResource State.Info}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Padding="10,6"
                        Margin="0,4,0,0"
                        Visibility="{Binding HasWalLog, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="FileCheck"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource State.Info}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                        <TextBlock Text="{Binding WalLogNoticeText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding HasHardDiskPaths, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Каталоги HardDiskDrive (останутся на месте без дублирования):"
                               Style="{StaticResource Form.Hint}"
                               Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding HardDiskPaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource TextBlock.Mono}"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Warnings}"
                              Margin="0,6,0,0"
                              Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type migration:WinFormsImportWarning}">
                            <Border Background="{DynamicResource State.WarningSoft}"
                                    BorderBrush="{DynamicResource State.Warning}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="10,6"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="TriangleAlert"
                                                              Width="14"
                                                              Height="14"
                                                              Foreground="{DynamicResource State.Warning}"
                                                              VerticalAlignment="Top"
                                                              Margin="0,2,8,0" />
                                    <TextBlock Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
