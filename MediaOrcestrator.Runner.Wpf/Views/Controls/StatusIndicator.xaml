<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="14"
             d:DesignWidth="14">
    
    <Path Width="14"
          Height="14"
          Stretch="None"
          StrokeThickness="1.6"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          StrokeLineJoin="Round"
          VerticalAlignment="Center"
          SnapsToDevicePixels="True">
        <Path.Style>
            <Style TargetType="Path">
                <Setter Property="Stroke"
                        Value="{DynamicResource Fg.Muted}" />
                <Setter Property="Fill"
                        Value="Transparent" />
                <Setter Property="Data"
                        Value="M 7 1 A 6 6 0 1 1 6.99 1 Z" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Working">
                        <Setter Property="Stroke"
                                Value="{DynamicResource Accent.Primary}" />
                        <Setter Property="Fill"
                                Value="{DynamicResource Accent.Primary}" />
                        <Setter Property="Data"
                                Value="M 7 1 A 6 6 0 1 1 1.5 9.5 L 3 8.7 A 4.5 4.5 0 1 0 7 2.5 L 7 4.5 L 4 2.5 L 7 0.5 Z" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Waiting">
                        <Setter Property="Stroke"
                                Value="{DynamicResource State.Warning}" />
                        <Setter Property="Fill"
                                Value="Transparent" />
                        <Setter Property="StrokeThickness"
                                Value="1.4" />
                        <Setter Property="Data"
                                Value="M 3 1 L 11 1 L 11 4 L 7 7 L 11 10 L 11 13 L 3 13 L 3 10 L 7 7 L 3 4 Z" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Ok">
                        <Setter Property="Stroke"
                                Value="{DynamicResource State.Success}" />
                        <Setter Property="Fill"
                                Value="Transparent" />
                        <Setter Property="StrokeThickness"
                                Value="2" />
                        <Setter Property="Data"
                                Value="M 2 7 L 6 11 L 12 3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Error">
                        <Setter Property="Stroke"
                                Value="{DynamicResource State.Error}" />
                        <Setter Property="Fill"
                                Value="{DynamicResource State.ErrorSoft}" />
                        <Setter Property="StrokeThickness"
                                Value="1.5" />
                        <Setter Property="Data"
                                Value="M 7 1 L 13 12 L 1 12 Z M 7 5 L 7 9 M 7 10.5 L 7 11.2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="NonRetriable">
                        <Setter Property="Stroke"
                                Value="{DynamicResource State.Error}" />
                        <Setter Property="Fill"
                                Value="Transparent" />
                        <Setter Property="StrokeThickness"
                                Value="1.6" />
                        <Setter Property="Data"
                                Value="M 7 1 A 6 6 0 1 1 6.99 1 Z M 3 3 L 11 11" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Joined">
                        <Setter Property="Stroke"
                                Value="{DynamicResource Accent.Primary}" />
                        <Setter Property="Fill"
                                Value="Transparent" />
                        <Setter Property="StrokeThickness"
                                Value="1.4" />
                        <Setter Property="Data"
                                Value="M 3 1 L 11 1 L 11 4 L 7 7 L 11 10 L 11 13 L 3 13 L 3 10 L 7 7 L 3 4 Z" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Path.Style>
    </Path>
</UserControl>
