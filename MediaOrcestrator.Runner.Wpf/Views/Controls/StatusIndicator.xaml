<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="14"
             d:DesignWidth="14">
    <iconPacks:PackIconLucide Width="14"
                              Height="14"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
        <iconPacks:PackIconLucide.RenderTransform>
            <RotateTransform />
        </iconPacks:PackIconLucide.RenderTransform>
        <iconPacks:PackIconLucide.Style>
            <Style TargetType="iconPacks:PackIconLucide">
                <Setter Property="Kind"
                        Value="CircleDashed" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Fg.Muted}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Working">
                        <Setter Property="Kind"
                                Value="LoaderCircle" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource Accent.Primary}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Status, ElementName=Root}"
                                       Value="Working" />
                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"
                                       Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard x:Name="SpinWorking">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="SpinWorking" />
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Waiting">
                        <Setter Property="Kind"
                                Value="Hourglass" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource State.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Ok">
                        <Setter Property="Kind"
                                Value="Check" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource State.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Error">
                        <Setter Property="Kind"
                                Value="TriangleAlert" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource State.Error}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="NonRetriable">
                        <Setter Property="Kind"
                                Value="Ban" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource State.Error}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}"
                                 Value="Joined">
                        <Setter Property="Kind"
                                Value="GitMerge" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource Accent.Primary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </iconPacks:PackIconLucide.Style>
    </iconPacks:PackIconLucide>
</UserControl>
