<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <DataTemplate x:Key="TransferActions">
        <Border Style="{StaticResource Card.Inset}"
                Margin="0,4,0,0"
                Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasRunProgress, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock.ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding PlanSummary}" />
                                <TextBlock Text="{Binding SelectionSummary}" />
                                <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                        </TextBlock.ToolTip>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Цепочки: {0}/{1}">
                                <Binding Path="SelectedRoots" />
                                <Binding Path="PlanRoots" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding RunProgressText}"
                               Style="{StaticResource TextBlock.Subtle}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding StatusText}"
                               Visibility="{Binding HasRunProgress, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock Grid.Column="1"
                           Text="План устарел"
                           Foreground="{DynamicResource State.Warning}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           ToolTip="Медиа, источники или связи изменились. Пересоберите план перед запуском."
                           Visibility="{Binding IsPlanStale, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding RebuildPlanCommand}"
                        MinHeight="{DynamicResource Control.Height.Compact}"
                        Padding="{DynamicResource Padding.Control.Compact}"
                        Margin="0,0,4,0"
                        ToolTip="Перестроить план по текущим медиа и связям"
                        AutomationProperties.Name="Пересобрать план">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="14" Height="14"
                                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Пересобрать" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding ExecuteSelectedCommand}"
                        MinHeight="{DynamicResource Control.Height.Compact}"
                        Padding="{DynamicResource Padding.Control.Compact}"
                        AutomationProperties.Name="Выполнить выбранное"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                            <Setter Property="ToolTip" Value="Выполнить выбранные цепочки передач" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUploadIntervalValid}" Value="False">
                                    <Setter Property="ToolTip" Value="{Binding UploadIntervalHint}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlanStale}" Value="True">
                                    <Setter Property="ToolTip" Value="Сначала пересоберите план" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Play" Width="14" Height="14"
                                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Выполнить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding StopCommand}"
                        MinHeight="{DynamicResource Control.Height.Compact}"
                        MinWidth="{DynamicResource Control.Height.Compact}"
                        Padding="0"
                        Margin="4,0,0,0"
                        ToolTip="Остановить передачи"
                        AutomationProperties.Name="Остановить передачи">
                    <iconPacks:PackIconLucide Kind="Square" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="MenuItemButton"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <Style x:Key="GroupCheckBox"
           TargetType="CheckBox">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="IsThreeState"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator>
                        <BulletDecorator.Bullet>
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.S}">
                                <Grid>
                                    <Path x:Name="CheckMark"
                                          Data="M 4 9 L 7 12 L 14 5"
                                          Stroke="{DynamicResource Fg.OnAccent}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                    <Rectangle x:Name="IndeterminateMark"
                                               Width="10"
                                               Height="2"
                                               Fill="{DynamicResource Fg.OnAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="{x:Null}">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="IndeterminateMark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusTail"
           TargetType="TextBlock">
        <Setter Property="Margin"
                Value="8,0,0,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}"
                         Value="Working">
                <Setter Property="Foreground"
                        Value="{DynamicResource Accent.Primary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}"
                         Value="Waiting">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}"
                         Value="Ok">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}"
                         Value="Error">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Error}" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}"
                         Value="NonRetriable">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Error}" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JournalEntryText"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}"
                         Value="Success">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}"
                         Value="Warning">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}"
                         Value="Error">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Error}" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TreeItemContainer"
           TargetType="TreeViewItem">
        <Setter Property="IsExpanded"
                Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding"
                Value="2" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing"
                Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode"
                Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="Expander"
                                      Grid.Column="0"
                                      ClickMode="Press"
                                      IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Свернуть или развернуть группу">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path x:Name="Glyph"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 0 8 Z"
                                              Fill="{DynamicResource Fg.Muted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked"
                                                 Value="True">
                                            <Setter TargetName="Glyph"
                                                    Property="Data"
                                                    Value="M 0 0 L 8 0 L 4 4 Z" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="Glyph"
                                                    Property="Fill"
                                                    Value="{DynamicResource Accent.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border Grid.Column="1"
                                x:Name="HeaderBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Radius.S}"
                                Padding="4,2">
                            <ContentPresenter ContentSource="Header" />
                        </Border>

                        <ItemsPresenter Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="ItemsHost"
                                        Margin="14,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded"
                                 Value="False">
                            <Setter TargetName="ItemsHost"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems"
                                 Value="False">
                            <Setter TargetName="Expander"
                                    Property="Visibility"
                                    Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 SourceName="HeaderBorder"
                                 Value="True">
                            <Setter TargetName="HeaderBorder"
                                    Property="Background"
                                    Value="{DynamicResource Bg.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="HeaderBorder"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Soft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
