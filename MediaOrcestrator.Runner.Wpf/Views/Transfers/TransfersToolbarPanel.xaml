<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Transfers.TransfersToolbarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TransfersViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MediaOrcestrator.Runner.Wpf;component/Views/Transfers/TransfersResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="{DynamicResource Margin.StackItem.Dense}"
            Padding="6,2"
            ToolTip="Дерево цепочек: медиа → шаги передачи через активные связи. План строится по новым медиа в исходных источниках; пересборка ручная.">
        <keepshell:StretchWrapPanel>
            <Grid keepshell:StretchWrapPanel.Stretch="True"
                  keepshell:StretchWrapPanel.StretchWidth="180"
                  Margin="0,2,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource TextBox.Toolbar}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="Название медиа"
                         AutomationProperties.AutomationId="TransfersSearchBox"
                         AutomationProperties.Name="Поиск по плану передач"
                         Height="{DynamicResource Control.Height.Compact}"
                         MinHeight="0"
                         MinWidth="130"
                         Padding="32,0,32,0" />
                <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="16" Height="16"
                                          Foreground="{DynamicResource Fg.Muted}" Margin="12,0,0,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <Button Grid.Column="0"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding ClearSearchCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Padding="6,2"
                        ToolTip="Очистить поиск"
                        AutomationProperties.Name="Очистить поиск"
                        Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="X" Width="12" Height="12" />
                </Button>
            </Grid>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="SourcesFilterToggle"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              Height="Auto"
                              MinHeight="{DynamicResource Control.Height.Compact}"
                              Margin="0,0,4,0"
                              Padding="8,2"
                              AutomationProperties.Name="Источники">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Источники" VerticalAlignment="Center" />
                        <iconPacks:PackIconLucide Kind="ChevronDown" Width="12" Height="12"
                                                  Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=SourcesFilterToggle}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=SourcesFilterToggle, Mode=TwoWay}">
                    <controls:FilterChecklist ItemsSource="{Binding SourceFilters}"
                                              MinWidth="240"
                                              Margin="0,4,0,0" />
                </Popup>

                <ToggleButton x:Name="RelationsFilterToggle"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              Height="Auto"
                              MinHeight="{DynamicResource Control.Height.Compact}"
                              Margin="0,0,4,0"
                              Padding="8,2"
                              AutomationProperties.Name="Связи">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Связи" VerticalAlignment="Center" />
                        <iconPacks:PackIconLucide Kind="ChevronDown" Width="12" Height="12"
                                                  Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=RelationsFilterToggle}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=RelationsFilterToggle, Mode=TwoWay}">
                    <controls:FilterChecklist ItemsSource="{Binding RelationFilters}"
                                              MinWidth="280"
                                              Margin="0,4,0,0" />
                </Popup>

                <ToggleButton x:Name="MoreMenuToggle"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              Height="Auto"
                              MinHeight="{DynamicResource Control.Height.Compact}"
                              Margin="0,0,4,0"
                              Padding="8,2"
                              IsChecked="{Binding IsMoreMenuOpen, Mode=TwoWay}"
                              ToolTip="Дополнительные действия"
                              AutomationProperties.Name="Дополнительные действия">
                    <iconPacks:PackIconLucide Kind="Ellipsis" Width="18" Height="18" />
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=MoreMenuToggle}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       IsOpen="{Binding IsMoreMenuOpen, Mode=TwoWay}">
                    <Border Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="4"
                            MinWidth="220"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <Button Style="{StaticResource MenuItemButton}" Command="{Binding SelectAllCommand}">
                                <TextBlock Text="Выбрать всё" />
                            </Button>
                            <Button Style="{StaticResource MenuItemButton}" Command="{Binding DeselectAllCommand}">
                                <TextBlock Text="Снять всё" />
                            </Button>
                            <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="6,4" />
                            <Button Style="{StaticResource MenuItemButton}" Command="{Binding ExpandAllCommand}">
                                <TextBlock Text="Развернуть всё" />
                            </Button>
                            <Button Style="{StaticResource MenuItemButton}" Command="{Binding CollapseAllCommand}">
                                <TextBlock Text="Свернуть всё" />
                            </Button>
                            <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="6,4" />
                            <Button Style="{StaticResource MenuItemButton}" Command="{Binding ResetFiltersCommand}">
                                <TextBlock Text="Сбросить фильтры" />
                            </Button>
                            <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="6,4" />
                            <Button Style="{StaticResource MenuItemButton}" Command="{Binding ClearJournalCommand}">
                                <TextBlock Text="Очистить журнал" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                <ToggleButton x:Name="RunOptionsToggle"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              Height="Auto"
                              MinHeight="{DynamicResource Control.Height.Compact}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Padding="8,2"
                              AutomationProperties.Name="Параметры прогона"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="{Binding UploadIntervalHint}">
                    <Grid>
                        <iconPacks:PackIconLucide Kind="SlidersHorizontal" Width="16" Height="16" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent.Primary}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                                 Visibility="{Binding UploadIntervalEnabled, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=RunOptionsToggle}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=RunOptionsToggle, Mode=TwoWay}">
                    <Border Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="12"
                            MinWidth="260"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <CheckBox Content="Прервать при ошибке"
                                      IsChecked="{Binding StopOnError}"
                                      Margin="0,0,0,8"
                                      ToolTip="Первая ошибка останавливает прогон." />
                            <ToggleButton Content="Пауза между загрузками"
                                          Style="{StaticResource ToggleButton.Filter}"
                                          IsChecked="{Binding UploadIntervalEnabled}"
                                          IsEnabled="{Binding CanEditUploadInterval}"
                                          HorizontalAlignment="Left"
                                          Margin="0"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Пауза после каждой успешной загрузки – ВК хуже показывает видео, залитые пачкой." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="52"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         IsEnabled="{Binding CanEditUploadIntervalMinutes}"
                                         MaxLength="4"
                                         Text="{Binding UploadIntervalMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Пауза между загрузками, минут"
                                         ToolTipService.ShowOnDisabled="True"
                                         ToolTip="{Binding UploadIntervalHint}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Form}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUploadIntervalValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource State.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="мин" Style="{StaticResource TextBlock.Subtle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                              Height="Auto"
                              MinHeight="{DynamicResource Control.Height.Compact}"
                              IsChecked="{Binding IsJournalOpen}"
                              VerticalAlignment="Center"
                              Margin="0"
                              Padding="8,2"
                              AutomationProperties.Name="Журнал прогона"
                              ToolTip="Показать/скрыть боковую панель с журналом прогона.">
                    <iconPacks:PackIconLucide Kind="PanelRight" Width="16" Height="16" />
                </ToggleButton>
            </StackPanel>
        </keepshell:StretchWrapPanel>
    </Border>
</UserControl>
