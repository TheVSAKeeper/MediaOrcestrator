<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.BatchPreviewSubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BatchPreviewSubViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1100">
    <UserControl.Resources>

        <Style x:Key="OperationRowItem"
               TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="6,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PreviewRowTemplate"
                      DataType="{x:Type vm:BatchPreviewRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsApplyChecked}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          ToolTip="Применить к этой площадке"
                          AutomationProperties.Name="Применить к площадке" />

                <Grid Grid.Column="1"
                      VerticalAlignment="Center">
                    
                    <StackPanel x:Name="ComfortableTitles">
                        <TextBlock Text="{Binding MediaTitle}"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TargetTitle}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid x:Name="CompactTitles"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MediaTitle}"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0" />
                        <Border Grid.Column="1"
                                Style="{StaticResource Badge.Count}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TargetTitle}" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource Badge.RowStatus}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        ToolTip="{Binding ResultTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{Binding Status, Converter={StaticResource OperationRowStatusToIcon}}"
                                                  Width="12"
                                                  Height="12"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,3,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type controls:OperationResultPanel}}}"
                             Value="True">
                    <Setter TargetName="ComfortableTitles"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="CompactTitles"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="260"
                      Margin="0,0,0,6">
            <Border Style="{StaticResource Card.Inset}"
                    Padding="{DynamicResource Padding.Panel.Dense}">
            <StackPanel>
                <controls:BatchMediaToolbar Margin="0,0,0,4"
                                            MediasSummary="{Binding MediasSummary}"
                                            LoadAllMediaCommand="{Binding LoadAllMediaCommand}"
                                            ClearMediaCommand="{Binding ClearMediaCommand}"
                                            HasMedias="{Binding HasMedias}"
                                            CanEditParameters="{Binding CanEditParameters}"
                                            StopOnError="{Binding StopOnError}" />

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">
                        <TextBlock Text="Источник превью"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,0,0,2" />

                        <Border HorizontalAlignment="Left"
                                Background="{DynamicResource Bg.SurfaceAlt}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="2"
                                Margin="0,0,0,6">
                            
                            <WrapPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RadioButton.Segment}"
                                             GroupName="PreviewSource"
                                             Content="Из площадки"
                                             IsChecked="{Binding IsDonorMode, Mode=OneWay}"
                                             IsEnabled="{Binding CanEditParameters}"
                                             Command="{Binding SetSourceModeCommand}"
                                             CommandParameter="{x:Static vm:BatchPreviewSourceMode.Donor}"
                                             AutomationProperties.Name="Источник превью: из площадки" />
                                <RadioButton Style="{StaticResource RadioButton.Segment}"
                                             GroupName="PreviewSource"
                                             Content="Из файла"
                                             IsChecked="{Binding IsFileMode, Mode=OneWay}"
                                             IsEnabled="{Binding CanEditParameters}"
                                             Command="{Binding SetSourceModeCommand}"
                                             CommandParameter="{x:Static vm:BatchPreviewSourceMode.File}"
                                             AutomationProperties.Name="Источник превью: из файла" />
                                <RadioButton Style="{StaticResource RadioButton.Segment}"
                                             GroupName="PreviewSource"
                                             Content="Из шаблона"
                                             IsChecked="{Binding IsTemplateMode, Mode=OneWay}"
                                             IsEnabled="{Binding CanEditParameters}"
                                             Command="{Binding SetSourceModeCommand}"
                                             CommandParameter="{x:Static vm:BatchPreviewSourceMode.Template}"
                                             AutomationProperties.Name="Источник превью: из шаблона" />
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid Visibility="{Binding IsDonorMode, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox x:Name="DonorComboBox"
                                          Style="{StaticResource ComboBox.Toolbar}"
                                          ItemsSource="{Binding Donors}"
                                          SelectedItem="{Binding SelectedDonor}"
                                          DisplayMemberPath="TitleFull"
                                          IsEnabled="{Binding IsDonorMode}"
                                          ToolTip="Площадка-донор: с неё берётся текущее превью каждого видео"
                                          AutomationProperties.Name="Площадка-донор" />
                                <TextBlock Text="Выберите площадку-донора…"
                                           Foreground="{DynamicResource Fg.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,28,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=DonorComboBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <controls:FilePickerField Path="{Binding FilePath, Mode=TwoWay}"
                                                      IsPathEditable="True"
                                                      Placeholder="Путь к файлу или перетащите картинку"
                                                      Icon="Image"
                                                      AllowedExtensions=".jpg;.jpeg;.png;.webp;.bmp"
                                                      BrowseCommand="{Binding BrowseFileCommand}"
                                                      ClearCommand="{Binding ClearFileCommand}"
                                                      IsEnabled="{Binding IsFileMode}"
                                                      BrowseToolTip="Выбрать файл превью"
                                                      BrowseAutomationName="Выбрать файл превью"
                                                      ClearAutomationName="Очистить путь к файлу превью"
                                                      Visibility="{Binding IsFileMode, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Visibility="{Binding IsTemplateMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <ComboBox x:Name="TemplateProfileComboBox"
                                              Style="{StaticResource ComboBox.Toolbar}"
                                              ItemsSource="{Binding TemplatePicker.Profiles}"
                                              SelectedItem="{Binding TemplatePicker.SelectedProfileName, Mode=TwoWay}"
                                              IsEnabled="{Binding IsTemplateMode}"
                                              ToolTip="Профиль шаблона обложки"
                                              AutomationProperties.Name="Профиль шаблона обложки" />
                                    <TextBlock Text="Выберите профиль шаблона…"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,28,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=TemplateProfileComboBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Icon}"
                                        Command="{Binding TemplatePicker.DeleteProfileCommand}"
                                        IsEnabled="{Binding IsTemplateMode}"
                                        Margin="6,0,0,0"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Удалить выбранный профиль"
                                        AutomationProperties.Name="Удалить профиль обложки">
                                    <iconPacks:PackIconLucide Kind="Trash2"
                                                              Width="14"
                                                              Height="14" />
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource Button.Ghost}"
                                        Content="Настроить…"
                                        Command="{Binding TemplatePicker.OpenEditorCommand}"
                                        IsEnabled="{Binding IsTemplateMode}"
                                        Padding="{DynamicResource Padding.Control.Compact}"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="Настроить шаблон обложки" />
                            </Grid>
                        </Grid>

                        <controls:SourceFilterDropDown Label="Куда применить"
                                                       ItemsSource="{Binding Targets}"
                                                       CanEdit="{Binding CanEditParameters}"
                                                       SelectAllCommand="{Binding SelectAllTargetsCommand}"
                                                       SelectNoneCommand="{Binding SelectNoTargetsCommand}"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="160"
                            Height="90"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Bg.SurfaceAlt}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            ClipToBounds="True"
                            ToolTip="{Binding PreviewHint}">
                        <Grid>
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibility}}" />
                            
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="8"
                                        Visibility="{Binding PreviewHint, Converter={StaticResource NullToVisibility}}">
                                <iconPacks:PackIconLucide Kind="Image"
                                                          Width="20"
                                                          Height="20"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{DynamicResource Fg.Muted}"
                                                          Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PreviewHint}"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           FontSize="{DynamicResource Font.Size.XS}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
            </Border>
        </ScrollViewer>

        <controls:OperationResultPanel Grid.Row="1"
                                       SelectAllCommand="{Binding SelectAllRowsCommand}"
                                       SelectNoneCommand="{Binding SelectNoRowsCommand}"
                                       CanSelect="{Binding CanEditParameters}"
                                       JournalSource="{Binding Journal}"
                                       ClearJournalCommand="{Binding ClearJournalCommand}"
                                       IsJournalOpen="{Binding IsJournalOpen}"
                                       IsEmpty="{Binding IsResultEmpty}"
                                       IsCompact="{Binding IsCompact, Mode=TwoWay}">
            <controls:OperationResultPanel.HeaderLeft>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center" />
            </controls:OperationResultPanel.HeaderLeft>

            <controls:OperationResultPanel.EmptyContent>
                <keepshell:EmptyState VerticalAlignment="Center"
                                      DescriptionMaxWidth="420">
                    <keepshell:EmptyState.Style>
                        <Style TargetType="keepshell:EmptyState">
                            <Setter Property="Icon"
                                    Value="Image" />
                            <Setter Property="Heading"
                                    Value="Набор пуст" />
                            <Setter Property="Description"
                                    Value="Загрузите все медиа из хранилища или откройте набор из раздела «Медиа» (контекстное меню → «Открыть в Операциях»)." />
                            <Setter Property="ActionText"
                                    Value="Загрузить всё хранилище" />
                            <Setter Property="ActionCommand"
                                    Value="{Binding LoadAllMediaCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMedias}"
                                             Value="True">
                                    <Setter Property="Icon"
                                            Value="SlidersHorizontal" />
                                    <Setter Property="Heading"
                                            Value="Нет строк для обновления" />
                                    <Setter Property="Description"
                                            Value="Ни одно медиа из набора не пересекается с отмеченными целевыми площадками. Проверьте донора и список «Куда применить»." />
                                    <Setter Property="ActionText"
                                            Value="{x:Null}" />
                                    <Setter Property="ActionCommand"
                                            Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </keepshell:EmptyState.Style>
                </keepshell:EmptyState>
            </controls:OperationResultPanel.EmptyContent>

            <ListBox ItemsSource="{Binding Rows}"
                     ItemTemplate="{StaticResource PreviewRowTemplate}"
                     ItemContainerStyle="{StaticResource OperationRowItem}"
                     Background="{DynamicResource Bg.Surface}"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
        </controls:OperationResultPanel>

        <Border Grid.Row="2"
                Style="{StaticResource Card.Inset}"
                Margin="0,8,0,0">
            
            <controls:OperationActionBar ApplyText="{Binding ApplyButtonText}"
                                         ApplyCommand="{Binding ApplyCommand}"
                                         CancelCommand="{Binding CancelCommand}"
                                         IsBusy="{Binding IsApplying}"
                                         ProgressValue="{Binding ProgressValue}"
                                         ProgressMax="{Binding ProgressMax}"
                                         ToggleJournalCommand="{Binding ToggleJournalCommand}">
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center">
                    <Run Text="К применению: " />
                    <Run Text="{Binding ActionableCount, Mode=OneWay}" />
                    <Run Text=" из " />
                    <Run Text="{Binding Rows.Count, Mode=OneWay}" />
                </TextBlock>
            </controls:OperationActionBar>
        </Border>
    </Grid>
</UserControl>
