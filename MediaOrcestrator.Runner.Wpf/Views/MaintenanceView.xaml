<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MaintenanceViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="900">

    <UserControl.Resources>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.L}" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
        </Style>

        <Style x:Key="InfoLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Setter Property="VerticalAlignment"
                    Value="Top" />
            <Setter Property="Margin"
                    Value="0,0,12,0" />
        </Style>

        <Style x:Key="InfoValue"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
        </Style>

        <Style x:Key="InfoValueMono"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Mono}">
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
        </Style>

        <DataTemplate x:Key="MaintenanceItemTemplate"
                      DataType="{x:Type vm:MaintenanceItemViewModel}">
            <Border Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="14,12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MaintCheck" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MaintSize" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Default}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SizeText, FallbackValue='…', TargetNullValue='…'}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.S}" />
                    </Grid>

                    <Grid Margin="32,10,0,0"
                          Visibility="{Binding HasAgeFilter, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Только старше"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Slider Grid.Column="1"
                                Minimum="{Binding MinAgeDays, Mode=OneTime}"
                                Maximum="{Binding MaxAgeDays, Mode=OneTime}"
                                Value="{Binding AgeDays, Mode=TwoWay, Delay=200}"
                                SmallChange="1"
                                LargeChange="7"
                                TickFrequency="7"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center">
                            <Slider.Style>
                                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AgeHint}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   MinWidth="120"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   FontSize="{DynamicResource Font.Size.S}" />
                    </Grid>

                    <Grid Margin="32,6,0,0"
                          MinHeight="18">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="LoaderCircle"
                                                      Width="14"
                                                      Height="14"
                                                      Foreground="{DynamicResource Accent.Primary}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconLucide.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </iconPacks:PackIconLucide.RenderTransform>
                                <iconPacks:PackIconLucide.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:1"
                                                                 RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </iconPacks:PackIconLucide.Triggers>
                            </iconPacks:PackIconLucide>
                            <TextBlock Text="Очистка…"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ResultText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Subtle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:MaintenanceItemState.Success}">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:MaintenanceItemState.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="0,0,12,0">
            <StackPanel>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap"
                               MaxWidth="780"
                               HorizontalAlignment="Left"
                               Text="Сведения о приложении, файловые пути и ручная очистка тяжёлых данных. Перед массовой чисткой создаётся бэкап БД – рядом с обычным расписанием раз в 6 часов." />

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CopyDiagnosticsCommand}"
                            Padding="{DynamicResource Padding.Control}"
                            MinHeight="{DynamicResource Control.Height.Compact}"
                            ToolTip="Скопировать сводку в буфер обмена"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Clipboard"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                            <TextBlock Text="Копировать сводку"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Приложение" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Версия" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding AppVersion}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Runtime" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding RuntimeDescription}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Архитектура" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding ProcessArchitecture}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="PID" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding ProcessId}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Время работы" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding UpTimeText}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Папка" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoValueMono}" Text="{Binding AppDirectory}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenAppFolderCommand}"
                                    Padding="{DynamicResource Padding.Control}"
                                    MinHeight="{DynamicResource Control.Height.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Открыть папку приложения" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding RefreshAllCommand}"
                                    Padding="{DynamicResource Padding.Control}"
                                    Margin="8,0,0,0"
                                    MinHeight="{DynamicResource Control.Height.Compact}"
                                    ToolTip="Пересчитать размеры и обновить время работы">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Обновить" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Система" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="ОС" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding OperatingSystem}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Машина" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding MachineName}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="База данных" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Размер файла" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding DatabaseSizeText}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Путь" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueMono}" Text="{Binding DatabasePath}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenDatabaseFolderCommand}"
                                    Padding="{DynamicResource Padding.Control}"
                                    MinHeight="{DynamicResource Control.Height.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ExternalLink" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Показать в проводнике" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Text="Управление бэкапами и удаление записей – во вкладке «Очистка БД»." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Папки приложения" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="logs/" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueMono}" Text="{Binding LogsPath}" Margin="0,0,0,6" />
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding OpenLogsFolderCommand}" AutomationProperties.Name="Открыть папку логов" ToolTip="Открыть в проводнике" Margin="0,-3,0,0">
                                <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" />
                            </Button>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="backups/" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueMono}" Text="{Binding BackupsPath}" Margin="0,0,0,6" />
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding OpenBackupsFolderCommand}" AutomationProperties.Name="Открыть папку бэкапов" ToolTip="Открыть в проводнике" Margin="0,-3,0,6">
                                <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" />
                            </Button>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="temp/" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueMono}" Text="{Binding TempPath}" />
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding OpenTempFolderCommand}" AutomationProperties.Name="Открыть папку временных файлов" ToolTip="Открыть в проводнике" Margin="0,-3,0,0">
                                <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <keepshell:ProgressStatusBlock StatusText="{Binding StatusText}"
                                                  CancelCommand="{Binding CancelCommand}"
                                                  Maximum="{Binding ProgressMax}"
                                                  Value="{Binding ProgressValue, Mode=OneWay}" />
                </Border>

                <Border Style="{StaticResource Card.Inset}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource SectionTitle}"
                                       Text="Очистка файлов"
                                       Margin="0,0,0,0" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       VerticalAlignment="Center">
                                <Run Text="Выбрано:" />
                                <Run Text="{Binding SafeSelectedCount, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Fg.Primary}" />
                            </TextBlock>
                        </Grid>

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Text="Освобождает место на диске. Файлы можно потерять, но БД и записи останутся нетронутыми." />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding SelectAllSafeCommand}"
                                    Content="Выбрать всё"
                                    Padding="12,4"
                                    MinHeight="{DynamicResource Control.Height.Compact}" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding SelectNoneSafeCommand}"
                                    Content="Снять выбор"
                                    Padding="12,4"
                                    MinHeight="{DynamicResource Control.Height.Compact}"
                                    Margin="8,0,0,0" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding RefreshAllCommand}"
                                    Padding="10,4"
                                    MinHeight="{DynamicResource Control.Height.Compact}"
                                    Margin="16,0,0,0"
                                    ToolTip="Пересчитать размеры коллекций и папок">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCcw"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Обновить размеры"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SafeItems}"
                                      Grid.IsSharedSizeScope="True"
                                      ItemTemplate="{StaticResource MaintenanceItemTemplate}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="Перед очисткой будет создан ручной бэкап БД (на случай если задели не то)." />

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding RunSafeCommand}"
                                    Padding="18,8"
                                    MinHeight="{DynamicResource Control.Height.Default}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Eraser"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Освободить место" />
                                        <Run Text="(" /><Run Text="{Binding SafeSelectedCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
