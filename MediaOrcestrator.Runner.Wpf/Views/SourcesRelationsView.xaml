<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.SourcesRelationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourcesRelationsViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="1100">

    <UserControl.Resources>

        <Style x:Key="ViewModeButton"
               TargetType="ToggleButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="10,4" />
            <Setter Property="MinHeight"
                    Value="30" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="{DynamicResource Margin.StackItem}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding AddSourceCommand}"
                        IsEnabled="{Binding HasPluginTypes}"
                        Padding="14,6"
                        Height="{DynamicResource Control.Height.Default}"
                        Margin="0,0,8,0"
                        ToolTip="Добавить новый источник">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Plus"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                        <TextBlock Text="Источник"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding AddRelationCommand}"
                        IsEnabled="{Binding HasAtLeastTwoSources}"
                        Padding="{DynamicResource Padding.Control}"
                        Height="{DynamicResource Control.Height.Default}"
                        Margin="0,0,12,0"
                        ToolTip="Создать связь между двумя источниками">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Plus"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                        <TextBlock Text="Связь"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource ViewModeButton}"
                                      IsChecked="{Binding IsListMode, Mode=OneWay}"
                                      Command="{Binding SetListModeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="LayoutGrid"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0" />
                                <TextBlock Text="Список"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ViewModeButton}"
                                      IsChecked="{Binding IsGraphMode, Mode=OneWay}"
                                      Command="{Binding SetGraphModeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Diamond"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0" />
                                <TextBlock Text="Граф"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Style="{StaticResource TextBlock.Subtle}">
                <Run Text="Источников:" />
                <Run Text="{Binding SourceCount, Mode=OneWay}" />
                <Run Text="(" />
                <InlineUIContainer BaselineAlignment="Center">
                    <iconPacks:PackIconLucide Kind="Pause"
                                      Width="12"
                                      Height="12"
                                      Margin="2,0,2,0" />
                </InlineUIContainer>
                <Run Text="{Binding DisabledSourceCount, Mode=OneWay}" />
                <Run Text=")" />
            </TextBlock>
            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       Margin="14,0,0,0">
                <Run Text="Связей:" />
                <Run Text="{Binding RelationCount, Mode=OneWay}" />
                <Run Text="(" />
                <InlineUIContainer BaselineAlignment="Center">
                    <iconPacks:PackIconLucide Kind="Pause"
                                      Width="12"
                                      Height="12"
                                      Margin="2,0,2,0" />
                </InlineUIContainer>
                <Run Text="{Binding DisabledRelationCount, Mode=OneWay}" />
                <Run Text=")" />
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource State.WarningSoft}"
                BorderBrush="{DynamicResource State.Warning}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Padding="12,8"
                Margin="{DynamicResource Margin.StackItem}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <controls:SourcesListPanel Grid.Row="3"
                                   Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Padding="0"
                ClipToBounds="True"
                Visibility="{Binding IsGraphMode, Converter={StaticResource BoolToVisibility}}">
            <views:RelationsGraphPanel />
        </Border>
    </Grid>
</UserControl>
