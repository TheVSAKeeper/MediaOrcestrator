<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.SourcesRelationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourcesRelationsViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="{DynamicResource Margin.StackItem}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding AddSourceCommand}"
                        IsEnabled="{Binding HasPluginTypes}"
                        Padding="14,6"
                        Height="{DynamicResource Control.Height.Default}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Добавить источник"
                        ToolTip="Добавить новый источник">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Plus"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                        <TextBlock Text="Источник"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding AddRelationCommand}"
                        IsEnabled="{Binding HasAtLeastTwoSources}"
                        Padding="{DynamicResource Padding.Control}"
                        Height="{DynamicResource Control.Height.Default}"
                        Margin="0,0,12,0"
                        AutomationProperties.Name="Добавить связь"
                        ToolTip="Создать связь между двумя источниками">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Plus"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                        <TextBlock Text="Связь"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Segment}"
                                     GroupName="SourcesViewMode"
                                     IsChecked="{Binding IsListMode, Mode=TwoWay}"
                                     AutomationProperties.Name="Режим списка">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="LayoutGrid"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0" />
                                <TextBlock Text="Список"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RadioButton.Segment}"
                                     GroupName="SourcesViewMode"
                                     IsChecked="{Binding IsGraphMode, Mode=TwoWay}"
                                     AutomationProperties.Name="Режим графа">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Diamond"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0" />
                                <TextBlock Text="Граф"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           Text="{Binding SourceCount, Mode=OneWay, StringFormat='Источников: {0}'}" />
                <TextBlock Margin="4,0,0,0"
                           Text="{Binding DisabledSourceCount, Mode=OneWay, StringFormat='(выкл.: {0})'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlock.Subtle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisabledSourceCount}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0">
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           Text="{Binding RelationCount, Mode=OneWay, StringFormat='Связей: {0}'}" />
                <TextBlock Margin="4,0,0,0"
                           Text="{Binding DisabledRelationCount, Mode=OneWay, StringFormat='(выкл.: {0})'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlock.Subtle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisabledRelationCount}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource State.WarningSoft}"
                BorderBrush="{DynamicResource State.Warning}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Padding="12,8"
                Margin="{DynamicResource Margin.StackItem}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <controls:SourcesListPanel Grid.Row="3"
                                   Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Padding="0"
                ClipToBounds="True"
                Visibility="{Binding IsGraphMode, Converter={StaticResource BoolToVisibility}}">
            <views:RelationsGraphPanel />
        </Border>
    </Grid>
</UserControl>
