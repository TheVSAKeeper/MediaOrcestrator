<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Settings.UpdatesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Design"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=design:DesignSettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="340"
             d:DesignWidth="640">
    <HeaderedContentControl Style="{StaticResource Form.Panel}"
                            Header="Обновления"
                            keepshell:Form.ResetCommand="{Binding ResetSectionCommand}"
                            keepshell:Form.ResetCommandParameter="{Binding Reset[updates]}"
                            keepshell:Form.ResetHint="{Binding Reset[updates].Hint}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Репозиторий релизов"
                               Style="{StaticResource Form.Label}" />
                    <TextBlock Style="{StaticResource Form.Hint}"
                               Margin="0,2,0,0"
                               Text="В формате «владелец/репозиторий». Отсюда приложение тянет zip релиза и текст изменений; пустое поле откатывается к тому, что зашито в сборку." />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0"
                        DataContext="{Binding ResetFields[update_repo]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Updates.Repo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Margin="0,8,0,0"
                     MinWidth="200"
                     FontFamily="{DynamicResource Font.Mono}"
                     AutomationProperties.Name="Репозиторий GitHub, откуда берутся релизы" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Проверять обновления при запуске"
                          IsChecked="{Binding Updates.CheckOnStartup, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.update.check]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="В фоне спрашивает GitHub при старте окна. Выключите, чтобы проверять обновления только вручную." />

            <WrapPanel Margin="0,18,0,-8">
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding AppUpdate.CheckNowCommand}"
                        Content="Проверить сейчас"
                        Margin="0,0,10,8"
                        ToolTip="Спросить GitHub о свежем релизе прямо сейчас"
                        ToolTipService.ShowOnDisabled="True" />

                <Button Style="{StaticResource Button.Primary}"
                        Content="{Binding AppUpdate.VersionLabel}"
                        Command="{Binding AppUpdate.ShowDetailsCommand}"
                        Margin="0,0,12,8"
                        Visibility="{Binding AppUpdate.HasPendingUpdate, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Открыть описание релиза и установку обновления" />

                <TextBlock Text="{Binding AppUpdate.CheckStatus}"
                           Style="{StaticResource Form.Hint}"
                           Margin="0,0,0,8"
                           VerticalAlignment="Center"
                           Visibility="{Binding AppUpdate.HasCheckStatus, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,14,0,0">
                <iconPacks:PackIconLucide Kind="Package"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Foreground="{DynamicResource Fg.Muted}"
                                          AutomationProperties.Name="Установленная версия" />
                <TextBlock Text="{Binding AppUpdate.CurrentVersionText, StringFormat=Установлена версия {0}}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
