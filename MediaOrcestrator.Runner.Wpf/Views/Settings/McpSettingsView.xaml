<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Settings.McpSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Design"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=design:DesignSettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="720"
             d:DesignWidth="640">
    <HeaderedContentControl x:Name="McpSettingsCard"
                            Style="{StaticResource Form.Panel}"
                            Header="Управление через ИИ (MCP)"
                            keepshell:Form.ResetCommand="{Binding ResetSectionCommand}"
                            keepshell:Form.ResetCommandParameter="{Binding Reset[mcp]}"
                            keepshell:Form.ResetHint="{Binding Reset[mcp].Hint}">
        <StackPanel>
            <TextBlock Style="{StaticResource Form.Hint}"
                       Margin="0,0,0,0"
                       Text="Встроенный сервер на loopback: ИИ-помощник подключается к запущенному окну и видит то же, что вы – открытую страницу, дерево контролов, журнал, кадр. Нужен, только пока вы им пользуетесь, в обычной работе держите выключенным." />

            <CheckBox Content="Поднимать сервер"
                      IsChecked="{Binding Mcp.Enabled, Mode=TwoWay}"
                      Margin="0,14,0,0"
                      VerticalAlignment="Center" />

            <TextBlock Text="Порт"
                       Style="{StaticResource Form.Label}"
                       Margin="0,18,0,0" />
            <TextBox Text="{Binding Mcp.Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Margin="0,8,0,0"
                     HorizontalAlignment="Left"
                     MinWidth="120"
                     FontFamily="{DynamicResource Font.Mono}"
                     AutomationProperties.Name="Порт MCP-сервера" />
            <TextBlock Style="{StaticResource Form.Hint}"
                       Text="1024…65535, только 127.0.0.1. Смена порта применяется сразу – сервер перезапускается." />

            <TextBlock Text="Токен"
                       Style="{StaticResource Form.Label}"
                       Margin="0,18,0,0" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Mcp.Token, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}"
                         AutomationProperties.Name="Токен доступа MCP" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="8,0,0,0">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding Mcp.RegenerateTokenCommand}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="Перегенерировать токен"
                            ToolTip="Выдать новый токен – старые подключения отвалятся">
                        <iconPacks:PackIconLucide Kind="RefreshCw"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CopyMcpTokenCommand}"
                            AutomationProperties.Name="Скопировать токен"
                            ToolTip="Скопировать токен в буфер обмена">
                        <iconPacks:PackIconLucide Kind="Clipboard"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <CheckBox Content="Разрешить изменяющие операции"
                      IsChecked="{Binding Mcp.AllowMutations, Mode=TwoWay}"
                      Margin="0,18,0,0"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="Один флаг на всё: помощник сможет нажимать кнопки, вводить текст, закрывать приложение и запускать доменные операции. Без флага доступно только чтение." />

            <StackPanel Orientation="Horizontal"
                        Margin="0,18,0,0">
                <iconPacks:PackIconLucide Kind="Radio"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Foreground="{DynamicResource State.Success}"
                                          Visibility="{Binding McpServer.IsRunning, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="Сервер работает" />
                <TextBlock Text="{Binding McpStatusText}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding McpServer.LastError}"
                       Foreground="{DynamicResource State.Error}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding McpServer.LastError, Converter={StaticResource NullToVisibility}}" />

            <Border Padding="12,10"
                    Margin="0,14,0,0"
                    Background="{DynamicResource State.WarningSoft}"
                    BorderBrush="{DynamicResource State.Warning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Visibility="{Binding McpServer.IsElevated, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="TriangleAlert"
                                              Width="14"
                                              Height="14"
                                              Foreground="{DynamicResource State.Warning}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              AutomationProperties.Name="Внимание" />
                    <TextBlock Grid.Column="1"
                               Text="Приложение запущено с правами администратора, а токен лежит открытым текстом в settings.toml. Любой процесс под вашим пользователем получит админский доступ к окну."
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Строка подключения"
                               Style="{StaticResource Form.Label}" />
                    <TextBox Text="{Binding McpConnectSnippet, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,8,0,0"
                             MaxHeight="180"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource Font.Mono}"
                             FontSize="{DynamicResource Font.Size.S}"
                             AutomationProperties.Name="Строка подключения к MCP-серверу в формате JSON" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding CopyMcpConnectSnippetCommand}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Скопировать строку подключения"
                        ToolTip="Скопировать JSON для настроек помощника">
                    <iconPacks:PackIconLucide Kind="Clipboard"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Button>
            </Grid>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
