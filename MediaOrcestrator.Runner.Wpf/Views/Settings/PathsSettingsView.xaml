<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Settings.PathsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:design="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels.Design"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=design:DesignSettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="640"
             d:DesignWidth="640">
    <UserControl.Resources>
        <Style x:Key="DirtyDot"
               TargetType="Ellipse">
            <Setter Property="Width"
                    Value="8" />
            <Setter Property="Height"
                    Value="8" />
            <Setter Property="Fill"
                    Value="{DynamicResource Accent.Primary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="Visibility"
                    Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PathTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasErrors}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PathHintOrError"
               TargetType="TextBlock"
               BasedOn="{StaticResource Form.Hint}">
            <Setter Property="Text"
                    Value="{Binding Description}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasErrors}"
                             Value="True">
                    <Setter Property="Text"
                            Value="{Binding EditValueError}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                Header="Пути"
                                keepshell:Form.ResetCommand="{Binding ResetSectionCommand}"
                                keepshell:Form.ResetCommandParameter="{Binding Reset[paths]}"
                                keepshell:Form.ResetHint="{Binding Reset[paths].Hint}">
            <StackPanel>
                <TextBlock Style="{StaticResource Form.Hint}"
                           Margin="0,0,0,14"
                           Text="Системные пути приложения. Новые значения подхватываются только после перезапуска – DI привязывается к ним один раз на старте." />

                <ItemsControl ItemsSource="{Binding Paths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PathSettingViewModel}">
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource DirtyDot}" />
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Form.SectionTitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding BrowseCommand}"
                                            Padding="12,4"
                                            Height="{DynamicResource Control.Height.Default}"
                                            ToolTip="Открыть диалог выбора">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Folder"
                                                                      Width="16"
                                                                      Height="16"
                                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Обзор…"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         Style="{StaticResource PathTextBox}"
                                         Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Font.Size.S}" />

                                <TextBlock Grid.Row="2"
                                           Style="{StaticResource PathHintOrError}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="12,10"
                        Background="{DynamicResource State.WarningSoft}"
                        BorderBrush="{DynamicResource State.Warning}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="TriangleAlert"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource State.Warning}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  AutomationProperties.Name="Внимание" />
                        <TextBlock Text="Есть несохранённые изменения. Пути применятся после перезапуска."
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding RevertPathsCommand}"
                            Content="Отменить правки"
                            Margin="0,0,8,0"
                            ToolTip="Вернуть поля к тому, что уже лежит в settings.toml"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Style="{StaticResource Button.Base}"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"
                            Margin="0,0,8,0"
                            ToolTip="Записать пути в settings.toml без перезапуска"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveAndRestartCommand}"
                            Content="Сохранить и перезапустить"
                            ToolTip="Записать пути и перезапустить приложение, чтобы DI подхватил новые значения"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                Header="Файл настроек"
                                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SettingsFilePath}"
                               Style="{StaticResource TextBlock.Mono}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Form.Hint}"
                               Text="Формат TOML. Править руками можно, но системные пути удобнее через форму выше." />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CopySettingsPathCommand}"
                            Margin="0,0,0,4"
                            AutomationProperties.Name="Скопировать путь"
                            ToolTip="Скопировать путь в буфер обмена">
                        <iconPacks:PackIconLucide Kind="Clipboard"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding OpenSettingsFileCommand}"
                            AutomationProperties.Name="Показать в проводнике"
                            ToolTip="Показать файл в проводнике">
                        <iconPacks:PackIconLucide Kind="ExternalLink"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
