<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.ResolveConflictsSubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ResolveConflictsSubViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="1100"
             Loaded="OnLoaded">

    <UserControl.Resources>
        
        <Style x:Key="SourceBadge"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Bg.Surface}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding"
                    Value="6,1" />
            <Setter Property="Margin"
                    Value="0,0,4,2" />
        </Style>

        <Style x:Key="ConflictChoiceItem"
               TargetType="ListBoxItem">
            <Setter Property="Margin"
                    Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                     VerticalContentAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </RadioButton>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card.Inset}"
                Margin="{DynamicResource Margin.RowGap}"
                Padding="{DynamicResource Padding.Panel.Dense}">
            <StackPanel>
                <TextBlock Text="Дубликаты, где несколько медиа сидят на одном источнике. Автоматически слить нельзя – выберите целевое медиа и по каждому конфликтному источнику укажите, какую ссылку оставить."
                           Style="{StaticResource TextBlock.Subtle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <keepshell:StretchWrapPanel>
                    <controls:SourceFilterDropDown Label="Источники"
                                                   ItemsSource="{Binding Scope}"
                                                   CanEdit="{Binding CanEditParameters}"
                                                   SelectAllCommand="{Binding SelectAllScopeCommand}"
                                                   SelectNoneCommand="{Binding SelectNoScopeCommand}"
                                                   VerticalAlignment="Center"
                                                   Margin="{DynamicResource Margin.InlineGap}" />

                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding FindConflictsCommand}"
                            Padding="{DynamicResource Padding.Control}"
                            Margin="{DynamicResource Margin.InlineGap}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="RotateCw"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0" />
                            <TextBlock Text="Найти конфликты"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border keepshell:StretchWrapPanel.Stretch="True"
                            keepshell:StretchWrapPanel.StretchWidth="0" />

                    <CheckBox IsChecked="{Binding StopOnError}"
                              IsEnabled="{Binding CanEditParameters}"
                              VerticalAlignment="Center"
                              Margin="0,2,0,2"
                              Content="Прервать при ошибке" />
                </keepshell:StretchWrapPanel>
            </StackPanel>
        </Border>

        <controls:OperationResultPanel Grid.Row="1"
                                       ShowCompactToggle="False"
                                       SelectAllCommand="{Binding SelectAllGroupsCommand}"
                                       SelectNoneCommand="{Binding SelectNoGroupsCommand}"
                                       CanSelect="{Binding CanEditParameters}"
                                       JournalSource="{Binding Journal}"
                                       ClearJournalCommand="{Binding ClearJournalCommand}"
                                       IsJournalOpen="{Binding IsJournalOpen}"
                                       IsEmpty="{Binding IsResultEmpty}"
                                       IsLoading="{Binding IsSearching}"
                                       LoadingText="Поиск конфликтов…">
            <controls:OperationResultPanel.HeaderLeft>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </controls:OperationResultPanel.HeaderLeft>

            <controls:OperationResultPanel.EmptyContent>
                <keepshell:EmptyState VerticalAlignment="Center"
                                     Icon="Check"
                                     Heading="Конфликтных групп нет"
                                     Description="Отметьте источники выше и нажмите «Найти конфликты». Сюда попадают группы, где несколько медиа ссылаются на один источник – их нельзя слить автоматически."
                                     DescriptionMaxWidth="460" />
            </controls:OperationResultPanel.EmptyContent>

            <ItemsControl ItemsSource="{Binding Groups}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          VirtualizingPanel.CacheLength="1,1"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConflictGroupViewModel}">
                            <Border Style="{StaticResource Card.Inset}"
                                    Margin="{DynamicResource Margin.StackItem}">
                                <StackPanel>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsMergeChecked}"
                                                  IsEnabled="{Binding CanToggleCheck}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  ToolTip="Включить группу в пакетное объединение"
                                                  AutomationProperties.Name="Включить группу в объединение" />

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Headline}"
                                                       Style="{StaticResource TextBlock.Subtle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            
                                            <TextBlock Text="{Binding ResultText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding ResultText, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource State.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplyError}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource State.Error}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                                                <iconPacks:PackIconLucide Kind="Check"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource State.Success}" />
                                                <TextBlock Text="готово"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource State.Success}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsResolved, Converter={StaticResource InverseBoolToVisibility}}"
                                                        ToolTip="{Binding UnresolvedReason}">
                                                <iconPacks:PackIconLucide Kind="TriangleAlert"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource State.Warning}" />
                                                <TextBlock Text="требует разбора"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource State.Warning}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource Border.Subtle}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,8" />
                                    
                                    <ItemsControl ItemsSource="{Binding Medias}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ConflictMediaRowViewModel}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <RadioButton Grid.Column="0"
                                                                 GroupName="{Binding GroupKey}"
                                                                 IsChecked="{Binding IsTarget, Mode=TwoWay}"
                                                                 IsEnabled="{Binding CanBeTarget}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"
                                                                 Content="целевое"
                                                                 ToolTip="Это медиа сохранится, остальные присоединятся к нему" />

                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"
                                                              Content="не дубликат"
                                                              ToolTip="Исключить из объединения – оставить отдельным медиа" />

                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExcluded}"
                                                                                     Value="True">
                                                                            <Setter Property="Opacity"
                                                                                    Value="0.5" />
                                                                            <Setter Property="TextDecorations"
                                                                                    Value="Strikethrough" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ItemsControl ItemsSource="{Binding SourceBadges}"
                                                                      Margin="0,2,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource SourceBadge}">
                                                                        <TextBlock Text="{Binding}"
                                                                                   Style="{StaticResource TextBlock.Subtle}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Conflicts}"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ConflictSourceSlotViewModel}">
                                                <Border Background="{DynamicResource Bg.Surface}"
                                                        BorderBrush="{DynamicResource Border.Default}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.M}"
                                                        Padding="{DynamicResource Padding.Control}"
                                                        Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,4">
                                                            <iconPacks:PackIconLucide Kind="ArrowLeftRight"
                                                                                      Width="13"
                                                                                      Height="13"
                                                                                      VerticalAlignment="Center"
                                                                                      Foreground="{DynamicResource State.Warning}"
                                                                                      Margin="0,0,6,0" />
                                                            <TextBlock VerticalAlignment="Center">
                                                                <Run Text="Источник" />
                                                                <Run Text="{Binding SourceName, Mode=OneWay}"
                                                                     FontWeight="{DynamicResource Font.Weight.SemiBold}" />
                                                                <Run Text="– оставить:" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ListBox ItemsSource="{Binding Choices}"
                                                                 SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                 ItemContainerStyle="{StaticResource ConflictChoiceItem}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Padding="0"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ResultSummary}"
                                               Style="{StaticResource TextBlock.Subtle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </controls:OperationResultPanel>

        <controls:OperationActionBar Grid.Row="2"
                                     ApplyText="{Binding ApplyButtonText}"
                                     ApplyCommand="{Binding ApplyCommand}"
                                     CancelCommand="{Binding CancelCommand}"
                                     IsBusy="{Binding IsApplying}"
                                     ProgressValue="{Binding ProgressValue}"
                                     ProgressMax="{Binding ProgressMax}"
                                     ToggleJournalCommand="{Binding ToggleJournalCommand}">
            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center">
                <Run Text="Готово к объединению: " />
                <Run Text="{Binding ReadyGroups, Mode=OneWay}" />
                <Run Text=" · к удалению: " />
                <Run Text="{Binding MediasToRemove, Mode=OneWay}" />
            </TextBlock>
        </controls:OperationActionBar>
    </Grid>
</UserControl>
