<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.SourcesAuthenticationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:modules="clr-namespace:MediaOrcestrator.Modules;assembly=MediaOrcestrator.Modules"
             xmlns:views="clr-namespace:MediaOrcestrator.Runner.Wpf.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="SessionBadge">
            <Border x:Name="BadgeSurface" HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg.Secondary}" />
                        <Setter Property="TextElement.FontSize" Value="{DynamicResource Font.Size.Caption}" />
                    </Style>
                </Border.Style>
                <DockPanel>
                    <icons:PackIconLucide Kind="{Binding Icon}" Width="12" Height="12" Margin="0,0,5,0"
                                          Focusable="False"
                                          Foreground="{Binding (TextElement.Foreground), ElementName=BadgeSurface}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static modules:SourceAuthenticationStatus.Valid}">
                    <Setter TargetName="BadgeSurface" Property="Style" Value="{StaticResource Badge.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static modules:SourceAuthenticationStatus.Rejected}">
                    <Setter TargetName="BadgeSurface" Property="Style" Value="{StaticResource Badge.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static modules:SourceAuthenticationStatus.CheckFailed}">
                    <Setter TargetName="BadgeSurface" Property="Style" Value="{StaticResource Badge.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static modules:SourceAuthenticationStatus.SettingsRequired}">
                    <Setter TargetName="BadgeSurface" Property="Style" Value="{StaticResource Badge.Info}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SessionRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="2,0,0,1">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Bg.SurfaceMute}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="{DynamicResource Opacity.Muted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsQueueCurrent}" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource State.Info}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionAction" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="Действие станет доступно после текущего шага." />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MethodAction" TargetType="Button" BasedOn="{StaticResource SessionAction}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChangesAccount}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SummaryChip" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButton.Toolbar}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        </Style>
        <DataTemplate x:Key="SummaryFilters">
            <ItemsControl ItemsSource="{Binding Summary}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource SummaryChip}" Content="{Binding Text}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,4,2"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                      Command="{Binding DataContext.FilterByStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="{DynamicResource Margin.StackItem}"
                   Visibility="{Binding HasQueue, Converter={StaticResource InverseBoolToVisibility}}">
            <Button Style="{StaticResource Button.Primary}" Content="{Binding QueueButtonText}"
                    Command="{Binding StartQueueCommand}" AutomationProperties.HelpText="{Binding QueuePreview}"
                    ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0">
                <Button.ToolTip>
                    <TextBlock Text="{Binding QueuePreview}" TextWrapping="Wrap" MaxWidth="320" />
                </Button.ToolTip>
            </Button>
            <Button Style="{StaticResource Button.Secondary}" Content="Проверить все"
                    Command="{Binding DataContext.RefreshAuthenticationCommand, RelativeSource={RelativeSource AncestorType=views:SourcesRelationsView}}"
                    ToolTip="Обновить список и проверить включённые источники." Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Ghost}" ToolTip="Добавить источник"
                    AutomationProperties.Name="Добавить источник"
                    IsEnabled="{Binding CanOpenSourceSettings}"
                    Command="{Binding DataContext.AddSourceCommand, RelativeSource={RelativeSource AncestorType=views:SourcesRelationsView}}">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconLucide Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Источник" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <DockPanel LastChildFill="True"
                       Visibility="{Binding HasQueue, Converter={StaticResource InverseBoolToVisibility}}">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SummaryChip}"
                              IsChecked="{Binding AttentionOnly, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Top"
                              AutomationProperties.Name="Только источники, требующие внимания">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="SlidersHorizontal" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Требуют внимания" />
                    </StackPanel>
                </ToggleButton>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Отменить проверку"
                        Command="{Binding CancelChecksCommand}"
                        Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryFilters}"
                                    Visibility="{Binding IsSummaryCompact, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Expander Style="{StaticResource Expander.Section}" Header="{Binding CompactSummaryTitle}"
                              Visibility="{Binding IsSummaryCompact, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummaryFilters}" />
                    </Expander>
                </Grid>
            </DockPanel>
            <TextBlock Style="{StaticResource TextBlock.Subtle}" Text="Все источники выключены"
                       Visibility="{Binding AllSourcesDisabled, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Ghost}" Content="{Binding ReturnText}"
                    Command="{Binding ReturnToOperationCommand}" HorizontalAlignment="Left"
                    Visibility="{Binding ReturnText, Converter={StaticResource NullToVisibility}}" />
            <Border Style="{StaticResource Card.Error}" Margin="0,6,0,0"
                    Visibility="{Binding CatalogError, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding CatalogError}" TextWrapping="Wrap" />
            </Border>
            <Expander Style="{StaticResource Expander.Section}" Header="{Binding QueueSummaryTitle}" Margin="0,6,0,0"
                      Visibility="{Binding QueueSummaryTitle, Converter={StaticResource NullToVisibility}}">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </ScrollViewer>
            </Expander>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource Card.Inset}" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <controls:SpinningLoader Width="14" Height="14" Margin="0,0,8,0"
                                                 Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding QueueText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding QueueActionText}"
                                Command="{Binding ContinueQueueCommand}" Margin="0,0,6,0"
                                Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Пропустить"
                                Command="{Binding SkipCommand}" Margin="0,0,6,0"
                                Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Отменить шаг" Command="{Binding CancelStepCommand}"
                                Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Дальше без подтверждения"
                                Visibility="{Binding CanContinueWithoutConfirmation, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding FinishUnconfirmedCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Остановить"
                                AutomationProperties.Name="Остановить очередь входа" Command="{Binding StopQueueCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,8"
                       Visibility="{Binding StandaloneProgressText, Converter={StaticResource NullToVisibility}}">
                <controls:SpinningLoader Width="14" Height="14" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Отменить вход"
                        Command="{Binding SignInCancelCommand}"
                        Visibility="{Binding SignInCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Отменить вход"
                        Command="{Binding SignInWithMethodCancelCommand}"
                        Visibility="{Binding SignInWithMethodCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StandaloneProgressText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </StackPanel>

        <keepshell:EmptyState Grid.Row="3" VerticalAlignment="Center" Icon="KeyRound" Heading="{Binding EmptyText}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="3" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.M}"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Background="{DynamicResource Bg.SurfaceAlt}" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Источник и аккаунт" Style="{StaticResource TextBlock.Subtle}" Margin="12,7,6,7" />
                    <TextBlock Grid.Column="1" Text="Состояние сессии" Style="{StaticResource TextBlock.Subtle}" Margin="0,7,6,7" />
                    <TextBlock Grid.Column="2" Text="Действия" Style="{StaticResource TextBlock.Subtle}"
                               HorizontalAlignment="Right" Margin="0,7,14,7" />
                </Grid>
                <ListBox x:Name="SessionList" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         SelectionChanged="OnSelectionChanged" ItemContainerStyle="{StaticResource SessionRow}"
                         AutomationProperties.Name="Сессии источников" BorderThickness="0" Background="Transparent"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="10,7,10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding AccountText}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountText}"
                                                   Visibility="{Binding AccountText, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Text="{Binding PlatformText}" Style="{StaticResource TextBlock.Subtle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <ContentControl Content="{Binding StatusBadge}" ContentTemplate="{StaticResource SessionBadge}" />
                                        <ItemsControl ItemsSource="{Binding Methods}" Margin="0,3,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CompactText}" Style="{StaticResource TextBlock.Subtle}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding CheckedAt, StringFormat={}{0:dd.MM HH:mm}}" Style="{StaticResource TextBlock.Subtle}"
                                                   Visibility="{Binding CheckedAt, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" AutomationProperties.Name="{Binding DetailsAccessibleName}"
                                                ToolTip="{Binding DetailsAccessibleName}"
                                                Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                CommandParameter="{Binding}">
                                            <icons:PackIconLucide Kind="{Binding DetailsIcon}" Width="14" Height="14" />
                                        </Button>
                                        <Grid HorizontalAlignment="Right" Margin="0,0,3,0"
                                              Visibility="{Binding DataContext.HasQueue, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Button Style="{StaticResource SessionAction}"
                                                    AutomationProperties.Name="{Binding SignInAccessibleName}"
                                                    Visibility="{Binding ShowInlineSignIn, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.SignInCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding PrimarySignInText}" TextWrapping="Wrap" TextAlignment="Center" />
                                            </Button>
                                            <Button Style="{StaticResource SessionAction}" Content="Настроить"
                                                    AutomationProperties.Name="{Binding SettingsAccessibleName}"
                                                    Visibility="{Binding ShowInlineSettings, Converter={StaticResource BoolToVisibility}}"
                                                    IsEnabled="{Binding DataContext.CanOpenSourceSettings, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    Command="{Binding DataContext.EditAuthenticationSourceCommand, RelativeSource={RelativeSource AncestorType=views:SourcesRelationsView}}"
                                                    CommandParameter="{Binding Source}" />
                                            <Button Style="{StaticResource SessionAction}" Content="Проверить"
                                                    AutomationProperties.Name="{Binding CheckAccessibleName}"
                                                    Visibility="{Binding ShowInlineRetry, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DockPanel>
                                </Grid>

                                <Border Style="{StaticResource Card.Inset}" Padding="10,5" Margin="10,0,10,8"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LocalText}" Style="{StaticResource TextBlock.Subtle}" TextWrapping="Wrap"
                                                   Visibility="{Binding ShowLocalText, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Check.Detail}" Style="{StaticResource TextBlock.Subtle}" TextWrapping="Wrap"
                                                   Visibility="{Binding Check.Detail, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Text="{Binding LastSuccessfulCheck, StringFormat='Последнее подтверждение {0:dd.MM HH:mm}'}"
                                                   Style="{StaticResource TextBlock.Subtle}"
                                                   Visibility="{Binding LastSuccessfulCheck, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Text="{Binding SignInError}" Foreground="{DynamicResource State.ErrorText}" TextWrapping="Wrap"
                                                   Visibility="{Binding SignInError, Converter={StaticResource NullToVisibility}}" />
                                        <DockPanel Visibility="{Binding SignInNotice, Converter={StaticResource NullToVisibility}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Закрыть"
                                                    AutomationProperties.Name="Закрыть сообщение о входе"
                                                    Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding SignInNotice}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Methods}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Padding="8,5" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4*" />
                                                                <ColumnDefinition Width="3*" />
                                                                <ColumnDefinition Width="3*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Method.Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Method.Usage}" Style="{StaticResource TextBlock.Subtle}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap"
                                                                           Visibility="{Binding AccountText, Converter={StaticResource NullToVisibility}}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                                <ContentControl Content="{Binding Badge}" ContentTemplate="{StaticResource SessionBadge}" />
                                                                <TextBlock Text="{Binding Method.Detail}" Style="{StaticResource TextBlock.Subtle}" TextWrapping="Wrap"
                                                                           Visibility="{Binding Method.Detail, Converter={StaticResource NullToVisibility}}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource MethodAction}" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" AutomationProperties.Name="{Binding AccessibleAction}"
                                                                    Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}"
                                                                    Command="{Binding DataContext.SignInWithMethodCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" TextAlignment="Center" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource Button.Ghost}" Content="Проверить"
                                                    AutomationProperties.Name="{Binding CheckAccessibleName}"
                                                    Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource SessionAction}" Content="{Binding DetailsSignInText}"
                                                    AutomationProperties.Name="{Binding DetailsSignInAccessibleName}"
                                                    Visibility="{Binding ShowDetailsSignIn, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.SignInCommand, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Ghost}" Content="Настройки источника"
                                                    AutomationProperties.Name="{Binding SettingsAccessibleName}"
                                                    IsEnabled="{Binding DataContext.CanOpenSourceSettings, RelativeSource={RelativeSource AncestorType=views:SourcesAuthenticationView}}"
                                                    Command="{Binding DataContext.EditAuthenticationSourceCommand, RelativeSource={RelativeSource AncestorType=views:SourcesRelationsView}}"
                                                    CommandParameter="{Binding Source}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
