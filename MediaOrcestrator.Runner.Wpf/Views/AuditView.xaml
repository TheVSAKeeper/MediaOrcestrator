<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:conv="clr-namespace:MediaOrcestrator.Runner.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AuditViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="1000">
    <UserControl.Resources>

        <Style x:Key="SyncButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Base}">
            <Setter Property="Background"
                    Value="{DynamicResource Bg.Surface}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Default}" />
            <Setter Property="MinHeight"
                    Value="32" />
            <Setter Property="MinWidth"
                    Value="100" />
            <Setter Property="Padding"
                    Value="12,4" />
            <Setter Property="Margin"
                    Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card.Inset}"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Все источники"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource SyncButton}"
                                Command="{Binding SyncAllFullCommand}"
                                AutomationProperties.Name="Полная синхронизация всех источников"
                                ToolTip="Полная синхронизация по всем источникам">
                            <TextBlock Text="Полная" />
                        </Button>
                        <Button Style="{StaticResource SyncButton}"
                                Command="{Binding SyncAllQuickCommand}"
                                AutomationProperties.Name="Быстрая синхронизация всех источников"
                                ToolTip="Загружает список медиа без метаданных по всем источникам">
                            <TextBlock Text="Быстрая" />
                        </Button>
                        <Button Style="{StaticResource SyncButton}"
                                Command="{Binding SyncAllNewCommand}"
                                AutomationProperties.Name="Синхронизация новых медиа по всем источникам"
                                ToolTip="Синхронизирует до первого уже известного медиа по всем источникам">
                            <TextBlock Text="Новые" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource Badge}"
                            Background="{DynamicResource Accent.Soft}"
                            VerticalAlignment="Center"
                            ToolTip="Источники запускаются независимо. Bulk-кнопки выше блокируются, пока есть активные per-source запуски."
                            Visibility="{Binding HasActiveSources, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveSourcesText}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,8,0,0"
                      Visibility="{Binding HasBulkProgress, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource TextBlock.Subtle}"
                               Text="Прогресс:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding BulkProgressMessage}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding BulkProgressMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TextBlock.Subtle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBulkError}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource State.Error}" />
                                        <Setter Property="FontWeight"
                                                Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource Card}"
                    Padding="0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Sources}"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLengthUnit="Page"
                                  VirtualizingPanel.CacheLength="1,2">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="12">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="{DynamicResource Margin.StackItem}"
                                            Padding="14,12"
                                            Background="{DynamicResource Bg.SurfaceAlt}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.M}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Border.Subtle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Accent.Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource State.Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Orientation="Vertical">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{DynamicResource Font.Size.L}"
                                                               VerticalAlignment="Center"
                                                               MaxWidth="380"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,0,10,0" />
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource Badge}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeId}"
                                                                   Style="{StaticResource TextBlock.Subtle}" />
                                                    </Border>
                                                    <Border Grid.Column="2"
                                                            Style="{StaticResource Badge}"
                                                            Background="{DynamicResource State.Error}"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="плагин не найден"
                                                                   Foreground="{DynamicResource Fg.OnAccent}"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4,0,0"
                                                      MinHeight="18">
                                                    <TextBlock Text="{Binding LastSyncText}"
                                                               Style="{StaticResource TextBlock.Subtle}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasProgress, Converter={StaticResource InverseBoolToVisibility}}" />

                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:SpinningLoader Width="13"
                                                                                 Height="13"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,8,0"
                                                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="Прогресс:"
                                                                   Style="{StaticResource TextBlock.Subtle}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <TextBlock Text="{Binding ProgressMessage}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="{Binding ProgressMessage}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource TextBlock.Subtle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource Accent.Primary}" />
                                                                            <Setter Property="FontStyle"
                                                                                    Value="Italic" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasError}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource State.Error}" />
                                                                            <Setter Property="FontWeight"
                                                                                    Value="SemiBold" />
                                                                            <Setter Property="FontStyle"
                                                                                    Value="Normal" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0,0,0">
                                                <Button Style="{StaticResource SyncButton}"
                                                        Command="{Binding SyncFullCommand}"
                                                        AutomationProperties.Name="Полная синхронизация источника"
                                                        ToolTip="Полное перечитывание всех медиа источника">
                                                    <TextBlock Text="Полная" />
                                                </Button>
                                                <Button Style="{StaticResource SyncButton}"
                                                        Command="{Binding SyncQuickCommand}"
                                                        AutomationProperties.Name="Быстрая синхронизация источника"
                                                        ToolTip="Загружает список медиа без метаданных">
                                                    <TextBlock Text="Быстрая" />
                                                </Button>
                                                <Button Style="{StaticResource SyncButton}"
                                                        Command="{Binding SyncNewCommand}"
                                                        AutomationProperties.Name="Синхронизация новых медиа источника"
                                                        ToolTip="Синхронизирует до первого уже известного медиа">
                                                    <TextBlock Text="Новые" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <keepshell:EmptyState VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Description="{Binding EmptyHint}"
                                         DescriptionMaxWidth="420"
                                         Visibility="{Binding EmptyHint, Converter={StaticResource NullToVisibility}}" />

                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Fill="{DynamicResource Bg.Surface}"
                                   Opacity="0.7" />
                        <TextBlock Text="Загрузка…"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource TextBlock.Subtle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
