<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Media.MediaInspectorMultiContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MediaViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MediaOrcestrator.Runner.Wpf;component/Views/Media/MediaInspectorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Padding="10,10"
            Margin="0,0,0,12"
            Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="ListChecks"
                                          Width="18"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Accent.Primary}" />
                <TextBlock Text="{Binding Grid.SelectedSummaryText}"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Действия ниже применятся ко всем выделенным медиа."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <TextBlock Text="{Binding Grid.MultiSummaryText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Grid.MultiStatusBreakdown}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Ghost}"
                                Margin="0,0,6,6"
                                Padding="8,3"
                                IsEnabled="{Binding CanFilter}"
                                Command="{Binding DataContext.Grid.FocusStatusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding StatusId}"
                                ToolTip="{Binding Label}"
                                AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                                          Foreground="{Binding Brush}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Count}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="По площадкам"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,8,0,4" />
            <ItemsControl ItemsSource="{Binding Grid.MultiSourceTallies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SourceTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CountText}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextBlock.Subtle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding Grid.ClearSelectionCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="X"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Снять выделение"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
