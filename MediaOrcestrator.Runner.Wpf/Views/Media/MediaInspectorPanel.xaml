<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Media.MediaInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MediaOrcestrator.Runner.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MediaViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="480">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="PanelActionTemplate">
            <Grid>
                <Border Height="1"
                        Margin="4,5"
                        Background="{DynamicResource Border.Subtle}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}}" />

                <Expander Margin="0,1"
                          Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{Binding IconOrDefault}"
                                                      Foreground="{Binding GlyphBrush}"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Children}"
                                  Margin="14,2,0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding Command}"
                                        IsEnabled="{Binding IsEnabled}"
                                        ToolTip="{Binding Tooltip}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,1"
                                        Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="{Binding IconOrDefault}"
                                                                  Foreground="{Binding GlyphBrush}"
                                                                  Width="14"
                                                                  Height="14"
                                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}"
                        ToolTip="{Binding Tooltip}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,1"
                        Padding="8,5"
                        Visibility="{Binding IsLeaf, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{Binding IconOrDefault}"
                                                  Foreground="{Binding GlyphBrush}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionChildTemplate">
            <Button Style="{StaticResource Button.Ghost}"
                    Command="{Binding Command}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding Tooltip}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="0,1"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{Binding IconOrDefault}"
                                      Foreground="{Binding GlyphBrush}"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PrimaryActionTemplate">
            <Grid Margin="0,0,4,4">
                
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding First.Command}"
                        IsEnabled="{Binding First.IsEnabled}"
                        Padding="8,6"
                        ToolTip="{Binding Label}"
                        AutomationProperties.Name="{Binding Label}"
                        Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                      Foreground="{Binding Brush}"
                                      Width="16"
                                      Height="16" />
                </Button>

                <Grid Visibility="{Binding IsSingle, Converter={StaticResource InverseBoolToVisibility}}">
                    <ToggleButton x:Name="SubToggle"
                                  Style="{StaticResource ToggleButton.Toolbar}"
                                  Padding="8,6"
                                  ToolTip="{Binding Label}"
                                  AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                              Foreground="{Binding Brush}"
                                              Width="16"
                                              Height="16" />
                            <iconPacks:PackIconLucide Kind="ChevronDown"
                                              Width="10"
                                              Height="10"
                                              Margin="3,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=SubToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SubToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.L}"
                                Padding="4"
                                Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Choices}"
                                          ItemTemplate="{StaticResource ActionChildTemplate}"
                                          MinWidth="160" />
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RailActionTemplate">
            <Grid Margin="0,0,0,4"
                  HorizontalAlignment="Center">
                
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding First.Command}"
                        IsEnabled="{Binding First.IsEnabled}"
                        Padding="6,6"
                        ToolTip="{Binding Label}"
                        AutomationProperties.Name="{Binding Label}"
                        Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                      Foreground="{Binding Brush}"
                                      Width="16"
                                      Height="16" />
                </Button>

                <Grid Visibility="{Binding IsSingle, Converter={StaticResource InverseBoolToVisibility}}">
                    <ToggleButton x:Name="RailSubToggle"
                                  Style="{StaticResource ToggleButton.Toolbar}"
                                  Padding="6,6"
                                  ToolTip="{Binding Label}"
                                  AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                              Foreground="{Binding Brush}"
                                              Width="16"
                                              Height="16" />
                            <iconPacks:PackIconLucide Kind="ChevronLeft"
                                              Width="9"
                                              Height="9"
                                              Margin="2,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=RailSubToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=RailSubToggle}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.L}"
                                Padding="4"
                                Margin="0,0,4,0">
                            <ItemsControl ItemsSource="{Binding Choices}"
                                          ItemTemplate="{StaticResource ActionChildTemplate}"
                                          MinWidth="160" />
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="InspectorBorder"
            Margin="6,0,0,0"
            Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}">
        <Grid>
            
            <StackPanel Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button x:Name="RailExpandButton"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding ToggleInspectorCollapsedCommand}"
                        Padding="6,6"
                        ToolTip="Развернуть панель деталей"
                        AutomationProperties.Name="Развернуть панель деталей">
                    <iconPacks:PackIconLucide Kind="PanelRightOpen"
                                      Width="16"
                                      Height="16" />
                </Button>

                <TextBlock Text="Детали"
                           Style="{StaticResource TextBlock.Subtle}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding Grid.HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Grid.Focused.StatusHistogram}"
                              Margin="0,10,0,0"
                              Visibility="{Binding Grid.IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4"
                                    Padding="6,2"
                                    Background="{DynamicResource Bg.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    ToolTip="{Binding Label}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                                              Foreground="{Binding Brush}"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Count}"
                                               Margin="3,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource Font.Size.Caption}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,8,0,0"
                        Padding="6,2"
                        Background="{DynamicResource Accent.Soft}"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        HorizontalAlignment="Center"
                        ToolTip="{Binding Grid.SelectedSummaryText}"
                        AutomationProperties.Name="{Binding Grid.SelectedSummaryText}"
                        Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Grid.SelectedCount, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource Font.Size.Caption}" />
                </Border>

                <Border Margin="0,10,0,0"
                        Width="22"
                        Height="1"
                        Background="{DynamicResource Border.Subtle}"
                        Visibility="{Binding Grid.HasPrimaryActions, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Grid.PrimaryActionGroups}"
                              ItemTemplate="{StaticResource RailActionTemplate}"
                              Margin="0,8,0,0"
                              Visibility="{Binding Grid.HasPrimaryActions, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Grid Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="14,12,6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Grid.PanelTitle}"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Tag="{Binding Inspector}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать"
                                          Command="{Binding PlacementTarget.Tag.CopyTitleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <Button x:Name="HeaderCollapseButton"
                            Grid.Column="1"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ToggleInspectorCollapsedCommand}"
                            Padding="8,2"
                            VerticalAlignment="Top"
                            ToolTip="Свернуть панель"
                            AutomationProperties.Name="Свернуть панель деталей">
                        <iconPacks:PackIconLucide Kind="PanelRightClose"
                                          Width="16"
                                          Height="16" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="14,0,14,14"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Grid.IsHelpVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Как работать с матрицей"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,0,0,8" />
                        <Border Style="{StaticResource Card.Inset}"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <controls:HintRow Icon="Search"
                                                  Text="Поиск – по названию, ID и подписи на площадках." />
                                <controls:HintRow Margin="0,6,0,0"
                                                  Icon="ListFilter"
                                                  Text="Фильтры – источники, статусы и связи. Связи показывают медиа из выбранных пар синхронизации." />
                                <controls:HintRow Margin="0,6,0,0"
                                                  Icon="Columns3"
                                                  Text="Колонки – добавьте столбцы метаданных (длительность, размер, дата и др.)." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Inset}"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <controls:HintRow Icon="MousePointerClick"
                                                  Text="Клик по строке – детали медиа здесь же." />
                                <controls:HintRow Margin="0,6,0,0"
                                                  Icon="MousePointerClick"
                                                  Text="Выделение нескольких строк (Ctrl/Shift) – пакетные действия." />
                                <controls:HintRow Margin="0,6,0,0"
                                                  Icon="MousePointerClick"
                                                  Text="Правый клик – контекстное меню; те же действия дублируются ниже в этой панели." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Inset}"
                                Padding="10,8">
                            <StackPanel>
                                <controls:HintRow Icon="Wrench"
                                                  Text="«Открыть в Операциях» – пакетное переименование, обложки и слияние дубликатов с выделенным набором." />
                                <controls:HintRow Margin="0,6,0,0"
                                                  Icon="ArrowLeftRight"
                                                  Text="Перетащите левый край панели, чтобы изменить ширину; кнопкой в шапке – свернуть в рейку." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              Padding="14,0,14,14"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Grid.IsSelectionVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding Grid.PrimaryActionGroups}"
                                      ItemTemplate="{StaticResource PrimaryActionTemplate}"
                                      Margin="0,4,0,10"
                                      Visibility="{Binding Grid.HasPrimaryActions, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Style="{StaticResource Card.Inset}"
                                Padding="10,10"
                                Margin="0,0,0,12"
                                Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ListChecks"
                                                      Width="18"
                                                      Height="18"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock Text="{Binding Grid.SelectedSummaryText}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Действия ниже применятся ко всем выделенным медиа."
                                           Style="{StaticResource TextBlock.Subtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <TextBlock Text="{Binding Grid.MultiSummaryText}"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding Grid.MultiStatusBreakdown}"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Margin="0,0,6,6"
                                                    Padding="8,3"
                                                    IsEnabled="{Binding CanFilter}"
                                                    Command="{Binding DataContext.Grid.FocusStatusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding StatusId}"
                                                    ToolTip="{Binding Label}"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                                                              Foreground="{Binding Brush}"
                                                                              Width="14"
                                                                              Height="14"
                                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Count}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="По площадкам"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding Grid.MultiSourceTallies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SourceTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CountText}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource TextBlock.Subtle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding Grid.ClearSelectionCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="X"
                                                          Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Center" />
                                        <TextBlock Text="Снять выделение"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PreviewHost"
                                Padding="0"
                                Margin="0,0,0,12"
                                ContextMenuService.IsEnabled="{Binding Inspector.HasMultiplePreviews}"
                                Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            
                            <Border.Style>
                                <Style TargetType="Border"
                                       BasedOn="{StaticResource Card.Inset}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Inspector.HasMultiplePreviews}"
                                                     Value="True">
                                            <Setter Property="ToolTip"
                                                    Value="Правый клик – выбрать источник превью" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             ItemsSource="{Binding Inspector.PreviewSources}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem"
                                               BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.Inspector.SetPreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter"
                                                    Value="{Binding}" />
                                            <Setter Property="HeaderTemplate">
                                                <Setter.Value>
                                                    <DataTemplate DataType="{x:Type vm:MediaPreviewSource}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconLucide Kind="Check"
                                                                                      Width="13"
                                                                                      Height="13"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center">
                                                                <iconPacks:PackIconLucide.Style>
                                                                    <Style TargetType="iconPacks:PackIconLucide">
                                                                        <Setter Property="Visibility"
                                                                                Value="Hidden" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                                         Value="True">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </iconPacks:PackIconLucide.Style>
                                                            </iconPacks:PackIconLucide>
                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <keepshell:AspectRatioPanel Ratio="0.5625"
                                                       CornerRadius="{DynamicResource Radius.M}">
                                <Grid>
                                    
                                    <Image Source="{Binding Inspector.PreviewImage, NotifyOnTargetUpdated=True}"
                                           Stretch="UniformToFill"
                                           TargetUpdated="OnPreviewImageTargetUpdated"
                                           Visibility="{Binding Inspector.HasPreviewImage, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Inspector.IsPreviewLoading, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Width="28"
                                              Height="28"
                                              HorizontalAlignment="Center"
                                              AutomationProperties.Name="Загрузка превью">
                                            <Ellipse Stroke="{DynamicResource Border.Subtle}"
                                                     StrokeThickness="3"
                                                     Fill="Transparent" />
                                            <Path StrokeThickness="3"
                                                  Stroke="{DynamicResource Accent.Primary}"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Data="M 14 1.5 A 12.5 12.5 0 0 1 26 11"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}"
                                                                               Value="True" />
                                                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"
                                                                               Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SpinPreviewLoading">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0"
                                                                                             To="360"
                                                                                             Duration="0:0:1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SpinPreviewLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                        <TextBlock Text="загрузка…"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlock.Subtle}" />
                                    </StackPanel>

                                    <TextBlock Text="нет превью"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource TextBlock.Subtle}"
                                               Visibility="{Binding Inspector.ShowNoPreview, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </keepshell:AspectRatioPanel>
                        </Border>

                        <Border Style="{StaticResource Card.Inset}"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Grid.Focused.StatusSummaryText}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,6,0,0"
                                            Visibility="{Binding Grid.Focused.HasMissing, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Отсутствует на"
                                               Style="{StaticResource TextBlock.Subtle}"
                                               Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Grid.Focused.MissingCells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,6"
                                                        Padding="8,3"
                                                        Background="{DynamicResource Bg.SurfaceAlt}"
                                                        CornerRadius="{DynamicResource Radius.Pill}"
                                                        ToolTip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Source.Title}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Источники"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           VerticalAlignment="Center" />
                                
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource ToggleButton.Toolbar}"
                                              IsChecked="{Binding Inspector.AreSourcesCompact, Mode=TwoWay}"
                                              Height="20"
                                              MinHeight="0"
                                              Padding="4,0"
                                              VerticalAlignment="Center"
                                              ToolTip="Компактный вид источников – пилюли в строку, статус цветом"
                                              AutomationProperties.Name="Компактный вид источников"
                                              Visibility="{Binding Inspector.HasSources, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconLucide Kind="Rows3"
                                                      Width="12"
                                                      Height="12"
                                                      VerticalAlignment="Center" />
                                </ToggleButton>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Inspector.Sources}"
                                          Visibility="{Binding Inspector.AreSourcesCompact, Converter={StaticResource InverseBoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card.Inset}"
                                                Margin="0,3,0,3"
                                                Padding="6,4">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <iconPacks:PackIconLucide Grid.Column="0"
                                                                      Kind="{Binding StatusIcon}"
                                                                      Foreground="{Binding StatusBrush}"
                                                                      Width="16"
                                                                      Height="16"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="{Binding StatusText}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SourceTitle}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Command="{Binding DataContext.Inspector.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanOpen}"
                                                            Padding="6,2"
                                                            Margin="6,0,0,0"
                                                            ToolTip="Открыть в источнике"
                                                            AutomationProperties.Name="Открыть в источнике">
                                                        <iconPacks:PackIconLucide Kind="ExternalLink"
                                                                          Width="14"
                                                                          Height="14" />
                                                    </Button>
                                                </Grid>

                                                <TextBlock Text="{Binding LinkTitle}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding LinkTitle, Converter={StaticResource NullToVisibility}}" />

                                                <Grid Margin="0,4,0,0"
                                                      Visibility="{Binding ExternalId, Converter={StaticResource NullToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="ID:"
                                                               Style="{StaticResource TextBlock.Subtle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ExternalId}"
                                                               Style="{StaticResource TextBlock.Subtle}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExternalId}"
                                                               Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Копировать ID"
                                                                          Command="{Binding PlacementTarget.Tag.CopyExternalIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Inspector.Sources}"
                                          Visibility="{Binding Inspector.AreSourcesCompact, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3,0"
                                                Padding="8,6"
                                                CornerRadius="{DynamicResource Radius.M}"
                                                BorderThickness="1"
                                                BorderBrush="{Binding StatusBrush}"
                                                Background="{DynamicResource Bg.SurfaceAlt}"
                                                ToolTip="{Binding StatusText}"
                                                Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Открыть в источнике"
                                                              Command="{Binding PlacementTarget.Tag.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              IsEnabled="{Binding PlacementTarget.DataContext.CanOpen, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock Text="{Binding SourceTitle}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0,1,0,0"
                                Margin="0,12,0,8"
                                Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Expander IsExpanded="True"
                                  Margin="0,4"
                                  Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Пользовательские"
                                               VerticalAlignment="Center" />
                                    <Border Margin="6,0,0,0"
                                            Padding="6,1"
                                            Background="{DynamicResource Accent.Soft}"
                                            CornerRadius="{DynamicResource Radius.Pill}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Inspector.HasUserMetadata, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Inspector.UserMetadataCount, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font.Size.Caption}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,2,0,8"
                                      Visibility="{Binding Inspector.HasDescription, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="Описание"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Inspector.Description}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,4"
                                               Tag="{Binding Inspector}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Копировать"
                                                          Command="{Binding PlacementTarget.Tag.CopyDescriptionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Inspector.UserMetadataGroups}"
                                              Visibility="{Binding Inspector.HasUserMetadata, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,8">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="6,2,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding SourceTitle, TargetNullValue=Общее, FallbackValue=Общее}"
                                                                           Style="{StaticResource TextBlock.Subtle}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           ToolTip="{Binding Value}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="170"
                                                                           VerticalAlignment="Center"
                                                                           Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                    <TextBlock.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Копировать значение"
                                                                                      Command="{Binding PlacementTarget.Tag.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                            <MenuItem Header="Копировать целиком"
                                                                                      Command="{Binding PlacementTarget.Tag.CopyItemFormattedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        </ContextMenu>
                                                                    </TextBlock.ContextMenu>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0,4"
                                           Text="нет пользовательских полей">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource TextBlock.Subtle}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Inspector.HasUserMetadata}"
                                                                   Value="False" />
                                                        <Condition Binding="{Binding Inspector.HasDescription}"
                                                                   Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander IsExpanded="False"
                                  Margin="0,4"
                                  Visibility="{Binding Inspector.HasSystemMetadata, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Системные"
                                               VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Badge.Count}"
                                            Margin="6,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Inspector.SystemMetadataCount, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font.Size.Caption}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Inspector.SystemMetadata}"
                                          Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource TextBlock.Subtle}" />
                                                <TextBlock Text="{Binding SourceTitle}"
                                                           Style="{StaticResource TextBlock.Subtle}"
                                                           FontSize="{DynamicResource Font.Size.XS}"
                                                           Opacity="0.7"
                                                           Visibility="{Binding SourceTitle, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       ToolTip="{Binding Value}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="180"
                                                       VerticalAlignment="Center"
                                                       Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Копировать значение"
                                                                  Command="{Binding PlacementTarget.Tag.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Копировать целиком"
                                                                  Command="{Binding PlacementTarget.Tag.CopyItemFormattedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding Inspector.CopyDetailsCommand}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Clipboard"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,6,0" />
                                <TextBlock Text="Копировать детали"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding Grid.HasPanelActions, Converter={StaticResource BoolToVisibility}}">
                            <Border BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,14,0,8" />
                            <TextBlock Text="Действия"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Grid.PanelActionItems}"
                                          ItemTemplate="{StaticResource PanelActionTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
