<UserControl x:Class="MediaOrcestrator.Runner.Wpf.Views.Media.MediaInspectorSingleContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrcestrator.Runner.Wpf.ViewModels"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MediaViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MediaOrcestrator.Runner.Wpf;component/Views/Media/MediaInspectorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding Inspector.IsMultiSelection, Converter={StaticResource InverseBoolToVisibility}}">
        <Border x:Name="PreviewHost"
                Padding="0"
                Margin="0,0,0,12"
                ContextMenuService.IsEnabled="{Binding Inspector.HasMultiplePreviews}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card.Inset}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Inspector.HasMultiplePreviews}" Value="True">
                            <Setter Property="ToolTip" Value="Правый клик – выбрать источник превью" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             ItemsSource="{Binding Inspector.PreviewSources}">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Command" Value="{Binding DataContext.Inspector.SetPreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate DataType="{x:Type vm:MediaPreviewSource}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Check" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <iconPacks:PackIconLucide.Style>
                                                    <Style TargetType="iconPacks:PackIconLucide">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconLucide.Style>
                                            </iconPacks:PackIconLucide>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                </ContextMenu>
            </Border.ContextMenu>
            <keepshell:AspectRatioPanel Ratio="0.5625" CornerRadius="{DynamicResource Radius.M}">
                <Grid>
                    <Image Source="{Binding Inspector.PreviewImage, NotifyOnTargetUpdated=True}"
                           Stretch="UniformToFill"
                           TargetUpdated="OnPreviewImageTargetUpdated"
                           Visibility="{Binding Inspector.HasPreviewImage, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Inspector.IsPreviewLoading, Converter={StaticResource BoolToVisibility}}">
                        <Grid Width="28" Height="28" HorizontalAlignment="Center" AutomationProperties.Name="Загрузка превью">
                            <Ellipse Stroke="{DynamicResource Border.Subtle}" StrokeThickness="3" Fill="Transparent" />
                            <Path StrokeThickness="3"
                                  Stroke="{DynamicResource Accent.Primary}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M 14 1.5 A 12.5 12.5 0 0 1 26 11"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinPreviewLoading">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="SpinPreviewLoading" />
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        <TextBlock Text="загрузка…" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource TextBlock.Subtle}" />
                    </StackPanel>

                    <TextBlock Text="нет превью"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextBlock.Subtle}"
                               Visibility="{Binding Inspector.ShowNoPreview, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </keepshell:AspectRatioPanel>
        </Border>

        <Border Style="{StaticResource Card.Inset}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding Grid.Focused.StatusSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Margin="0,6,0,0" Visibility="{Binding Grid.Focused.HasMissing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Отсутствует на" Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Grid.Focused.MissingCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6" Padding="8,3" Background="{DynamicResource Bg.SurfaceAlt}"
                                        CornerRadius="{DynamicResource Radius.Pill}" ToolTip="{Binding Tooltip}">
                                    <TextBlock Text="{Binding Source.Title}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Источники" Style="{StaticResource TextBlock.Subtle}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              IsChecked="{Binding Inspector.AreSourcesCompact, Mode=TwoWay}"
                              Height="20" MinHeight="0" Padding="4,0" VerticalAlignment="Center"
                              ToolTip="Компактный вид источников – пилюли в строку, статус цветом"
                              AutomationProperties.Name="Компактный вид источников"
                              Visibility="{Binding Inspector.HasSources, Converter={StaticResource BoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="Rows3" Width="12" Height="12" VerticalAlignment="Center" />
                </ToggleButton>
            </Grid>

            <ItemsControl ItemsSource="{Binding Inspector.Sources}"
                          Visibility="{Binding Inspector.AreSourcesCompact, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Inset}" Margin="0,3,0,3" Padding="6,4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconLucide Grid.Column="0" Kind="{Binding StatusIcon}" Foreground="{Binding StatusBrush}"
                                                              Width="16" Height="16" VerticalAlignment="Center" ToolTip="{Binding StatusText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SourceTitle}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DataContext.Inspector.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanOpen}"
                                            Padding="6,2" Margin="6,0,0,0"
                                            ToolTip="Открыть в источнике"
                                            AutomationProperties.Name="Открыть в источнике">
                                        <iconPacks:PackIconLucide Kind="ExternalLink" Width="14" Height="14" />
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding LinkTitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding LinkTitle, Converter={StaticResource NullToVisibility}}" />

                                <Grid Margin="0,4,0,0" Visibility="{Binding ExternalId, Converter={StaticResource NullToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ID:" Style="{StaticResource TextBlock.Subtle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ExternalId}" Style="{StaticResource TextBlock.Subtle}"
                                               Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExternalId}"
                                               Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Копировать ID"
                                                          Command="{Binding PlacementTarget.Tag.CopyExternalIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Inspector.Sources}"
                          Visibility="{Binding Inspector.AreSourcesCompact, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3,0" Padding="8,6" CornerRadius="{DynamicResource Radius.M}" BorderThickness="1"
                                BorderBrush="{Binding StatusBrush}" Background="{DynamicResource Bg.SurfaceAlt}"
                                ToolTip="{Binding StatusText}"
                                Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Открыть в источнике"
                                              Command="{Binding PlacementTarget.Tag.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.CanOpen, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,12,0,8" />

        <Expander IsExpanded="True" Margin="0,4">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пользовательские" VerticalAlignment="Center" />
                    <Border Margin="6,0,0,0" Padding="6,1" Background="{DynamicResource Accent.Soft}"
                            CornerRadius="{DynamicResource Radius.Pill}" VerticalAlignment="Center"
                            Visibility="{Binding Inspector.HasUserMetadata, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Inspector.UserMetadataCount, Mode=OneWay}"
                                   FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,6,0,0">
                <Grid Margin="0,2,0,8" Visibility="{Binding Inspector.HasDescription, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Описание" Style="{StaticResource TextBlock.Subtle}" />
                    <TextBlock Grid.Row="1" Text="{Binding Inspector.Description}" TextWrapping="Wrap"
                               Margin="0,2,0,4" Tag="{Binding Inspector}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать"
                                          Command="{Binding PlacementTarget.Tag.CopyDescriptionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </Grid>

                <ItemsControl ItemsSource="{Binding Inspector.UserMetadataGroups}"
                              Visibility="{Binding Inspector.HasUserMetadata, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SourceTitle, TargetNullValue=Общее, FallbackValue=Общее}"
                                                           Style="{StaticResource TextBlock.Subtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" ToolTip="{Binding Value}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center"
                                                           Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Копировать значение"
                                                                      Command="{Binding PlacementTarget.Tag.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="Копировать целиком"
                                                                      Command="{Binding PlacementTarget.Tag.CopyItemFormattedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,4" Text="нет пользовательских полей">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Subtle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Inspector.HasUserMetadata}" Value="False" />
                                        <Condition Binding="{Binding Inspector.HasDescription}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Expander>

        <Expander IsExpanded="False" Margin="0,4"
                  Visibility="{Binding Inspector.HasSystemMetadata, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Системные" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge.Count}" Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Inspector.SystemMetadataCount, Mode=OneWay}"
                                   FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Inspector.SystemMetadata}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TextBlock.Subtle}" />
                                <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource TextBlock.Subtle}"
                                           FontSize="{DynamicResource Font.Size.XS}" Opacity="0.7"
                                           Visibility="{Binding SourceTitle, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" ToolTip="{Binding Value}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center"
                                       Tag="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Копировать значение"
                                                  Command="{Binding PlacementTarget.Tag.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Копировать целиком"
                                                  Command="{Binding PlacementTarget.Tag.CopyItemFormattedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <Button Style="{StaticResource Button.Ghost}"
                Command="{Binding Inspector.CopyDetailsCommand}"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="Clipboard" Width="16" Height="16" Margin="0,0,6,0" />
                <TextBlock Text="Копировать детали" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
