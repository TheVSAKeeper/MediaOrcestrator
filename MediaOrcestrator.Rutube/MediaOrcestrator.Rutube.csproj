<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaOrcestrator.Domain.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaOrcestrator.Modules\MediaOrcestrator.Modules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.6.6" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyBuildResults" AfterTargets="Build">
    <PropertyGroup>
      <TargetFolder>..\ModuleBuilds\rutube\</TargetFolder>
    </PropertyGroup>
    <ItemGroup>
      <AllBuildFiles Include="$(OutputPath)**\*.dll;$(OutputPath)**\*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(TargetFolder)" Condition="!Exists('$(TargetFolder)')" />
    <Copy SourceFiles="@(AllBuildFiles)" DestinationFolder="$(TargetFolder)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="✅ Все файлы сборки $(AssemblyName) скопированы в $(TargetFolder)" Importance="high" />
  </Target>
</Project>
