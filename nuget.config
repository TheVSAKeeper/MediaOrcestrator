<?xml version="1.0" encoding="utf-8"?>
<!--
  Источники пакетов для воспроизводимого restore. keepshell-local — локальный feed каркаса:
  .nupkg каркаса лежат в ./packages прямо в репозитории (офлайн, пиннинг версией пакета).
  Обновление: в репозитории каркаса `pwsh build/publish-to.ps1 -Consumer <этот путь>`.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="keepshell-local" value="packages" />
  </packageSources>
</configuration>
